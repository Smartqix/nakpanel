package web

templ OneTimeSecretFragment(title string, heading string, note string, secret string, continuePath string) {
 <template data-np-shell="meta" data-keep-shell="true" data-title={ title }></template>
 <div data-np-fragment="main">
  <section class="np-panel np-nav-secret" data-np-secret-panel>
   <div class="np-panel-title"><h1>{ heading }</h1></div>
   <p>{ note }</p>
   <pre>{ secret }</pre>
   <div class="np-button-row"><button type="button" class="np-secondary-button" data-np-copy-secret>Copy</button><a class="np-primary-link" href={ templ.SafeURL(continuePath) }>Continue</a></div>
  </section>
 </div>
}
