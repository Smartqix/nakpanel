package web

import (
	"github.com/nakroteck/nakpanel/internal/control/auth"
	"github.com/nakroteck/nakpanel/internal/control/dashboard"
	controlphpapp "github.com/nakroteck/nakpanel/internal/control/phpapp"
	controlquota "github.com/nakroteck/nakpanel/internal/control/quota"
	"github.com/nakroteck/nakpanel/internal/types"
)

templ RoutedDashboardPage(title string, user auth.SessionUser, data dashboard.Data, actions DashboardActions, view WorkspaceView) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="nakpanel-csrf" content={ view.CSRFToken }/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body class="np-app np-routed" data-np-role={ string(user.Role) }>
			<div class="np-routed-layout">
				@routedSidebar(user, data, view)
				<div class="np-routed-main">
					@routedTopbar(user, data, view)
					if view.SupportCustomerID > 0 {
						@supportBanner(view)
					}
					<main class="np-routed-content" id="main-content">
						if data.Notice != "" {
							<p class="np-notice" role="status">{ data.Notice }</p>
						}
						@routedContent(user, data, actions, view)
					</main>
				</div>
			</div>
			<div class="np-mobile-scrim" data-np-menu-close hidden></div>
			if actions.CanCreateSite {
				@routedSiteDialog(subscriptionsForCustomer(data.Subscriptions, view.SupportCustomerID), data.Capabilities, view)
			}
			if (user.Role == auth.RoleAdmin || user.Role == auth.RoleReseller) && actions.CanManageQuotas {
				@customerDialog(view)
			}
			if view.FileEditor != nil {
				<script defer src="/assets/ace/ace.js"></script>
			}
			@confirmationDialog()
			<script defer src="/assets/app.js"></script>
		</body>
	</html>
}

templ routedSidebar(user auth.SessionUser, data dashboard.Data, view WorkspaceView) {
	<aside class="np-routed-side" data-np-sidebar>
		<div class="np-side-brand">
			<span class="np-brand-mark" aria-hidden="true">n</span>
			<span class="np-side-brand-text"><strong>nakpanel</strong><small>ns1.nakroteck.com</small></span>
		</div>
		<nav class="np-routed-nav" aria-label="Primary navigation">
			@navRoute(workspacePath(view, "/dashboard"), "Home", "home", routeActive(view.Route, "dashboard"), "")
			if user.Role == auth.RoleAdmin && view.SupportCustomerID == 0 {
				<span class="np-nav-label">Hosting services</span>
				@navRoute("/customers", "Customers", "users", routeActive(view.Route, "customers", "customer-detail"), formatBadgeCount(len(data.Customers)))
				@navRoute("/resellers", "Resellers", "users", routeActive(view.Route, "resellers", "reseller-detail"), formatBadgeCount(len(data.Resellers)))
				@navRoute("/sites", "Domains", "globe", routeActive(view.Route, "sites", "site-detail", "site-files", "site-file-edit"), formatBadgeCount(len(data.Sites)))
				@navRoute("/subscriptions", "Subscriptions", "card", routeActive(view.Route, "subscriptions", "subscription-detail", "subscription-new"), formatBadgeCount(len(data.Subscriptions)))
		@navRoute("/service-plans", "Service Plans", "layers", routeActive(view.Route, "service-plans", "plan-detail", "plan-new", "addon-detail", "addon-new", "reseller-plan-new"), "")
				<span class="np-nav-label">Server management</span>
				@navRoute("/activity", "Activity", "activity", routeActive(view.Route, "activity"), formatBadgeCount(len(data.Jobs)))
				@navRoute("/tools-settings", "Tools & Settings", "settings", routeActive(view.Route, "tools-settings"), "")
			} else if user.Role == auth.RoleReseller && view.SupportCustomerID == 0 {
				<span class="np-nav-label">Hosting services</span>
				@navRoute("/customers", "Customers", "users", routeActive(view.Route, "customers", "customer-detail"), formatBadgeCount(len(data.Customers)))
				@navRoute("/sites", "Domains", "globe", routeActive(view.Route, "sites", "site-detail", "site-files", "site-file-edit"), formatBadgeCount(len(data.Sites)))
				@navRoute("/subscriptions", "Subscriptions", "card", routeActive(view.Route, "subscriptions", "subscription-detail", "subscription-new"), formatBadgeCount(len(data.Subscriptions)))
		@navRoute("/service-plans", "Service Plans", "layers", routeActive(view.Route, "service-plans", "plan-detail", "plan-new", "addon-detail", "addon-new"), "")
				<span class="np-nav-label">Account</span>
				@navRoute("/activity", "Activity", "activity", routeActive(view.Route, "activity"), "")
				@navRoute("/tools-utilities", "Tools & Utilities", "settings", routeActive(view.Route, "tools-utilities"), "")
				@navRoute("/my-resources", "My Resources", "activity", routeActive(view.Route, "my-resources"), "")
			} else {
				<span class="np-nav-label">Hosting services</span>
				@navRoute(workspacePath(view, "/sites"), "Websites & Domains", "globe", routeActive(view.Route, "sites", "site-detail", "site-files", "site-file-edit"), formatBadgeCount(len(sitesForCustomer(data.Sites, view.SupportCustomerID))))
				@navRoute(workspacePath(view, "/mail"), "Mail", "mail", routeActive(view.Route, "mail"), formatBadgeCount(len(data.SubscriptionServices.Mailboxes)))
				@navRoute(workspacePath(view, "/subscriptions"), "Subscriptions", "card", routeActive(view.Route, "subscriptions", "subscription-detail"), formatBadgeCount(len(data.Subscriptions)))
				@navRoute(workspacePath(view, "/databases"), "Databases", "database", routeActive(view.Route, "databases"), formatBadgeCount(len(databasesForCustomer(data.Databases, view.SupportCustomerID))))
				@navRoute(workspacePath(view, "/backups"), "Backups", "archive", routeActive(view.Route, "backups"), "")
				@navRoute(workspacePath(view, "/dns"), "DNS", "network", routeActive(view.Route, "dns"), "")
				@navRoute(workspacePath(view, "/certificates"), "SSL/TLS", "shield", routeActive(view.Route, "certificates"), "")
				<span class="np-nav-label">Account</span>
				@navRoute(workspacePath(view, "/activity"), "Activity", "activity", routeActive(view.Route, "activity"), "")
			}
		</nav>
		<div class="np-side-footer"><span class="np-agent-dot"></span><span>Panel session active</span></div>
	</aside>
}

templ navRoute(path string, label string, iconName string, active string, badge string) {
	<a href={ templ.SafeURL(path) } class={ "np-routed-nav-item " + active } aria-current={ ariaCurrent(active) }>
		@icon(iconName)
		<span>{ label }</span>
		if badge != "" {
			<span class="np-nav-badge">{ badge }</span>
		}
	</a>
}

templ icon(name string) {
	<svg class="np-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href={ templ.SafeURL("/assets/icons.svg#" + name) }></use></svg>
}

templ statusPill(state string) { <span class={ "np-status-pill np-status-pill-" + statusPillClass(state) }>{ state }</span> }

templ routedTopbar(user auth.SessionUser, data dashboard.Data, view WorkspaceView) {
	<header class="np-routed-top">
		<div class="np-top-primary">
			<button class="np-menu-icon" type="button" data-np-menu aria-label="Open navigation" aria-expanded="false">@icon("menu")</button>
			<div><span class="np-breadcrumb">{ routeTitle(view.Route) }</span></div>
			<div class="np-global-search" data-np-global-search>
				@icon("search")
				<input type="search" placeholder="Search sites, customers, subscriptions..." aria-label="Search Nakpanel" autocomplete="off" data-np-search-input/>
				<div class="np-search-results" data-np-search-results hidden></div>
			</div>
		</div>
		<div class="np-top-secondary">
			if user.Role == auth.RoleClient || view.SupportCustomerID > 0 {
				<label class="np-context-select"><span class="np-sr-only">Subscription</span><select data-np-subscription-nav>
					<option value={ templ.SafeURL(workspacePath(view, "/dashboard")) }>All subscriptions</option>
					for _, subscription := range subscriptionsForCustomer(data.Subscriptions, view.SupportCustomerID) {
						<option value={ templ.SafeURL(withSubscription(workspacePath(view, "/dashboard"), subscription.ID)) } selected?={ subscription.ID == view.SelectedSubscription }>{ subscription.SubscriptionName }</option>
					}
				</select></label>
			}
			if user.Role == auth.RoleAdmin {
				<span class="np-health"><span></span>Panel session active</span>
			}
			<form method="post" action="/logout">@csrfInput(view)<button class="np-avatar" type="submit" title={ "Sign out " + user.Email }>{ userInitials(user) }</button></form>
		</div>
	</header>
}

templ supportBanner(view WorkspaceView) {
	<div class="np-support-banner" role="status">
		<div><strong>Support view</strong><span>Managing { view.SupportCustomerName } as administrator. Your identity is preserved.</span></div>
		<form method="post" action={ templ.SafeURL("/support/customers/" + formatJobID(view.SupportCustomerID) + "/exit") }>
			@csrfInput(view)
			<button type="submit" class="np-secondary-button">Exit support view</button>
		</form>
	</div>
}

templ csrfInput(view WorkspaceView) {
	@csrfTokenInput(view.CSRFToken)
	if view.SupportCustomerID > 0 {
		<input type="hidden" name="support_customer_id" value={ formatJobID(view.SupportCustomerID) }/>
	}
}

templ routedContent(user auth.SessionUser, data dashboard.Data, actions DashboardActions, view WorkspaceView) {
	switch view.Route {
		case "dashboard":
			@routedDashboard(user, data, view)
		case "sites":
			@routedSites(user, sitesForSubscription(sitesForCustomer(data.Sites, view.SupportCustomerID), view.SelectedSubscription), selectedSubscription(subscriptionsForCustomer(data.Subscriptions, view.SupportCustomerID), view.SelectedSubscription), actions, view)
		case "site-detail":
			@routedSiteDetail(user, data, actions, view)
		case "site-files":
			@routedFileManager(view)
		case "site-file-edit":
			@routedFileEditor(view)
		case "databases":
			@routedDatabases(databasesForSubscription(databasesForCustomer(data.Databases, view.SupportCustomerID), view.SelectedSubscription), selectedSubscription(subscriptionsForCustomer(data.Subscriptions, view.SupportCustomerID), view.SelectedSubscription), actions, view)
		case "backups":
			@routedBackups(data.Phase6, subscriptionsForCustomer(data.Subscriptions, view.SupportCustomerID), actions, view)
		case "dns":
			@routedDNS(data.Phase6, sitesForCustomer(data.Sites, view.SupportCustomerID), actions, view)
		case "certificates":
			@routedCertificates(sitesForCustomer(data.Sites, view.SupportCustomerID), actions, view)
		case "mail":
			@routedMail(user, data, view)
		case "activity":
			@routedActivity(data, user, view)
		case "customers":
			@routedCustomers(data, view)
		case "customer-detail":
			@routedCustomerDetail(data, user, view)
		case "subscriptions":
			@routedSubscriptions(user, data, view)
		case "subscription-detail":
			@routedSubscriptionDetail(user, data, actions, view)
		case "subscription-new":
			@routedSubscriptionOnboarding(data, view)
		case "service-plans":
			@routedPlans(data, user, view)
		case "plan-detail":
			@routedPlanDetail(data, view)
		case "plan-new":
			@routedPlanEditor(planForCreate(data.Plans, view, data.Capabilities), data, view, false)
		case "addon-detail":
			@routedAddonDetail(data, view)
		case "addon-new":
			@routedPlanEditor(addonEditorDefault(), data, view, true)
		case "reseller-plan-new":
			@routedResellerPlanEditor(resellerPlanDefault(), data.Capabilities, view)
		case "reseller-plan-detail":
			if plan, ok := resellerPlanByID(data.ResellerPlans, view.DetailID); ok {
				@routedResellerPlanEditor(plan, data.Capabilities, view)
			} else {
				<p class="np-empty">Reseller plan not found.</p>
			}
		case "tools-settings":
			@settingsSection(data, actions, view)
		case "tools-utilities":
			@routedToolsUtilities(data)
		case "resellers":
			@routedResellers(data, view)
		case "reseller-detail":
			@routedResellerDetail(data, view)
		case "reseller-plans":
			@routedResellerPlans(data, view)
		case "my-resources":
			@routedMyResources(data, view)
		default:
			<p class="np-empty">This workspace is unavailable.</p>
	}
}

templ routedToolsUtilities(data dashboard.Data) {
	<section class="np-settings-page" aria-labelledby="tools-utilities-title">
		@pageHead("Provider workspace", "Tools & Utilities", "Manage provider-scoped capacity, defaults, delegated services, and owned resources.")
		<div class="np-settings-categories">
			<section class="np-settings-category">
				<header><span class="np-settings-category-icon">@icon("activity")</span><div><h3 id="tools-utilities-title">Capacity &amp; Plans</h3><p>Allocation and defaults within your provider boundary.</p></div></header>
				<div class="np-settings-tool-list">
					<a class="np-settings-tool is-actionable" href="/my-resources"><span class="np-settings-tool-icon">@icon("activity")</span><span class="np-settings-tool-copy"><strong>Provider Capacity</strong><span>Review assigned resources and current consumption.</span></span><span class="np-settings-tool-meta">@icon("chevron-right")</span></a>
					<a class="np-settings-tool is-actionable" href="/service-plans"><span class="np-settings-tool-icon">@icon("layers")</span><span class="np-settings-tool-copy"><strong>Plan Defaults</strong><span>{ formatPlanLimit(len(data.Plans)) } provider-scoped plans are available.</span></span><span class="np-settings-tool-meta">@icon("chevron-right")</span></a>
				</div>
			</section>
			<section class="np-settings-category">
				<header><span class="np-settings-category-icon">@icon("settings")</span><div><h3>Delegated Services</h3><p>Policies and resources delegated through your plans.</p></div></header>
				<div class="np-settings-tool-list">
					<a class="np-settings-tool is-actionable" href="/mail"><span class="np-settings-tool-icon">@icon("mail")</span><span class="np-settings-tool-copy"><strong>Mail Policy</strong><span>{ formatPlanLimit(len(data.SubscriptionServices.Mailboxes)) } owned mailboxes.</span></span><span class="np-settings-tool-meta">@icon("chevron-right")</span></a>
					<a class="np-settings-tool is-actionable" href="/backups"><span class="np-settings-tool-icon">@icon("archive")</span><span class="np-settings-tool-copy"><strong>Backup Policy</strong><span>{ formatPlanLimit(len(data.Phase6.Backups)) } tracked backups.</span></span><span class="np-settings-tool-meta">@icon("chevron-right")</span></a>
					<a class="np-settings-tool is-actionable" href="/subscriptions"><span class="np-settings-tool-icon">@icon("package-open")</span><span class="np-settings-tool-copy"><strong>Applications &amp; Domains</strong><span>{ formatPlanLimit(len(data.SubscriptionServices.Applications)) } applications across { formatPlanLimit(len(data.Sites)) } domains.</span></span><span class="np-settings-tool-meta">@icon("chevron-right")</span></a>
				</div>
			</section>
			<section class="np-settings-category">
				<header><span class="np-settings-category-icon">@icon("users")</span><div><h3>Owned Resources</h3><p>Provider customers, subscriptions, and operational history.</p></div></header>
				<div class="np-settings-tool-list">
					<a class="np-settings-tool is-actionable" href="/customers"><span class="np-settings-tool-icon">@icon("users")</span><span class="np-settings-tool-copy"><strong>Customers</strong><span>{ formatPlanLimit(len(data.Customers)) } customers in this provider.</span></span><span class="np-settings-tool-meta">@icon("chevron-right")</span></a>
					<a class="np-settings-tool is-actionable" href="/subscriptions"><span class="np-settings-tool-icon">@icon("card")</span><span class="np-settings-tool-copy"><strong>Subscriptions</strong><span>{ formatPlanLimit(len(data.Subscriptions)) } provider-owned subscriptions.</span></span><span class="np-settings-tool-meta">@icon("chevron-right")</span></a>
					<a class="np-settings-tool is-actionable" href="/activity"><span class="np-settings-tool-icon">@icon("shield-check")</span><span class="np-settings-tool-copy"><strong>Activity</strong><span>Review provider-scoped jobs and audit events.</span></span><span class="np-settings-tool-meta">@icon("chevron-right")</span></a>
				</div>
			</section>
		</div>
	</section>
}

templ pageHead(kicker string, title string, description string) {
	<div class="np-routed-page-head"><div><span class="np-kicker">{ kicker }</span><h1>{ title }</h1><p>{ description }</p></div>{ children... }</div>
}

templ routedDashboard(user auth.SessionUser, data dashboard.Data, view WorkspaceView) {
	@pageHead("Control panel", routeTitle(view.Route), "A focused view of hosting health, capacity and work that needs attention.") {
		<a class="np-primary-link" href={ templ.SafeURL(workspacePath(view, "/sites")) }>View websites</a>
	}
	<div class="np-stat-grid np-routed-stats">
		@statCard("Websites", len(sitesForCustomer(data.Sites, view.SupportCustomerID)), "Active domains and hosting accounts")
		@statCard("Databases", len(databasesForCustomer(data.Databases, view.SupportCustomerID)), "Provisioned MariaDB resources")
		@statCard("Backups", len(data.Phase6.Backups), "Recent protected snapshots")
		@statCard("Subscriptions", len(subscriptionsForCustomer(data.Subscriptions, view.SupportCustomerID)), "Plans currently assigned")
	</div>
	<div class="np-routed-grid">
		<section class="np-panel"><div class="np-panel-title"><h2>Recent websites</h2><a href={ templ.SafeURL(workspacePath(view, "/sites")) }>View all</a></div>@siteRows(sitesForCustomer(data.Sites, view.SupportCustomerID), view)</section>
		<section class="np-panel"><div class="np-panel-title"><h2>Subscription usage</h2><span class="np-muted">plan limits</span></div>@subscriptionUsageRows(subscriptionsForCustomer(data.Subscriptions, view.SupportCustomerID), canOpenSubscriptionDetails(view), view)</section>
	</div>
}

templ siteRows(sites []dashboard.Site, view WorkspaceView) {
	if len(sites) == 0 {
		<p class="np-empty">No websites yet.</p>
	} else {
		<div class="np-object-list">
			for _, item := range sites {
				<a class="np-object-row" href={ templ.SafeURL(workspacePath(view, "/sites/" + formatJobID(item.ID))) }>
					<span class="np-object-icon">@icon("globe")</span>
					<span><strong>{ item.Domain }</strong><small>{ item.Username } · PHP { item.PHPVersion }</small></span>
					<span class={ "np-status-pill " + customerStatusClass(item.Status) }>{ item.Status }</span>
				</a>
			}
		</div>
	}
}

templ subscriptionUsageRows(items []types.SubscriptionSummary, details bool, view WorkspaceView) {
	if len(items) == 0 {
		<p class="np-empty">No active subscriptions.</p>
	} else {
		<div class="np-usage-list">
			for _, item := range items {
				<a href={ templ.SafeURL(subscriptionUsagePath(item.ID, details, view)) }>
					<span><strong>{ item.SubscriptionName }</strong><small>{ item.PlanName }</small></span>
					<span>{ formatQuotaCompactCount(item.SitesUsed, item.MaxSites, true) } sites</span>
					@tableMeter(item.SitesUsed, item.MaxSites, true)
				</a>
			}
		</div>
	}
}

templ routedSites(user auth.SessionUser, sites []dashboard.Site, subscriptions []types.SubscriptionSummary, actions DashboardActions, view WorkspaceView) {
	@pageHead("Hosting services", "Websites & Domains", "Manage hosting, PHP, certificates, DNS and backups from each website.") {
		if actions.CanCreateSite {
			<button type="button" data-np-dialog-open="site-dialog">Add website</button>
		}
	}
	<section class="np-panel">@siteRows(sites, view)</section>
}

templ routedSiteDetail(user auth.SessionUser, data dashboard.Data, actions DashboardActions, view WorkspaceView) {
	if item, ok := siteByID(data.Sites, view.DetailID); ok {
		if subscription, hasSubscription := subscriptionForSite(data.Subscriptions, item); hasSubscription {
			@pageHead("Website", item.Domain, subscription.SubscriptionName + " · " + subscription.PlanName) {
				<a class="np-secondary-link" href={ templ.SafeURL(workspacePath(view,"/subscriptions/" + formatJobID(item.SubscriptionID))) }>Back to subscription</a>
			}
			<div class="np-domain-commandbar">
				<div><span class={ "np-status-pill " + customerStatusClass(item.Status) }>{ item.Status }</span><span>PHP { item.PHPVersion }</span><span>{ formatTLSStatus(item) }</span></div>
				<a href={ templ.SafeURL("http://" + item.Domain) } target="_blank" rel="noreferrer">@icon("globe")<span>Open website</span></a>
			</div>
			@domainNavigation(item.ID,view.Tab,view,actions.CanUseFileManager)
			if data.ServiceLoadError != "" && siteServiceTab(view.Tab) {
				<p class="np-gate is-blocked">Hosting service policy could not be loaded. Mutating tools are unavailable until the panel can verify this subscription.</p>
			} else if view.Tab == "overview" {
				@domainOverview(item,subscription,data,actions,view)
			} else if view.Tab == "hosting" {
				<section class="np-panel np-domain-settings"><div class="np-panel-title"><h2>Hosting settings</h2>@statusPill(item.SettingsStatus)</div>
					if item.SettingsError != "" {
						<p class="np-error">{ item.SettingsError }</p>
					}
					<form class="np-form np-domain-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/hosting") }>@csrfInput(view)<input type="hidden" name="desired_php_version" value={ item.DesiredPHPVersion }/>
						<label>Website status<select name="desired_status"><option value="active" selected?={ item.DesiredStatus=="active" }>Active</option><option value="suspended" selected?={ item.DesiredStatus=="suspended" }>Suspended</option></select></label>
						<label class="np-check"><input type="checkbox" name="desired_https_redirect" value="true" checked?={ item.DesiredHTTPSRedirect } disabled?={ item.TLSStatus!="active" || (user.Role!=auth.RoleAdmin && !subscription.AllowTLS) }/>Redirect HTTP to HTTPS</label>
						<div class="np-readonly-field"><span>Document root</span><code>{ item.DocumentRoot }</code></div><button type="submit">Apply hosting settings</button>
					</form>
				</section>
				<p class="np-callout">Advanced nginx and PHP values now live in their dedicated workspaces. <a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/web-server")) }>Open Hosting &amp; nginx</a>.</p>
			} else if view.Tab == "php" {
				@domainPHPSettings(user,item,subscription,data,view)
			} else if view.Tab == "access" {
				@domainAccess(item,subscription,data,view)
			} else if view.Tab == "web-server" {
				@domainWebServer(item,data,view)
			} else if view.Tab == "logs" {
				@domainLogs(item,data,view)
			} else if view.Tab == "scheduled-tasks" {
				@domainScheduledTasks(item,subscription,data,view)
			} else if view.Tab == "statistics" {
				@domainStatistics(item,subscription,data,view)
			} else if view.Tab == "git" {
				@domainGit(item,subscription,data,view)
			} else if view.Tab == "applications" {
				@domainPHPApplication(item,subscription,data,view)
			} else if view.Tab == "containers" {
				@domainContainers(user,item,subscription,data,view)
			} else if view.Tab == "staging" {
				@domainStaging(item,subscription,data,view)
			} else if view.Tab == "redis" {
				@domainValkey(item,subscription,data,view)
			} else if view.Tab == "mail" {
				@domainMail(user, item, subscription, data, view)
			} else if view.Tab == "dns" {
				@domainDNS(user, item, data.Phase6, subscription, actions, view)
			} else if view.Tab == "ssl" {
				@domainSSL(user, item, subscription, actions, view)
			} else if view.Tab == "databases" {
				@domainDatabases(item, subscription, databasesForSite(data.Databases,item.ID), actions, view)
			} else if view.Tab == "backups" {
				@domainBackups(user, item, subscription, backupsForSite(data.Phase6.Backups,item.ID), actions, view)
			}
			} else {
				<p class="np-empty">Subscription not found.</p>
			}
	} else {
		<p class="np-empty">Website not found.</p>
	}
}

templ domainOverview(item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, actions DashboardActions, view WorkspaceView) {
	<section class="np-panel np-domain-summary"><div class="np-panel-title"><div><h2>Hosting overview</h2><span class="np-muted">Desired and applied service state for this domain</span></div>@statusPill(item.SettingsStatus)</div>
		<dl class="np-domain-overview-band"><div><dt>PHP</dt><dd>{ item.PHPVersion }</dd><small>dedicated FPM service</small></div><div><dt>TLS</dt><dd>{ formatTLSStatus(item) }</dd><small>HTTPS redirect { yesNo(item.HTTPSRedirect) }</small></div><div><dt>DNS</dt><dd>{ domainDNSState(data.Phase6,item.ID) }</dd><small>authoritative zone</small></div><div><dt>Databases</dt><dd>{ formatPlanLimit(len(databasesForSite(data.Databases,item.ID))) }</dd><small>{ formatQuotaCompactCount(subscription.DatabasesUsed,subscription.MaxDatabases,true) } subscription use</small></div><div><dt>Backups</dt><dd>{ formatPlanLimit(len(backupsForSite(data.Phase6.Backups,item.ID))) }</dd><small>{ formatQuotaCompactCount(subscription.BackupsUsed,subscription.MaxBackups,true) } subscription use</small></div></dl>
		if usage, ok := usageForSite(data.SubscriptionServices.SiteUsage,item.ID); ok {
			<div class="np-domain-usage-row"><div><span>Site files</span><strong>{ formatBytes(usage.DocumentRootBytes) }</strong></div><div><span>Monthly traffic</span><strong>{ formatBytes(usage.TrafficBytes) }</strong></div><div><span>Subscription disk quota</span><strong>{ formatPlanLimitMB(subscription.DiskMB) }</strong></div></div>
		}
		<dl class="np-facts"><div><dt>System user</dt><dd>{ item.Username }</dd></div><div><dt>Document root</dt><dd><code>{ item.DocumentRoot }</code></dd></div></dl>
	</section>
	<div class="np-domain-tool-groups">
		@domainToolGroup("Hosting & DNS") {
			@domainDeepTool(item.ID,"web-server","settings","Hosting & nginx","Typed web-server controls",view)
			@domainTool(item.ID,"php","activity","PHP settings","Version and dedicated FPM",view)
			@domainTool(item.ID,"dns","network","DNS","Zone and records",view)
		}
		@domainToolGroup("Files & Access") {
			if actions.CanUseFileManager {
				<a href={ templ.SafeURL(fileBasePath(view,item.ID)) }>@icon("folder")<strong>File Manager</strong><span>Manage public_html</span></a>
			}
			@domainDeepTool(item.ID,"access","users","FTP & SFTP","Encrypted hosting access",view)
		}
		@domainToolGroup("Developer Tools") {
			@domainDeepTool(item.ID,"logs","file-code","Logs","Bounded live log browser",view)
			@domainDeepTool(item.ID,"scheduled-tasks","activity","Scheduled Tasks","Commands, URLs and PHP scripts",view)
			@domainDeepTool(item.ID,"statistics","activity","Statistics","Traffic and disk use",view)
			@domainDeepTool(item.ID,"git","copy","Git","Repository deployment",view)
		}
		@domainToolGroup("Security") {
			@domainTool(item.ID,"ssl","shield","SSL/TLS","Certificates and HTTPS",view)
			@domainDeepTool(item.ID,"web-server","shield-check","Access rules","CIDR and security headers",view)
			@domainDeepTool(item.ID,"access","lock","Protected directories","Password-gated paths",view)
		}
		@domainToolGroup("Data & Recovery") {
			@domainTool(item.ID,"databases","database","Databases","Site data",view)
			@domainTool(item.ID,"backups","archive","Backups","Recovery points",view)
		}
		@domainToolGroup("Applications") {
			@domainDeepTool(item.ID,"applications","package-open","PHP Application","Classic hosting and managed PHP releases",view)
			@domainDeepTool(item.ID,"containers","server","Containers","Health-gated OCI workloads",view)
			@domainDeepTool(item.ID,"staging","copy","Staging","Copy or promote with rollback",view)
			@domainDeepTool(item.ID,"redis","database","Valkey cache","Shared subscription cache",view)
		}
		@domainToolGroup("Mail") {
			@domainTool(item.ID,"mail","mail","Mail settings","Mailboxes, aliases and webmail",view)
		}
	</div>
}

templ domainToolGroup(title string) {
	<section class="np-panel np-domain-tool-group"><div class="np-panel-title"><h2>{ title }</h2></div><div class="np-tool-grid">{ children... }</div></section>
}

templ domainAccess(item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	@pageSectionHead("FTP & SFTP access", "Encrypted access to this domain document root.")
	if policy, found := policyForSite(data.SubscriptionServices.SitePolicies,item.ID); !found {
		<p class="np-gate is-blocked">Access policy is unavailable. No hosting-access changes can be made.</p>
	} else if !policy.Permissions.FTPS || !policy.Access.FTPSEnabled {
		<p class="np-gate">FTPS is disabled by the subscription hosting policy. A provider must enable and synchronize FTPS before accounts can be created.</p>
	} else {
		<section class="np-panel"><div class="np-panel-title"><div><h2>Domain FTPS accounts</h2><span class="np-muted">Explicit TLS only · passive ports 49152–49252</span></div><button type="button" data-np-dialog-open={ "ftp-account-dialog-"+formatJobID(item.ID) }>@icon("plus")<span>Add account</span></button></div>
			if len(ftpForSite(data.SubscriptionServices.FTP,item.ID)) == 0 {
				<p class="np-empty">No FTPS account is scoped to this domain.</p>
			} else {
				<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Login</th><th>Root</th><th>Status</th><th></th></tr></thead><tbody>
					for _, account := range ftpForSite(data.SubscriptionServices.FTP,item.ID) {
						<tr><td data-label="Login"><strong>{ account.Name }</strong></td><td data-label="Root"><code>public_html</code></td><td data-label="Status">@statusPill(account.ConvergenceStatus)</td><td data-label="Action">@siteSubscriptionServiceDelete(subscription.ID,"ftp",account.ID,item.ID,"site-access",view)</td></tr>
					}
				</tbody></table></div>
			}
			<dialog class="np-dialog" id={ "ftp-account-dialog-"+formatJobID(item.ID) } data-np-dialog><div class="np-dialog-head"><div><h2>Add FTPS account</h2><p>The account is confined to { item.Domain } public_html and accepts explicit TLS only.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/ftp") }>@csrfInput(view)<input type="hidden" name="site_id" value={ formatJobID(item.ID) }/><input type="hidden" name="return_to" value="site-access"/><label>Login name<input name="name" pattern="[a-z][a-z0-9._-]{2,31}" autocomplete="off" required/></label><label>Password<input type="password" name="password" autocomplete="new-password" placeholder="Generate when blank"/></label><label class="np-check"><input type="checkbox" name="enabled" value="true" checked/>Enabled</label><p class="np-form-help">The password is write-only and shown once after creation or reset. Plain FTP and anonymous login are unavailable.</p><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Create account</button></div></form></dialog>
		</section>
	}
	<section class="np-panel"><div class="np-panel-title"><div><h2>SFTP identities</h2><span class="np-muted">Subscription chroot with a domain start directory</span></div><a class="np-secondary-link" href={ templ.SafeURL(workspacePath(view,"/subscriptions/"+formatJobID(subscription.ID)+"/access")) }>Manage SFTP keys</a></div><p>SFTP keys are stored outside the subscription home in a root-owned OpenSSH configuration. Shell, TTY and forwarding are disabled.</p></section>
	<section class="np-panel"><div class="np-panel-title"><div><h2>Password-protected directories</h2><span class="np-muted">nginx Basic Authentication below this domain only</span></div><button type="button" data-np-dialog-open={ "protected-directory-dialog-"+formatJobID(item.ID) }>@icon("plus")<span>Protect directory</span></button></div>
		if len(protectedDirectoriesForSite(data.SubscriptionServices.ProtectedDirectories,item.ID)) == 0 {
			<p class="np-empty">No directories are password protected.</p>
		} else {
			<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Path</th><th>Realm</th><th>User</th><th>Status</th><th></th></tr></thead><tbody>
				for _, directory := range protectedDirectoriesForSite(data.SubscriptionServices.ProtectedDirectories,item.ID) {
					<tr><td data-label="Path"><code>/{ directory.Path }</code></td><td data-label="Realm">{ directory.Realm }</td><td data-label="User">{ directory.Username }</td><td data-label="Status">
						if directory.Enabled {
							@statusPill("active")
						} else {
							@statusPill("disabled")
						}
					</td><td data-label="Action"><form method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/services/protected/"+formatJobID(directory.ID)+"/delete") }>@csrfInput(view)<input type="hidden" name="return_to" value="site-access"/><input type="hidden" name="site_id" value={ formatJobID(item.ID) }/><button class="np-icon-button" type="submit" title="Remove protected directory">@icon("trash")</button></form></td></tr>
				}
			</tbody></table></div>
		}
		<dialog class="np-dialog" id={ "protected-directory-dialog-"+formatJobID(item.ID) } data-np-dialog><div class="np-dialog-head"><div><h2>Protect directory</h2><p>Add HTTP authentication below this domain’s public_html.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/protected-directories") }>@csrfInput(view)<input type="hidden" name="site_id" value={ formatJobID(item.ID) }/><input type="hidden" name="return_to" value="site-access"/><label>Directory below public_html<input name="path" placeholder="private" required/></label><label>Authentication realm<input name="realm" value="Restricted area" required/></label><label>Username<input name="username" autocomplete="off" required/></label><label>Password<span class="np-password-field"><input type="password" name="password" autocomplete="new-password" data-np-generated-password placeholder="Generate when blank"/><button type="button" class="np-icon-button" title="Generate secure password" data-np-generate-password>@icon("activity")</button><button type="button" class="np-icon-button" title="Copy password" data-np-copy-password>@icon("copy")</button></span></label><label class="np-check"><input type="checkbox" name="enabled" value="true" checked/>Enabled</label><p class="np-form-help">The path is site-relative. Passwords are bcrypt-hashed and write-only.</p><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Protect directory</button></div></form></dialog>
	</section>
}

templ domainWebServer(item dashboard.Site, data dashboard.Data, view WorkspaceView) {
	@pageSectionHead("Hosting", "Structured nginx controls with subscription inheritance and safe validation.")
	if policyView, found := sitePolicyView(data.SubscriptionServices.SitePolicies,item.ID); found {
		<section class="np-settings-summary">
			<div><span>Configuration</span><strong>{ policyInheritanceLabel(sitePolicyScopeCustomized(policyView,"web")) }</strong></div>
			<div><span>Convergence</span>@statusPill(item.SettingsStatus)</div>
			<div><span>Document root</span><code>{ item.DocumentRoot }</code></div>
		</section>
		<form class="np-settings-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/policy") } data-np-site-policy-builder data-np-dirty-guard data-np-dirty="false">
			@csrfInput(view)<input type="hidden" name="policy_patch" value="{}" data-np-policy-patch/><input type="hidden" name="policy_return_tab" value="web-server"/>
			@domainSettingsSection("General","Canonical host, index resolution, and request body handling",sitePolicyScopeCustomized(policyView,"web")) {
				<div class="np-settings-fields">
					<label>Preferred domain<select name="site_preferred_domain"><option value="none" selected?={ policyView.EffectivePolicy.Web.PreferredDomain=="none" }>None</option><option value="www" selected?={ policyView.EffectivePolicy.Web.PreferredDomain=="www" }>www</option><option value="root" selected?={ policyView.EffectivePolicy.Web.PreferredDomain=="root" }>Root domain</option></select></label>
					<label>Index files<input name="site_index_files" value={ policyView.EffectivePolicy.Web.IndexFiles } placeholder="index.php index.html"/></label>
					<label>Request body limit, MB<input type="number" min="-1" name="site_body_limit" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.Web.RequestBodyLimitMB) }/></label>
				</div>
			}
			@domainSettingsSection("Performance & cache","Compression, static assets, and FastCGI response caching",sitePolicyScopeCustomized(policyView,"web")) {
				<div class="np-settings-toggles">@planToggle("site_compression","Compression",policyView.EffectivePolicy.Web.Compression) @planToggle("site_static_cache","Static cache",policyView.EffectivePolicy.Web.StaticCache) @planToggle("site_fastcgi_microcache","FastCGI microcache",policyView.EffectivePolicy.Web.FastCGIMicrocache)</div>
				<div class="np-settings-fields"><label>Static cache TTL, seconds<input type="number" min="-1" name="site_cache_ttl" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.Web.CacheTTLSeconds) }/></label></div>
			}
			@domainSettingsSection("Traffic controls","Bound request rates, bursts, connections, and upstream timeouts",sitePolicyScopeCustomized(policyView,"web")) {
				<div class="np-settings-fields">
					<label>Requests / second<input type="number" min="-1" name="site_request_rate" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.Web.RequestRatePerSecond) }/></label>
					<label>Request burst<input type="number" min="-1" name="site_request_burst" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.Web.RequestBurst) }/></label>
					<label>Maximum connections<input type="number" min="-1" name="site_max_connections" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.Web.MaxConnections) }/></label>
					<label>Connect timeout, seconds<input type="number" min="-1" name="site_connect_timeout" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.Web.ConnectTimeoutSecs) }/></label>
					<label>Read timeout, seconds<input type="number" min="-1" name="site_read_timeout" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.Web.ReadTimeoutSecs) }/></label>
				</div>
			}
			@domainSettingsSection("Security & access","Provider-controlled header presets and allowlisted client networks",sitePolicyScopeCustomized(policyView,"web")) {
				<div class="np-settings-fields">
					<label>Security headers<select name="site_security_headers"><option value="off" selected?={ policyView.EffectivePolicy.Web.SecurityHeaderPreset=="off" }>Off</option><option value="balanced" selected?={ policyView.EffectivePolicy.Web.SecurityHeaderPreset=="balanced" }>Balanced</option><option value="strict" selected?={ policyView.EffectivePolicy.Web.SecurityHeaderPreset=="strict" }>Strict</option></select></label>
					<label class="np-wide-field">Allowed CIDRs<input name="site_allowed_cidrs" value={ joinStrings(policyView.EffectivePolicy.Web.AllowedCIDRs) } placeholder="203.0.113.0/24, 2001:db8::/32"/></label>
				</div>
			}
			@domainSettingsSection("Error documents","Site-relative pages served for common failures",sitePolicyScopeCustomized(policyView,"web")) {
				<div class="np-settings-fields"><label>404 document<input name="site_error_document_404" value={ policyView.EffectivePolicy.Web.ErrorDocument404 } placeholder="/errors/404.html"/></label><label>50x document<input name="site_error_document_50x" value={ policyView.EffectivePolicy.Web.ErrorDocument50X } placeholder="/errors/50x.html"/></label></div>
			}
			<div class="np-sticky-actions"><button class="np-secondary-button" type="submit" name="reset_scope" value="web" formnovalidate>Reset hosting</button><button class="np-secondary-button" type="submit" name="reset_scope" value="all" formnovalidate>Reset all</button><button type="submit" data-np-dirty-submit disabled>Save &amp; reconcile</button></div>
		</form>
	} else {
		<p class="np-gate is-blocked">Web-server policy is unavailable.</p>
	}
}

templ domainPHPSettings(user auth.SessionUser, item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	@pageSectionHead("PHP settings", "A dedicated PHP-FPM master, socket, OPcache and cgroup for this domain.")
	if user.Role!=auth.RoleAdmin && !subscription.AllowPHPSettings {
		<p class="np-gate">PHP settings are disabled by this subscription.</p>
	} else if policyView, found := sitePolicyView(data.SubscriptionServices.SitePolicies,item.ID); found {
		if len(phpVersionsFromCapabilities(data.Capabilities,subscription.PHPAllowlist)) == 0 {
			<p class="np-gate is-blocked">No installed PHP-FPM version is allowed by this subscription. Runtime changes are unavailable.</p>
		} else {
			<section class="np-settings-summary">
				<div><span>Configuration</span><strong>{ policyInheritanceLabel(sitePolicyScopeCustomized(policyView,"php")) }</strong></div>
				<div><span>PHP service</span><code>nakpanel-php-fpm@{ formatJobID(item.ID) }</code></div>
				<div><span>Provider ceiling</span><strong>{ formatPlanLimitMB(policyView.InheritedPolicy.PHP.MemoryLimitMB) } memory</strong></div>
			</section>
			<form class="np-settings-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-settings") } data-np-site-policy-builder data-np-dirty-guard data-np-dirty="false">
				@csrfInput(view)<input type="hidden" name="desired_status" value={ item.DesiredStatus }/><input type="hidden" name="desired_https_redirect" value={ formatBool(item.DesiredHTTPSRedirect) }/><input type="hidden" name="policy_patch" value="{}" data-np-policy-patch/><input type="hidden" name="policy_return_tab" value="php"/>
				@domainSettingsSection("Runtime","Installed versions allowed by the subscription",sitePolicyScopeCustomized(policyView,"php")) {
					<div class="np-settings-fields"><label>PHP version<select name="desired_php_version">
						for _, version := range phpVersionsFromCapabilities(data.Capabilities,subscription.PHPAllowlist) {
							<option value={ version } selected?={ version==item.DesiredPHPVersion }>{ version }</option>
						}
					</select><small>Changing version restarts only this domain’s PHP service.</small></label></div>
				}
				@domainSettingsSection("Process Manager","Worker behavior for this domain’s dedicated FPM pool",sitePolicyScopeCustomized(policyView,"php")) {
					<div class="np-settings-fields"><label>FPM mode<select name="site_fpm_mode"><option value="ondemand" selected?={ policyView.EffectivePolicy.PHP.FPMMode=="ondemand" }>On demand</option><option value="dynamic" selected?={ policyView.EffectivePolicy.PHP.FPMMode=="dynamic" }>Dynamic</option></select></label><label>FPM children<input type="number" min="-1" name="site_fpm_children" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.PHP.FPMMaxChildren) }/><small>Maximum allowed: { formatPlanLimit(policyView.InheritedPolicy.PHP.FPMMaxChildren) }</small></label><label>Maximum requests<input type="number" min="-1" name="site_fpm_requests" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.PHP.FPMMaxRequests) }/></label><label>Idle timeout, seconds<input type="number" min="-1" name="site_fpm_idle" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.PHP.FPMIdleTimeoutSecs) }/></label><label>Request termination, seconds<input type="number" min="-1" name="site_fpm_terminate" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.PHP.RequestTerminateSecs) }/></label></div>
				}
				@domainSettingsSection("Resource limits","PHP request limits constrained by the subscription",sitePolicyScopeCustomized(policyView,"php")) {
					<div class="np-settings-fields"><label>Memory limit, MB<input type="number" min="-1" name="site_php_memory" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.PHP.MemoryLimitMB) }/><small>Maximum allowed: { formatPlanLimitMB(policyView.InheritedPolicy.PHP.MemoryLimitMB) }</small></label><label>Execution time, seconds<input type="number" min="-1" name="site_php_execution" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.PHP.MaxExecutionSeconds) }/></label><label>Input time, seconds<input type="number" min="-1" name="site_php_input" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.PHP.MaxInputSeconds) }/></label><label>POST size, MB<input type="number" min="-1" name="site_php_post" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.PHP.PostMaxMB) }/></label><label>Upload size, MB<input type="number" min="-1" name="site_php_upload" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.PHP.UploadMaxMB) }/></label></div>
				}
				@domainSettingsSection("Error handling & security","Production-safe logging and high-risk runtime permissions",sitePolicyScopeCustomized(policyView,"php")) {
					<div class="np-settings-toggles">@planToggle("site_php_log_errors","Log errors",policyView.EffectivePolicy.PHP.LogErrors) @planToggle("site_php_display_errors","Display errors",policyView.EffectivePolicy.PHP.DisplayErrors) @planToggle("site_php_url_fopen","URL fopen",policyView.EffectivePolicy.PHP.AllowURLFOpen) @planToggle("site_php_exec","PHP process execution",policyView.EffectivePolicy.PHP.ExecEnabled)</div>
					<p class="np-settings-warning">@icon("triangle-alert") Display errors and process execution can expose sensitive data or expand application access. Keep them disabled unless the application requires them.</p>
				}
				@domainSettingsSection("OPcache","Compiled script caching for lower PHP latency",sitePolicyScopeCustomized(policyView,"php")) {
					<div class="np-settings-toggles">@planToggle("site_php_opcache","OPcache",policyView.EffectivePolicy.PHP.OPcacheEnabled)</div>
					<div class="np-settings-fields"><label>OPcache memory, MB<input type="number" min="-1" name="site_php_opcache_memory" value={ formatPlanLimitFormValue(policyView.EffectivePolicy.PHP.OPcacheMemoryMB) }/></label></div>
				}
				<div class="np-sticky-actions"><button class="np-secondary-button" type="submit" name="reset_scope" value="php" formaction={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/policy") } formnovalidate>Reset PHP</button><button class="np-secondary-button" type="submit" name="reset_scope" value="all" formaction={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/policy") } formnovalidate>Reset all</button><button type="submit" data-np-dirty-submit disabled>Save &amp; restart PHP</button></div>
			</form>
		}
	} else {
		<p class="np-gate is-blocked">PHP policy is unavailable.</p>
	}
}

templ domainSettingsSection(title string, copy string, customized bool) {
	<section class="np-settings-section">
		<header><div><h2>{ title }</h2><p>{ copy }</p></div><span class={ inheritanceBadgeClass(customized) }>{ policyInheritanceLabel(customized) }</span></header>
		<div class="np-settings-section-body">{ children... }</div>
	</section>
}

templ domainLogs(item dashboard.Site, data dashboard.Data, view WorkspaceView) {
	@pageSectionHead("Logs", "Read-only bounded access to Nakpanel-managed log sources.")
	if policy, found := policyForSite(data.SubscriptionServices.SitePolicies,item.ID); !found {
		<p class="np-gate is-blocked">Log access policy is unavailable.</p>
	} else if !policy.Permissions.Logs {
		<p class="np-gate">The subscription does not permit domain log access.</p>
	} else {
	<section class="np-panel" data-np-site-logs data-site-id={ formatJobID(item.ID) }>
		<form class="np-form np-log-filter" data-np-site-log-filter><label>Source<select name="source"><option value="nginx_access" selected?={ siteLogSource(view.LogSource)==types.SiteLogNginxAccess }>nginx access</option><option value="nginx_error" selected?={ siteLogSource(view.LogSource)==types.SiteLogNginxError }>nginx error</option><option value="php_fpm" selected?={ siteLogSource(view.LogSource)==types.SiteLogPHPFPM }>PHP-FPM</option><option value="php_deployment" selected?={ siteLogSource(view.LogSource)==types.SiteLogPHPDeployment }>PHP deployment</option><option value="php_worker" selected?={ siteLogSource(view.LogSource)==types.SiteLogPHPWorker }>PHP worker</option><option value="application" selected?={ siteLogSource(view.LogSource)==types.SiteLogApplication }>Application</option><option value="task" selected?={ siteLogSource(view.LogSource)==types.SiteLogTask }>Scheduled task</option></select></label><label>Search<input name="q" type="search"/></label><label>Severity<select name="severity"><option value="">All</option><option value="error">Error</option><option value="warn">Warning</option></select></label><button type="submit">Refresh</button></form>
		<pre class="np-log-output" data-np-site-log-output aria-live="polite">Select a source and refresh.</pre><div class="np-panel-actions"><button type="button" class="np-secondary-button" data-np-site-log-more hidden>Load newer lines</button><a class="np-secondary-link" data-np-site-log-download href={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/logs/data?source=nginx_access&download=1") }>Download source</a></div>
	</section>
	}
}

templ domainScheduledTasks(item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	@pageSectionHead("Scheduled Tasks", "Run commands, URLs, or PHP scripts as the subscription account.")
	if policy, found := policyForSite(data.SubscriptionServices.SitePolicies,item.ID); !found {
		<p class="np-gate is-blocked">Scheduled-task policy is unavailable.</p>
	} else if !policy.Permissions.ScheduledTasks {
		<p class="np-gate">Scheduled tasks are disabled by this subscription policy.</p>
	} else {
	<section class="np-panel">
		<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Task</th><th>Type</th><th>Schedule</th><th>Last state</th><th></th></tr></thead><tbody>
			for _, task := range tasksForSite(data.SubscriptionServices.Tasks,item.ID) {
				<tr><td data-label="Task"><strong>{ task.Name }</strong><small>{ task.Timezone }</small></td><td data-label="Type">{ task.Kind }</td><td data-label="Schedule"><code>{ task.Schedule }</code></td><td data-label="Last state">@statusPill(task.Status)</td><td data-label="Actions"><div class="np-panel-actions"><form method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/scheduled-tasks/"+formatJobID(task.ID)+"/run") }>@csrfInput(view)<input type="hidden" name="site_id" value={ formatJobID(item.ID) }/><button type="submit" class="np-secondary-button">Run now</button></form>@siteSubscriptionServiceDelete(subscription.ID,"task",task.ID,item.ID,"site-tasks",view)</div></td></tr>
				for _, run := range taskRunsForTask(data.SubscriptionServices.TaskRuns,task.ID) {
					<tr class="np-subrow"><td data-label="Run" colspan="3"><code>{ run.Output }</code></td><td data-label="Status">@statusPill(run.Status)</td><td data-label="Created">{ formatTime(run.CreatedAt) }</td></tr>
				}
			}
		</tbody></table></div>
		<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/scheduled-tasks") }>@csrfInput(view)<input type="hidden" name="site_id" value={ formatJobID(item.ID) }/><input type="hidden" name="return_to" value="site-tasks"/><div class="np-form-grid"><label>Name<input name="name" required/></label><label>Task type<select name="kind"><option value="command">Command</option><option value="url">Fetch URL</option><option value="php">PHP script</option></select></label><label>Schedule<input name="schedule" placeholder="0 2 * * *" required/></label><label>Timezone<input name="timezone" value="UTC" required/></label><label>Working directory<input name="working_directory" value="." required/></label><label>Timeout seconds<input type="number" min="1" max="86400" name="timeout_seconds" value="300" required/></label><label class="np-wide-field">Command<input name="command"/></label><label class="np-wide-field">URL<input type="url" name="url"/></label><label class="np-wide-field">PHP script path<input name="script"/></label><label class="np-check"><input type="checkbox" name="enabled" value="true" checked/>Enabled</label></div><button type="submit">Add task</button></form>
	</section>
	}
}

templ domainStatistics(item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	@pageSectionHead("Statistics", "Domain measurements with subscription-wide quota context.")
	if usage, found := usageForSite(data.SubscriptionServices.SiteUsage,item.ID); found {
		<div class="np-stat-grid np-routed-stats">@statCard("Document root", int(usage.DocumentRootBytes/1024/1024), "MB for this domain")@statCard("Monthly traffic", int(usage.TrafficBytes/1024/1024), "MB since "+usage.PeriodStart.Format("2 Jan"))@statCard("Requests", int(usage.RequestCount), "current month")@statCard("Errors", int(usage.ErrorCount), "HTTP 4xx and 5xx")</div>
		<section class="np-panel"><dl class="np-facts"><div><dt>Subscription disk limit</dt><dd>{ formatPlanLimitMB(subscription.DiskMB) }</dd></div><div><dt>Per-domain usage</dt><dd>{ formatBytes(usage.DocumentRootBytes) }</dd></div><div><dt>Quota scope</dt><dd>Linux quota is enforced on the shared subscription account</dd></div><div><dt>Collected</dt><dd>{ formatNullableTime(usage.CollectedAt) }</dd></div></dl>
			if usage.LastError != "" {
				<p class="np-error">{ usage.LastError }</p>
			}
		</section>
	} else {
		<p class="np-empty">No complete measurement is available yet. Usage collection runs every 15 minutes.</p>
	}
}

templ domainGit(item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	@pageSectionHead("Git", "Deploy a verified branch below this domain document root.")
	if policy, found := policyForSite(data.SubscriptionServices.SitePolicies,item.ID); !found {
		<p class="np-gate is-blocked">Git policy is unavailable.</p>
	} else if !policy.Permissions.Git {
		<p class="np-gate">Git deployment is disabled by this subscription policy.</p>
	} else {
	<section class="np-panel">
		if repository, found := gitForSite(data.SubscriptionServices.Git,item.ID); found {
			<dl class="np-facts"><div><dt>Mode</dt><dd>{ repository.Mode }</dd></div><div><dt>Remote</dt><dd><code>{ repository.RemoteURL }</code></dd></div><div><dt>Branch</dt><dd>{ repository.Branch }</dd></div><div><dt>Target</dt><dd>{ repository.DeployTarget }</dd></div><div><dt>Last revision</dt><dd>{ repository.LastRevision }</dd></div><div><dt>State</dt><dd>@statusPill(repository.ConvergenceStatus)</dd></div><div><dt>Webhook</dt><dd>{ yesNo(repository.WebhookConfigured) }</dd></div></dl>
			if repository.DeployPublicKey != "" {
				<div class="np-callout"><strong>Read-only deploy key</strong><pre>{ repository.DeployPublicKey }</pre></div>
			}
			<div class="np-panel-actions"><form method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/git/deploy") }>@csrfInput(view)<input type="hidden" name="subscription_id" value={ formatJobID(subscription.ID) }/><button type="submit">Deploy now</button></form>
				if repository.Automatic {
					<form method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/git/webhook") }>@csrfInput(view)<input type="hidden" name="subscription_id" value={ formatJobID(subscription.ID) }/><button type="submit" class="np-secondary-button">Rotate webhook URL</button></form>
				}
			</div>
			if len(gitDeploymentsForRepository(data.SubscriptionServices.GitDeployments,repository.ID)) > 0 {
				<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Deployment</th><th>Revision</th><th>Status</th><th>Finished</th></tr></thead><tbody>
					for _, deployment := range gitDeploymentsForRepository(data.SubscriptionServices.GitDeployments,repository.ID) {
						<tr><td data-label="Deployment">#{ formatJobID(deployment.ID) }</td><td data-label="Revision"><code>{ deployment.Revision }</code></td><td data-label="Status">@statusPill(deployment.Status)</td><td data-label="Finished">{ formatTime(deployment.FinishedAt) }</td></tr>
					}
				</tbody></table></div>
			}
		}
		<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/git") }>@csrfInput(view)<input type="hidden" name="subscription_id" value={ formatJobID(subscription.ID) }/>
			if repository, found := gitForSite(data.SubscriptionServices.Git,item.ID); found {
				<input type="hidden" name="resource_id" value={ formatJobID(repository.ID) }/>
				<input type="hidden" name="return_to" value="site-git"/><div class="np-form-grid"><label>Repository mode<select name="mode"><option value="remote" selected?={ repository.Mode=="remote" }>Remote repository</option><option value="hosted" selected?={ repository.Mode=="hosted" }>Panel hosted</option></select></label><label>Branch<input name="branch" value={ repository.Branch } required/></label><label class="np-wide-field">Remote URL<input name="remote_url" value={ repository.RemoteURL } placeholder="ssh://git@example/repository.git"/></label><label class="np-wide-field">Verified SSH host key<input name="known_host_key" value={ repository.KnownHostKey } placeholder="git.example ssh-ed25519 AAAA..."/></label><label>Deployment target<input name="deploy_target" value={ repository.DeployTarget } required/></label><label class="np-check"><input type="checkbox" name="automatic" value="true" checked?={ repository.Automatic }/>Automatic deployment</label></div>
			} else {
				<input type="hidden" name="return_to" value="site-git"/><div class="np-form-grid"><label>Repository mode<select name="mode"><option value="remote">Remote repository</option><option value="hosted">Panel hosted</option></select></label><label>Branch<input name="branch" value="main" required/></label><label class="np-wide-field">Remote URL<input name="remote_url" placeholder="ssh://git@example/repository.git"/></label><label class="np-wide-field">Verified SSH host key<input name="known_host_key" placeholder="git.example ssh-ed25519 AAAA..."/></label><label>Deployment target<input name="deploy_target" value="." required/></label><label class="np-check"><input type="checkbox" name="automatic" value="true"/>Automatic deployment</label></div>
			}
			<p class="np-form-help">Deployment paths remain below public_html. Remote URLs cannot contain credentials. SSH remotes require a pinned host key.</p><button type="submit">Save repository</button></form>
	</section>
	}
}

templ domainPHPApplication(item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	if view.PHPApplication == nil {
		<p class="np-gate is-blocked">PHP application state is unavailable.</p>
	} else {
		{{ workspace := *view.PHPApplication }}
		{{ activeTab := phpApplicationTab(view.ApplicationTab) }}
		{{ mutationGate := phpApplicationMutationGate(workspace,subscription,data) }}
		<section class="np-php-app" data-np-php-app data-np-php-mode={ string(workspace.Application.HostingMode) }>
			<div class="np-section-heading np-php-app-heading"><div><span class="np-kicker">PHP Application</span><h2>{ phpHostingModeLabel(workspace.Application.HostingMode) }</h2><p>
				if workspace.Application.HostingMode == types.PHPHostingModeManaged {
					Immutable Git and Composer releases with health-gated activation and rollback.
				} else {
					Mutable public_html for uploaded PHP applications and self-updating WordPress sites.
				}
			</p></div><div class="np-php-app-head-actions">@statusPill(workspace.ConvergenceStatus)
				if mutationGate.CanReconcile {
					<form method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application/reconcile") }>@csrfInput(view)<button type="submit" class="np-secondary-button" data-np-confirm="Reconcile PHP application state with the server?">@icon("activity")<span>Reconcile</span></button></form>
				}
			</div></div>
			<nav class="np-php-app-tabs" aria-label="PHP application workspace" data-np-php-app-tabs>
				@phpApplicationTabLink(item.ID,"overview","Overview",view)
				@phpApplicationTabLink(item.ID,"deployment","Deployment",view)
				@phpApplicationTabLink(item.ID,"environment","Environment",view)
				@phpApplicationTabLink(item.ID,"workers","Workers",view)
				@phpApplicationTabLink(item.ID,"releases","Releases",view)
				@phpApplicationTabLink(item.ID,"logs","Logs",view)
				@phpApplicationTabLink(item.ID,"activity","Activity",view)
			</nav>
			if activeTab == "overview" {
				@phpApplicationOverview(item,subscription,data,workspace,mutationGate,view)
			} else if activeTab == "deployment" {
				@phpApplicationDeployment(item,data,workspace,mutationGate,view)
			} else if activeTab == "environment" {
				@phpApplicationEnvironment(item,workspace,mutationGate,view)
			} else if activeTab == "workers" {
				@phpApplicationWorkers(item,workspace,mutationGate,view)
			} else if activeTab == "releases" {
				@phpApplicationReleases(item,workspace,mutationGate,view)
			} else if activeTab == "logs" {
				@phpApplicationLogs(item,workspace,view)
			} else if activeTab == "activity" {
				@phpApplicationActivity(item,workspace,view)
			}
			@phpApplicationDialogs(item,data,workspace,mutationGate,view)
		</section>
	}
}

templ phpApplicationTabLink(siteID int64, tab string, label string, view WorkspaceView) {
	<a href={ phpApplicationTabURL(view,siteID,tab) } class={ phpApplicationTabClass(view,tab) } aria-current={ phpApplicationAriaCurrent(view,tab) } data-np-php-app-tab={ tab }>{ label }</a>
}

templ phpRuntimeOptions(workspace controlphpapp.Workspace) {
	if len(workspace.Capabilities.PHPRuntimes) == 0 {
		<option value={ workspace.Application.PHPVersion } selected>{ workspace.Application.PHPVersion }</option>
	} else {
		for _, runtime := range workspace.Capabilities.PHPRuntimes {
			if runtime.Ready {
				<option value={ runtime.Version } selected?={ runtime.Version==workspace.Application.PHPVersion }>PHP { runtime.Version } · { phpRuntimeRecommendation(runtime) }</option>
			}
		}
	}
}

templ phpApplicationOverview(item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, workspace controlphpapp.Workspace, mutationGate phpMutationGate, view WorkspaceView) {
	<section class="np-panel np-php-app-summary">
		<div class="np-panel-title"><div><h3>Runtime summary</h3><span class="np-muted">Desired, observed, and host capability state are reported separately.</span></div>@statusPill(workspace.ObservedState)</div>
		<dl class="np-php-summary-band">
			<div><dt>Mode</dt><dd>{ phpHostingModeLabel(workspace.Application.HostingMode) }</dd><small>{ workspace.Application.FrameworkProfile }</small></div>
			<div><dt>PHP runtime</dt><dd>PHP { workspace.Application.PHPVersion }</dd><small>{ phpSupportLabel(workspace.Runtime.SupportStatus) }</small></div>
			<div><dt>Observed</dt><dd>{ workspace.ObservedState }</dd><small>{ workspace.ObservedMessage }</small></div>
			<div><dt>Revision</dt><dd>{ formatJobID(workspace.AppliedRevision) } / { formatJobID(workspace.Application.DesiredRevision) }</dd><small>applied / desired</small></div>
			<div><dt>Release</dt><dd>
				if workspace.ActiveDeploymentID > 0 {
					<span>#{ formatJobID(workspace.ActiveDeploymentID) }</span>
				} else {
					<span>None</span>
				}
			</dd><small>previous #{ formatJobID(workspace.PreviousDeploymentID) }</small></div>
		</dl>
		if workspace.LastError != "" {
			<p class="np-gate is-blocked"><strong>Last convergence error</strong><br/>{ workspace.LastError }</p>
		}
	</section>
	if workspace.Application.HostingMode == types.PHPHostingModeClassic {
		<section class="np-panel np-php-classic">
			<div class="np-panel-title"><div><h3>Classic hosting diagnostics</h3><span class="np-muted">The subscription account owns writable application content.</span></div>
				if mutationGate.CanConfigure && gitRepositoryAvailable(data.SubscriptionServices.Git,item.ID) {
					<button type="button" data-np-dialog-open="php-managed-setup-dialog">Configure Managed Deployment</button>
				}
			</div>
			<p class="np-callout">Classic hosting keeps <strong>mutable public_html</strong> available to WordPress and applications that update their own code or content. Panel-triggered Composer deployment is available only in Managed Deployment.</p>
			<dl class="np-facts np-php-diagnostics"><div><dt>Document root</dt><dd><code>{ item.DocumentRoot }</code></dd></div><div><dt>CLI</dt><dd><code>{ workspace.Runtime.CLIPath }</code></dd></div><div><dt>PHP-FPM</dt><dd><code>{ workspace.Runtime.FPMPath }</code></dd></div><div><dt>FPM configuration</dt><dd>{ yesNo(workspace.Runtime.FPMConfigValid) }</dd></div><div><dt>OPcache</dt><dd>{ yesNo(workspace.Runtime.OPcacheAvailable) }</dd></div><div><dt>Composer</dt><dd>{ phpToolStatus(workspace.Capabilities.ComposerAvailable,workspace.Capabilities.ComposerVersion) }</dd></div><div><dt>WP-CLI</dt><dd>{ phpToolStatus(workspace.Capabilities.WPCLIAvailable,workspace.Capabilities.WPCLIVersion) }</dd></div><div><dt>FPM children</dt><dd>{ formatPlanLimit(subscription.PHPFPMMaxChildren) }</dd></div><div><dt>Memory</dt><dd>{ formatPlanLimitMB(subscription.PHPMemoryMB) }</dd></div></dl>
			@phpExtensionSummary(workspace.Runtime)
			<div class="np-php-tool-links"><a href={ templ.SafeURL(fileBasePath(view,item.ID)) }>Files</a><a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/access")) }>Access</a><a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"?tab=php")) }>PHP</a><a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/git")) }>Git</a><a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"?tab=databases")) }>Databases</a><a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"?tab=backups")) }>Backups</a><a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/logs")) }>Logs</a><a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/scheduled-tasks")) }>Tasks</a></div>
			if mutationGate.Message != "" {
				<p class="np-gate">{ mutationGate.Message }</p>
			}
		</section>
	} else {
		<section class="np-panel"><div class="np-panel-title"><div><h3>Managed application</h3><span class="np-muted">Git source, immutable releases, and bounded PHP-FPM execution.</span></div><div class="np-row-actions">
			if mutationGate.CanConfigure {
				<button type="button" class="np-secondary-button" data-np-dialog-open="php-managed-setup-dialog">Application settings</button>
			}
			if mutationGate.CanDeploy {
				<button type="button" data-np-dialog-open="php-deploy-dialog">Deploy release</button>
			}
		</div></div>
			<dl class="np-facts"><div><dt>Profile</dt><dd>{ workspace.Application.FrameworkProfile }</dd></div><div><dt>Repository</dt><dd>{ phpRepositoryLabel(data.SubscriptionServices.Git,workspace.Application.RepositoryID) }</dd></div><div><dt>Reference</dt><dd><code>{ workspace.Application.RepositoryRef }</code></dd></div><div><dt>Public directory</dt><dd><code>{ workspace.Application.PublicPath }</code></dd></div><div><dt>Shared paths</dt><dd>{ phpSharedPaths(workspace.Application.SharedPaths) }</dd></div><div><dt>Health path</dt><dd><code>{ workspace.Application.HealthPath }</code></dd></div><div><dt>Release retention</dt><dd>{ formatPlanLimit(workspace.Application.ReleaseRetention) } (plan limit { phpReleaseLimit(workspace) })</dd></div><div><dt>Composer</dt><dd>{ phpComposerLabel(workspace.Application.Composer) }</dd></div></dl>
			if mutationGate.Message != "" {
				<p class="np-gate">{ mutationGate.Message }</p>
			}
		</section>
	}
}

templ phpApplicationDeployment(item dashboard.Site, data dashboard.Data, workspace controlphpapp.Workspace, mutationGate phpMutationGate, view WorkspaceView) {
	if workspace.Application.HostingMode != types.PHPHostingModeManaged {
		<section class="np-panel np-php-empty"><h3>Managed Deployment is not configured</h3><p>Classic Hosting remains live. Connect the existing site Git repository and complete the guided setup to create the first immutable release.</p>
			if !mutationGate.CanConfigure {
				<p class="np-gate">{ mutationGate.Message }</p>
			} else if !gitRepositoryAvailable(data.SubscriptionServices.Git,item.ID) {
				<p class="np-gate">Configure a Git repository for this domain first.</p>
			} else {
				<button type="button" data-np-dialog-open="php-managed-setup-dialog">Start managed setup</button>
			}
		</section>
	} else {
		<section class="np-panel"><div class="np-panel-title"><div><h3>Deploy from Git</h3><span class="np-muted">The current release remains active unless the candidate passes Composer, FPM, nginx, and live health checks.</span></div>
			if mutationGate.CanDeploy {
				<button type="button" data-np-dialog-open="php-deploy-dialog">Queue deployment</button>
			}
		</div>
			<dl class="np-facts"><div><dt>Source</dt><dd>{ phpRepositoryLabel(data.SubscriptionServices.Git,workspace.Application.RepositoryID) }</dd></div><div><dt>Default ref</dt><dd><code>{ workspace.Application.RepositoryRef }</code></dd></div><div><dt>Health gate</dt><dd>3 successful HTTP 200–399 probes</dd></div><div><dt>Composer audit</dt><dd>High and critical findings block activation</dd></div></dl>
			if !mutationGate.CanDeploy {
				<p class="np-gate">{ mutationGate.Message }</p>
			}
			if deployment, ok := latestPHPDeployment(workspace.Deployments); ok {
				@phpDeploymentDetail(deployment,workspace)
			} else {
				<p class="np-empty">No deployment has been queued yet.</p>
			}
		</section>
	}
}

templ phpApplicationEnvironment(item dashboard.Site, workspace controlphpapp.Workspace, mutationGate phpMutationGate, view WorkspaceView) {
	<section class="np-panel"><div class="np-panel-title"><div><h3>Environment</h3><span class="np-muted">Plain values are visible. Secret values are encrypted and remain write-only.</span></div>
		if mutationGate.CanEnvironment {
			<button type="button" data-np-dialog-open="php-environment-dialog">Add variable</button>
		}
	</div>
		if !mutationGate.CanEnvironment {
			<p class="np-gate">{ mutationGate.Message }</p>
		}
		if workspace.Application.HostingMode == types.PHPHostingModeManaged && len(workspace.Environment) == 0 {
			<p class="np-empty">No environment variables are configured.</p>
		}
		if workspace.Application.HostingMode == types.PHPHostingModeManaged && len(workspace.Environment) > 0 {
			<div class="np-php-object-list">
				for _, item := range workspace.Environment {
					<article><div><strong>{ item.Name }</strong><small>{ phpEnvironmentKind(item) }</small></div><div>
						if item.SecretID > 0 {
							<span class="np-secret-mask">••••••••</span>
						}
						if item.SecretID == 0 {
							<code>{ item.Value }</code>
						}
					</div>
					if mutationGate.CanEnvironment {
						<div class="np-row-actions"><button type="button" class="np-icon-button" data-np-dialog-open={ "php-environment-edit-"+item.Name } title={ "Edit "+item.Name }>@icon("pencil")</button><button type="button" class="np-icon-button" data-np-dialog-open={ "php-environment-delete-"+item.Name } title={ "Delete "+item.Name }>@icon("trash")</button></div>
					}
				</article>
				}
			</div>
		}
	</section>
}

templ phpApplicationWorkers(item dashboard.Site, workspace controlphpapp.Workspace, mutationGate phpMutationGate, view WorkspaceView) {
	<section class="np-panel"><div class="np-panel-title"><div><h3>PHP workers</h3><span class="np-muted">Workers execute the selected PHP binary and a validated site-relative script directly, without a shell.</span></div>
		if mutationGate.CanWorkers {
			<button type="button" data-np-dialog-open="php-worker-dialog">Add worker</button>
		}
	</div>
		<div class="np-php-allocation"><span>Process allocation</span><strong>{ phpWorkerProcessCount(workspace.Workers) } / { phpWorkerLimit(workspace) }</strong></div>
		if !mutationGate.CanWorkers {
			if mutationGate.Message != "" {
				<p class="np-gate">{ mutationGate.Message }</p>
			} else {
				<p class="np-gate">{ mutationGate.WorkerMessage }</p>
			}
		}
		if workspace.Policy.Permissions.PHPWorkers && workspace.Application.HostingMode == types.PHPHostingModeManaged && workspace.ActiveDeploymentID > 0 && len(workspace.Workers) == 0 {
			<p class="np-empty">No background workers are configured.</p>
		}
		if workspace.Policy.Permissions.PHPWorkers && workspace.Application.HostingMode == types.PHPHostingModeManaged && workspace.ActiveDeploymentID > 0 && len(workspace.Workers) > 0 {
			<div class="np-php-worker-list">
				for _, worker := range workspace.Workers {
					<article><div class="np-php-worker-main"><div><strong>{ worker.Name }</strong><code>php { worker.Script } { phpWorkerArguments(worker.Arguments) }</code></div>@statusPill(worker.ConvergenceStatus)</div><dl><div><dt>Processes</dt><dd>{ formatPlanLimit(worker.Processes) }</dd></div><div><dt>Desired</dt><dd>{ worker.DesiredState }</dd></div><div><dt>Observed</dt><dd>{ worker.ObservedState }</dd></div></dl>
						if worker.LastError != "" {
							<p class="np-error">{ worker.LastError }</p>
						}
						if mutationGate.CanWorkers {
							<div class="np-row-actions"><form method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application/workers/"+formatJobID(worker.ID)+"/state") }>@csrfInput(view)<input type="hidden" name="state" value={ phpWorkerOppositeState(worker.DesiredState) }/><button type="submit" class="np-secondary-button">{ phpWorkerStateAction(worker.DesiredState) }</button></form><button type="button" class="np-icon-button" data-np-dialog-open={ "php-worker-edit-"+formatJobID(worker.ID) } title={ "Edit "+worker.Name }>@icon("pencil")</button><button type="button" class="np-icon-button" data-np-dialog-open={ "php-worker-delete-"+formatJobID(worker.ID) } title={ "Delete "+worker.Name }>@icon("trash")</button></div>
						}
					</article>
				}
			</div>
		}
	</section>
}

templ phpApplicationReleases(item dashboard.Site, workspace controlphpapp.Workspace, mutationGate phpMutationGate, view WorkspaceView) {
	<section class="np-panel"><div class="np-panel-title"><div><h3>Release history</h3><span class="np-muted">Active and previous healthy releases are retained even when the plan limit is lower.</span></div><span class="np-pill np-pill-run">limit { phpReleaseLimit(workspace) }</span></div>
		if workspace.Application.HostingMode != types.PHPHostingModeManaged {
			<p class="np-gate">Release history begins after Managed Deployment is configured.</p>
		}
		if workspace.Application.HostingMode == types.PHPHostingModeManaged && len(workspace.Deployments) == 0 {
			<p class="np-empty">No releases yet.</p>
		}
		if workspace.Application.HostingMode == types.PHPHostingModeManaged && len(workspace.Deployments) > 0 {
			<div class="np-php-release-list">
				for _, deployment := range workspace.Deployments {
					@phpReleaseRow(item,deployment,workspace,mutationGate,view)
				}
			</div>
		}
	</section>
}

templ phpReleaseRow(item dashboard.Site, deployment types.PHPDeployment, workspace controlphpapp.Workspace, mutationGate phpMutationGate, view WorkspaceView) {
	<article><div class="np-php-release-identity"><span class="np-object-icon">#{ formatJobID(deployment.ID) }</span><div><strong>{ deployment.RequestedRevision }</strong><code>{ deployment.ResolvedRevision }</code><small>{ formatTime(deployment.CreatedAt) }</small></div></div><div><span class="np-kicker">{ phpDeploymentMarker(deployment,workspace.ActiveDeploymentID,workspace.PreviousDeploymentID) }</span>@statusPill(deployment.Status)</div><div class="np-php-release-actions">
		if mutationGate.CanDeploy && phpDeploymentRollbackEligible(deployment,workspace.ActiveDeploymentID) {
			<button type="button" class="np-secondary-button" data-np-dialog-open={ "php-rollback-"+formatJobID(deployment.ID) }>Roll back</button>
		}
	</div></article>
}

templ phpApplicationLogs(item dashboard.Site, workspace controlphpapp.Workspace, view WorkspaceView) {
	<section class="np-panel"><div class="np-panel-title"><div><h3>PHP application logs</h3><span class="np-muted">Deployment and worker sources use the bounded domain log browser.</span></div><a class="np-secondary-button" href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/logs")) }>Open log browser</a></div>
		<div class="np-php-log-sources"><a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/logs?source=php_deployment")) }><strong>Deployment output</strong><span>Sanitized Composer and activation output</span></a><a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/logs?source=php_worker")) }><strong>Worker logs</strong><span>Bounded stdout and service errors</span></a><a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/logs?source=php_fpm")) }><strong>PHP-FPM errors</strong><span>Dedicated domain process manager</span></a></div>
		if deployment, ok := latestPHPDeployment(workspace.Deployments); ok {
			@phpDeploymentDetail(deployment,workspace)
		}
	</section>
}

templ phpApplicationActivity(item dashboard.Site, workspace controlphpapp.Workspace, view WorkspaceView) {
	<section class="np-panel"><div class="np-panel-title"><div><h3>Application activity</h3><span class="np-muted">Mutation and convergence events remain attributable to the signed-in actor.</span></div><a class="np-secondary-button" href={ templ.SafeURL(workspacePath(view,"/activity")) }>Open Activity</a></div><dl class="np-facts"><div><dt>Desired revision</dt><dd>{ formatJobID(workspace.Application.DesiredRevision) }</dd></div><div><dt>Applied revision</dt><dd>{ formatJobID(workspace.AppliedRevision) }</dd></div><div><dt>Last reconciliation</dt><dd>{ formatTime(workspace.LoadedAt) }</dd></div><div><dt>Convergence</dt><dd>{ workspace.ConvergenceStatus }</dd></div></dl></section>
}

templ phpDeploymentDetail(deployment types.PHPDeployment, workspace controlphpapp.Workspace) {
	<div class="np-php-deployment-detail"><div class="np-panel-title"><div><h4>Deployment #{ formatJobID(deployment.ID) }</h4><span class="np-muted">{ deployment.RequestedRevision } → { deployment.ResolvedRevision }</span></div>@statusPill(deployment.Status)</div><dl class="np-facts"><div><dt>Started</dt><dd>{ formatTime(deployment.StartedAt) }</dd></div><div><dt>Finished</dt><dd>{ formatTime(deployment.FinishedAt) }</dd></div><div><dt>Health</dt><dd>{ deployment.HealthMessage }</dd></div><div><dt>Composer audit</dt><dd>{ deployment.ComposerAudit }</dd></div></dl>
		if deployment.LastError != "" {
			<pre class="np-bounded-output">{ deployment.LastError }</pre>
		}
	</div>
}

templ phpExtensionSummary(runtime types.PHPRuntimeCapability) {
	<div class="np-php-extension-summary"><div><strong>Loaded extension baseline</strong><span>{ phpExtensionList(runtime.Extensions) }</span></div><div><strong>Missing required extensions</strong><span class={ phpMissingExtensionClass(runtime.MissingExtensions) }>{ phpMissingExtensionList(runtime.MissingExtensions) }</span></div></div>
}

templ phpApplicationDialogs(item dashboard.Site, data dashboard.Data, workspace controlphpapp.Workspace, mutationGate phpMutationGate, view WorkspaceView) {
	if mutationGate.CanConfigure {
		<dialog class="np-dialog np-php-setup-dialog" id="php-managed-setup-dialog" data-np-dialog><div class="np-dialog-head"><div><span class="np-kicker">Managed Deployment</span><h2>Configure PHP application</h2><p>Classic Hosting stays live until the first managed release passes every health gate.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div>
			<form class="np-form np-dialog-form np-php-setup" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application") } data-np-php-setup data-np-dirty-guard>@csrfInput(view)<input type="hidden" name="hosting_mode" value="managed"/>
				<ol class="np-php-setup-steps" aria-label="Managed setup steps"><li><a href="#php-managed-step-source" class="is-active" data-np-php-step-target="0" aria-controls="php-managed-step-source" aria-current="step">1 Source</a></li><li><a href="#php-managed-step-runtime" data-np-php-step-target="1" aria-controls="php-managed-step-runtime">2 Runtime</a></li><li><a href="#php-managed-step-environment" data-np-php-step-target="2" aria-controls="php-managed-step-environment">3 Environment</a></li><li><a href="#php-managed-step-review" data-np-php-step-target="3" aria-controls="php-managed-step-review">4 Review</a></li></ol>
				<fieldset class="np-php-setup-panel" id="php-managed-step-source" data-np-php-step-panel="0" tabindex="-1"><legend>Source</legend><p>Choose the existing domain repository and the branch, tag, or commit to deploy.</p><label>Git repository<select name="repository_id" required>
					for _, repository := range data.SubscriptionServices.Git {
						if repository.SiteID == item.ID {
							<option value={ formatJobID(repository.ID) } selected?={ repository.ID==workspace.Application.RepositoryID }>{ phpGitOption(repository) }</option>
						}
					}
				</select></label><label>Repository reference<input name="repository_ref" value={ phpDefaultString(workspace.Application.RepositoryRef,"main") } required/></label><div class="np-php-step-actions"><button type="button" data-np-php-step-next>Next: Runtime</button></div></fieldset>
				<fieldset class="np-php-setup-panel" id="php-managed-step-runtime" data-np-php-step-panel="1" tabindex="-1"><legend>Runtime and paths</legend><p>Profile defaults remain editable and are validated as site-relative paths by the server.</p><label>Framework profile<select name="framework_profile" data-np-php-profile><option value="plain" selected?={ workspace.Application.FrameworkProfile==types.PHPFrameworkPlain }>Plain PHP</option><option value="laravel" selected?={ workspace.Application.FrameworkProfile==types.PHPFrameworkLaravel }>Laravel</option><option value="symfony" selected?={ workspace.Application.FrameworkProfile==types.PHPFrameworkSymfony }>Symfony</option><option value="custom" selected?={ workspace.Application.FrameworkProfile==types.PHPFrameworkCustom }>Custom</option></select></label><label>PHP runtime<select name="php_version" required>@phpRuntimeOptions(workspace)</select></label><label>Public directory<input name="public_path" value={ workspace.Application.PublicPath } data-np-php-public placeholder="public"/></label><label>Health path<input name="health_path" value={ phpDefaultString(workspace.Application.HealthPath,"/") } data-np-php-health required/></label><label class="np-wide-field">Shared writable paths<textarea name="shared_paths" rows="3" data-np-php-shared placeholder="storage&#10;bootstrap/cache">{ phpSharedPathsTextarea(workspace.Application.SharedPaths) }</textarea></label><div class="np-php-step-actions"><button type="button" class="np-secondary-button" data-np-php-step-back>Back</button><button type="button" data-np-php-step-next>Next: Environment</button></div></fieldset>
				<fieldset class="np-php-setup-panel" id="php-managed-step-environment" data-np-php-step-panel="2" tabindex="-1"><legend>Environment and Composer</legend><p>{ formatPlanLimit(len(workspace.Environment)) } environment bindings are configured. Secret values remain write-only and can be changed after setup.</p><label>Healthy releases to retain<input type="number" name="release_retention" min="1" max="100" value={ phpRetentionValue(workspace.Application.ReleaseRetention) } required/></label><div class="np-permission-list"><label class="np-permission-row"><input type="checkbox" name="composer_install" value="true" checked?={ workspace.Application.Composer.Install } disabled?={ !workspace.Policy.Permissions.Composer }/><span>Install Composer dependencies</span></label><label class="np-permission-row"><input type="checkbox" name="composer_allow_scripts" value="true" checked?={ workspace.Application.Composer.AllowScripts } disabled?={ !workspace.Policy.Permissions.ComposerCodeExecution }/><span>Allow Composer scripts</span></label><label class="np-permission-row"><input type="checkbox" name="composer_allow_plugins" value="true" checked?={ workspace.Application.Composer.AllowPlugins } disabled?={ !workspace.Policy.Permissions.ComposerCodeExecution }/><span>Allow Composer plugins</span></label></div>
					if workspace.Application.Composer.Install && !workspace.Policy.Permissions.Composer {
						<input type="hidden" name="composer_install" value="true"/>
					}
					if workspace.Application.Composer.AllowScripts && !workspace.Policy.Permissions.ComposerCodeExecution {
						<input type="hidden" name="composer_allow_scripts" value="true"/>
					}
					if workspace.Application.Composer.AllowPlugins && !workspace.Policy.Permissions.ComposerCodeExecution {
						<input type="hidden" name="composer_allow_plugins" value="true"/>
					}
				<div class="np-php-step-actions"><button type="button" class="np-secondary-button" data-np-php-step-back>Back</button><button type="button" data-np-php-step-next>Next: Review</button></div></fieldset>
				<fieldset class="np-php-setup-panel" id="php-managed-step-review" data-np-php-step-panel="3" tabindex="-1"><legend>Review and save</legend><div class="np-php-review"><strong>Security boundary</strong><p>Paths are site-relative, secrets remain write-only, and activation is atomic after three successful probes. Plan limits: { phpReleaseLimit(workspace) } releases and { phpWorkerLimit(workspace) } worker processes.</p></div><dl class="np-facts"><div><dt>Repository</dt><dd>{ phpRepositoryLabel(data.SubscriptionServices.Git,workspace.Application.RepositoryID) }</dd></div><div><dt>PHP</dt><dd>{ workspace.Application.PHPVersion }</dd></div><div><dt>Profile</dt><dd>{ workspace.Application.FrameworkProfile }</dd></div><div><dt>Composer</dt><dd>{ phpComposerLabel(workspace.Application.Composer) }</dd></div></dl><div class="np-php-step-actions"><button type="button" class="np-secondary-button" data-np-php-step-back>Back</button><button type="submit">Save and reconcile</button></div></fieldset>
				<div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button></div>
			</form>
		</dialog>
	}
	if mutationGate.CanDeploy {
		<dialog class="np-dialog" id="php-deploy-dialog" data-np-dialog><div class="np-dialog-head"><div><h2>Queue PHP deployment</h2><p>The active release stays online until the candidate is healthy.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application/deployments") }>@csrfInput(view)<label>Git revision<input name="revision" value={ phpDefaultString(workspace.Application.RepositoryRef,"main") } required maxlength="128"/></label><p class="np-form-help">Use a branch, tag, or commit known to the configured repository. Composer lock and security checks run before activation.</p><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Queue deployment</button></div></form></dialog>
	}
	if mutationGate.CanEnvironment {
		<dialog class="np-dialog" id="php-environment-dialog" data-np-dialog><div class="np-dialog-head"><div><h2>Add environment variable</h2><p>Choose plain text or an encrypted write-only secret.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application/environment") } data-np-php-environment-form>@csrfInput(view)<label>Name<input name="name" pattern="[A-Z_][A-Z0-9_]{0,127}" autocomplete="off" required/></label><label class="np-check"><input type="checkbox" name="secret" value="true" data-np-php-secret-toggle/>Encrypted secret</label><label data-np-php-plain-field>Value<textarea name="value" rows="3"></textarea></label><label data-np-php-secret-field hidden>Secret value<input type="password" name="secret_value" autocomplete="new-password"/></label><p class="np-form-help">Secret values are never rendered after submission and are not included in jobs, audits, logs, or responses.</p><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Save variable</button></div></form></dialog>
	}
	if mutationGate.CanWorkers {
		<dialog class="np-dialog" id="php-worker-dialog" data-np-dialog><div class="np-dialog-head"><div><h2>Add PHP worker</h2><p>The PHP binary executes a site-relative script directly. Shell strings are not accepted.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application/workers") }>@csrfInput(view)<label>Name<input name="name" required maxlength="48"/></label><label>Site-relative PHP script<input name="script" placeholder="artisan" required/></label><label>Arguments, one per line<textarea name="arguments" rows="4" placeholder="queue:work&#10;--tries=3"></textarea></label><label>Processes<input type="number" name="processes" min="1" value="1" required/></label><input type="hidden" name="desired_state" value="running"/><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Create worker</button></div></form></dialog>
	}
	if mutationGate.CanEnvironment {
		for _, environment := range workspace.Environment {
			<dialog class="np-dialog" id={ "php-environment-edit-"+environment.Name } data-np-dialog><div class="np-dialog-head"><div><h2>Edit { environment.Name }</h2><p>
			if environment.SecretID > 0 {
				Enter a replacement value. The existing secret is never rendered.
			} else {
				Update the plain environment value or convert it to a write-only secret.
			}
			</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application/environment") } data-np-php-environment-form>@csrfInput(view)<label>Name<input name="name" value={ environment.Name } readonly/></label><label class="np-check"><input type="checkbox" name="secret" value="true" checked?={ environment.SecretID > 0 } data-np-php-secret-toggle/>Encrypted secret</label><label data-np-php-plain-field hidden?={ environment.SecretID > 0 }>Value<textarea name="value" rows="3">{ environment.Value }</textarea></label><label data-np-php-secret-field hidden?={ environment.SecretID == 0 }>Replacement secret<input type="password" name="secret_value" autocomplete="new-password" required?={ environment.SecretID > 0 }/></label><p class="np-form-help">Saving a secret replaces its encrypted value; Nakpanel never displays the previous value.</p><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Save variable</button></div></form></dialog>
			<dialog class="np-dialog" id={ "php-environment-delete-"+environment.Name } data-np-dialog><div class="np-dialog-head"><div><h2>Delete { environment.Name }?</h2><p>The next reconciliation removes this binding from PHP-FPM and worker services.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-dialog-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application/environment/delete") }>@csrfInput(view)<input type="hidden" name="name" value={ environment.Name }/><input type="hidden" name="confirm" value="delete"/><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit" class="np-danger-button">Delete variable</button></div></form></dialog>
		}
	}
	if mutationGate.CanWorkers {
		for _, worker := range workspace.Workers {
			<dialog class="np-dialog" id={ "php-worker-edit-"+formatJobID(worker.ID) } data-np-dialog><div class="np-dialog-head"><div><h2>Edit { worker.Name }</h2><p>The PHP binary continues to execute this site-relative script directly without a shell.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application/workers") }>@csrfInput(view)<input type="hidden" name="worker_id" value={ formatJobID(worker.ID) }/><label>Name<input name="name" value={ worker.Name } required maxlength="48"/></label><label>Site-relative PHP script<input name="script" value={ worker.Script } required/></label><label>Arguments, one per line<textarea name="arguments" rows="4">{ phpWorkerArgumentsTextarea(worker.Arguments) }</textarea></label><label>Processes<input type="number" name="processes" min="1" value={ formatPlanLimit(worker.Processes) } required/></label><input type="hidden" name="desired_state" value={ worker.DesiredState }/><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Save worker</button></div></form></dialog>
			<dialog class="np-dialog" id={ "php-worker-delete-"+formatJobID(worker.ID) } data-np-dialog><div class="np-dialog-head"><div><h2>Delete { worker.Name }?</h2><p>The worker service will be removed during reconciliation.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-dialog-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application/workers/"+formatJobID(worker.ID)+"/delete") }>@csrfInput(view)<input type="hidden" name="confirm" value="delete"/><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit" class="np-danger-button">Delete worker</button></div></form></dialog>
		}
	}
	if mutationGate.CanDeploy {
		for _, deployment := range workspace.Deployments {
			if phpDeploymentRollbackEligible(deployment,workspace.ActiveDeploymentID) {
				<dialog class="np-dialog" id={ "php-rollback-"+formatJobID(deployment.ID) } data-np-dialog><div class="np-dialog-head"><div><h2>Roll back to release #{ formatJobID(deployment.ID) }?</h2><p>The target is health checked before production switches. The current release is restored automatically on failure.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-dialog-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/php-application/deployments/"+formatJobID(deployment.ID)+"/rollback") }>@csrfInput(view)<input type="hidden" name="confirm" value="rollback"/><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit" class="np-danger-button">Roll back</button></div></form></dialog>
			}
		}
	}
}

templ domainContainers(user auth.SessionUser, item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	if view.ContainerID > 0 {
		if application, found := applicationForID(data.SubscriptionServices.Applications,view.ContainerID); found {
			@domainContainerDetail(item,subscription,application,data,view)
		}
	} else {
		@pageSectionHead("Containers", "Digest-pinned OCI workloads with health-gated loopback routing.")
		<section class="np-panel np-domain-summary np-container-summary">
			<div class="np-panel-title"><div><h2>Runtime boundary</h2><span class="np-muted">Rootless Podman · immutable revisions · nginx ingress</span></div><button type="button" data-np-dialog-open="deploy-container-dialog">Deploy container</button></div>
			<dl class="np-domain-overview-band"><div><dt>Containers</dt><dd>{ formatPlanLimit(len(applicationsForSite(data.SubscriptionServices.Applications,item.ID))) }</dd><small>subscription-scoped entitlement</small></div><div><dt>Ingress</dt><dd>Loopback only</dd><small>127.0.0.1 managed endpoints</small></div><div><dt>Images</dt><dd>Digest pinned</dd><small>Mutable tags rejected by panel and agent</small></div><div><dt>Secrets</dt><dd>Write only</dd><small>Encrypted until worker execution</small></div></dl>
		</section>
		<section class="np-panel"><div class="np-panel-title"><div><h2>Domain containers</h2><span class="np-muted">Desired and observed state are shown separately.</span></div></div>
			if len(applicationsForSite(data.SubscriptionServices.Applications,item.ID)) == 0 {
				<div class="np-container-empty">
					<span class="np-empty-icon">@icon("package-open")</span>
					<div><h3>No containers yet</h3><p>Deploy a digest-pinned OCI workload when this domain needs an isolated application runtime.</p></div>
				</div>
			} else {
				<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Container</th><th>Route</th><th>Desired</th><th>Observed</th><th>Revision</th><th></th></tr></thead><tbody>
					for _, application := range applicationsForSite(data.SubscriptionServices.Applications,item.ID) {
						<tr><td data-label="Container"><strong>{ application.Name }</strong><small><code>{ shortImageReference(application.ImageRef) }</code></small></td><td data-label="Route">
							if application.RouteMode == "domain" {
								Whole domain
							} else {
								<code>{ application.RoutePrefix }</code>
							}
						</td><td data-label="Desired">@statusPill(application.DesiredState)</td><td data-label="Observed">@statusPill(application.ObservedState)
							if application.ObservedMessage != "" {
								<small class="np-error">{ application.ObservedMessage }</small>
							}
						</td><td data-label="Revision">#{ formatJobID(application.ActiveRevision) }</td><td><a class="np-secondary-button" href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/containers/"+formatJobID(application.ID))) }>Manage</a></td></tr>
					}
				</tbody></table></div>
			}
		</section>
		@containerDeployDialog(user,item,subscription,data,view)
	}
}

templ containerDeployDialog(user auth.SessionUser, item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	<dialog class="np-dialog np-dialog-wide" id="deploy-container-dialog" data-np-dialog aria-labelledby="deploy-container-title">
		<form class="np-dialog-form np-container-deploy-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/applications") } data-np-container-deploy>
			@csrfInput(view)<input type="hidden" name="site_id" value={ formatJobID(item.ID) }/><input type="hidden" name="return_to" value="site-containers"/><input type="hidden" name="runtime" value="oci"/><input type="hidden" name="desired_state" value="running"/>
			<div class="np-dialog-head"><div><span class="np-kicker">Guided OCI deployment</span><h2 id="deploy-container-title">Deploy container</h2><p>Nakpanel allocates the host endpoint and derives all ownership and limits from the selected subscription.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div>
			if policy, found := policyForSite(data.SubscriptionServices.SitePolicies,item.ID); !found {
				<p class="np-gate is-blocked">Container policy is unavailable.</p>
			} else if !policy.Permissions.Applications {
				<p class="np-gate">Containers are disabled by this subscription.</p>
			} else {
				<div class="np-form-grid">
					<label>Name<input name="name" pattern="[a-z][a-z0-9-]{1,47}" required/></label>
					<label>Catalog recipe<select name="catalog_slug" data-np-container-catalog>
						for _, preset := range containerPresetsForPolicy(data.SubscriptionServices.ApplicationPresets,policy) {
							<option value={ preset.Slug }>{ preset.Name }</option>
						}
						if policy.Permissions.CustomOCIImages {
							<option value="">Custom OCI image</option>
						}
					</select></label>
					<label class="np-wide-field" data-np-custom-image-field>Custom digest-pinned image<input name="image_ref" placeholder="docker.io/vendor/image@sha256:..." autocomplete="off"/><small>Use an allowed registry and immutable <code>sha256</code> digest.</small></label>
					<label>Route<select name="route_mode" data-np-container-route><option value="prefix">URL prefix</option><option value="domain">Whole domain</option></select></label>
					<label data-np-route-prefix-field>URL prefix<input name="route_prefix" placeholder="/apps/my-app/"/></label>
					<label>Container port<input type="number" name="container_port" min="1" max="65535" value="8080" required/></label>
					<label>Health check<select name="health_kind" data-np-container-health><option value="http">HTTP</option><option value="tcp">TCP</option></select></label>
					<label data-np-health-path-field>Health path<input name="health_path" value="/healthz"/></label>
					<label>Readiness timeout<input type="number" name="health_timeout_seconds" min="1" max="300" value="30"/></label>
					<label>Volume name<input name="volume_name" pattern="[a-z][a-z0-9-]{0,31}" placeholder="data"/></label>
					<label>Container path<input name="volume_target" placeholder="/var/lib/application"/></label>
					<label>Volume size (MB)<input type="number" min="1" name="volume_size_mb" placeholder="1024"/></label>
					<label class="np-check"><input type="checkbox" name="volume_read_only" value="true"/>Mount volume read-only</label>
					<label class="np-wide-field">Environment variables (JSON)<textarea name="environment" rows="4" spellcheck="false" data-np-json-object>{ "{}" }</textarea><small>Optional string key/value pairs, for example <code>{ "{\"APP_ENV\":\"production\"}" }</code>.</small></label>
					<label class="np-wide-field">Secret values (write-only JSON)<textarea name="secrets" rows="4" spellcheck="false" autocomplete="off" data-np-json-object placeholder={"{\"DATABASE_PASSWORD\":\"...\"}"}></textarea><small>Values are encrypted and mounted below <code>/run/secrets</code>.</small></label>
				</div>
				<div class="np-container-resource-summary" aria-label="Subscription container limits">
					<div><span>Applications</span><strong>{ formatPlanLimit(len(applicationsForSubscription(data.SubscriptionServices.Applications,subscription.ID))) } / { formatPlanLimit(policy.Resources.MaxApplications) }</strong></div>
					<div><span>Memory</span><strong>{ formatPlanLimitMB(policy.Resources.MemoryMB) }</strong></div>
					<div><span>CPU</span><strong>{ formatPlanLimit(policy.Resources.CPUPercent) }</strong><small>percent allocation</small></div>
					<div><span>Container storage</span><strong>{ formatPlanLimitMB(policy.Resources.ContainerStorageMB) }</strong></div>
				</div>
				<p class="np-form-help">The image, route, health probe, storage declaration, and subscription limits are validated again before the deployment job is queued.</p>
				<div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Deploy container</button></div>
			}
		</form>
	</dialog>
}

templ domainContainerDetail(item dashboard.Site, subscription types.SubscriptionSummary, application dashboard.Application, data dashboard.Data, view WorkspaceView) {
	<div class="np-section-heading"><div><span class="np-kicker">Container</span><h2>{ application.Name }</h2><p>Desired state, observed runtime health, route, storage, and deployment history.</p></div><a class="np-secondary-button" href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(item.ID)+"/containers")) }>Back to containers</a></div>
	<section class="np-panel np-domain-summary">
		<div class="np-panel-title"><div><h2>Runtime overview</h2><span class="np-muted">{ shortImageReference(application.ImageRef) }</span></div>@statusPill(application.ObservedState)</div>
		<dl class="np-domain-overview-band"><div><dt>Desired</dt><dd>{ application.DesiredState }</dd><small>Control-plane intent</small></div><div><dt>Observed</dt><dd>{ application.ObservedState }</dd><small>{ formatNullableTime(application.ObservedAt) }</small></div><div><dt>Active revision</dt><dd>#{ formatJobID(application.ActiveRevision) }</dd><small>Last health-gated generation</small></div><div><dt>Endpoint</dt><dd>127.0.0.1:{ formatPlanLimit(application.EndpointPort) }</dd><small>Not publicly bound</small></div></dl>
		if application.LastError != "" {
			<p class="np-gate is-blocked">{ application.LastError }</p>
		}
		<div class="np-panel-actions">
			if application.DesiredState == "running" {
				@containerActionForm(subscription.ID,item.ID,application.ID,"stop","Stop",view)
				@containerActionForm(subscription.ID,item.ID,application.ID,"restart","Restart",view)
			} else {
				@containerActionForm(subscription.ID,item.ID,application.ID,"start","Start",view)
			}
			@containerActionForm(subscription.ID,item.ID,application.ID,"redeploy","Redeploy",view)
			@containerActionForm(subscription.ID,item.ID,application.ID,"rollback","Roll back",view)
			@containerActionForm(subscription.ID,item.ID,application.ID,"reconcile","Reconcile",view)
			<form method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/services/application/"+formatJobID(application.ID)+"/delete") }>
				@csrfInput(view)
				<input type="hidden" name="site_id" value={ formatJobID(item.ID) }/>
				<input type="hidden" name="return_to" value="site-containers"/>
				<button type="submit" class="np-danger-button" data-np-confirm={ "Remove "+application.Name+" and its container storage configuration?" }>Remove</button>
			</form>
		</div>
	</section>
	<nav class="np-domain-tabs" aria-label="Container details"><a href="#container-runtime" class="is-active">Runtime</a><a href="#container-route">Route</a><a href="#container-environment">Environment</a><a href="#container-storage">Storage</a><a href="#container-deployments">Deployments</a><a href="#container-logs">Logs</a><a href="#container-activity">Activity</a></nav>
	<section class="np-panel" id="container-runtime"><div class="np-panel-title"><h2>Runtime</h2></div><dl class="np-facts"><div><dt>OCI image</dt><dd><code>{ application.ImageRef }</code></dd></div><div><dt>Container port</dt><dd>{ formatPlanLimit(application.ContainerPort) }</dd></div><div><dt>Health</dt><dd>{ application.HealthKind } <code>{ application.HealthPath }</code></dd></div></dl></section>
	<section class="np-panel" id="container-route"><div class="np-panel-title"><h2>Route</h2></div><dl class="np-facts"><div><dt>Mode</dt><dd>{ application.RouteMode }</dd></div><div><dt>Path</dt><dd><code>{ application.RoutePrefix }</code></dd></div><div><dt>Upstream</dt><dd><code>127.0.0.1:{ formatPlanLimit(application.EndpointPort) }</code></dd></div></dl></section>
	<section class="np-panel" id="container-environment"><div class="np-panel-title"><h2>Environment &amp; secrets</h2></div><p class="np-callout">Environment values and mounted secrets are intentionally omitted from rendered HTML. Replace write-only secrets through a new deployment revision.</p></section>
	<section class="np-panel" id="container-storage"><div class="np-panel-title"><h2>Storage</h2></div><p class="np-empty">No provider-declared writable volume slots are attached.</p></section>
	<section class="np-panel" id="container-deployments"><div class="np-panel-title"><h2>Deployments</h2></div>
		<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Revision</th><th>Status</th><th>Endpoint</th><th>Health</th><th>Started</th></tr></thead><tbody>
			for _, generation := range applicationGenerationsFor(data.SubscriptionServices.ApplicationGenerations,application.ID) {
				<tr><td data-label="Revision">#{ formatJobID(generation.DesiredRevision) }</td><td data-label="Status">@statusPill(generation.Status)</td><td data-label="Endpoint">127.0.0.1:{ formatPlanLimit(generation.EndpointPort) }</td><td data-label="Health">{ generation.HealthMessage }</td><td data-label="Started">{ formatTime(generation.StartedAt) }</td></tr>
			}
		</tbody></table></div>
	</section>
	<section class="np-panel" id="container-logs" data-np-container-logs data-log-url={ "/sites/"+formatJobID(item.ID)+"/containers/"+formatJobID(application.ID)+"/logs" }>
		<div class="np-panel-title"><div><h2>Logs</h2><span class="np-muted">Newest 200 lines · 256 KiB response limit</span></div><button type="button" class="np-secondary-button" data-np-container-log-refresh>Refresh</button></div>
		<pre class="np-log-output" data-np-container-log-output aria-live="polite">Loading container logs…</pre>
		<p class="np-form-help" data-np-container-log-truncated hidden>Older output was omitted to keep this read bounded.</p>
	</section>
	<section class="np-panel" id="container-activity"><div class="np-panel-title"><h2>Activity</h2></div><p class="np-muted">Lifecycle actions are recorded in the provider audit trail.</p></section>
}

templ containerActionForm(subscriptionID int64, siteID int64, applicationID int64, action string, label string, view WorkspaceView) {
	<form method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscriptionID)+"/applications/"+formatJobID(applicationID)+"/action") }>@csrfInput(view)<input type="hidden" name="site_id" value={ formatJobID(siteID) }/><input type="hidden" name="action" value={ action }/><button type="submit" class="np-secondary-button">{ label }</button></form>
}

templ domainStaging(item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	@pageSectionHead("Staging", "Copy files and paired databases between domains in this subscription with an automatic rollback point.")
	if policy, found := policyForSite(data.SubscriptionServices.SitePolicies,item.ID); !found {
		<p class="np-gate is-blocked">Staging policy is unavailable.</p>
	} else if !policy.Permissions.Staging {
		<p class="np-gate">Staging is disabled by this subscription policy.</p>
	} else if len(stagingTargets(data.Sites,item)) == 0 {
		<p class="np-empty">Create a second domain in this subscription before using staging.</p>
	} else {
		<section class="np-panel">
			<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/staging") }>
				@csrfInput(view)
				<div class="np-form-grid">
					<label>Target domain<select name="target_site_id" required>
						for _, target := range stagingTargets(data.Sites,item) {
							<option value={ formatJobID(target.ID) }>{ target.Domain }</option>
						}
					</select></label>
					<label>Operation<select name="direction"><option value="copy_to_staging">Copy this domain to target</option><option value="promote">Promote this domain to target</option></select></label>
					<label class="np-check"><input type="checkbox" name="include_database" value="true"/>Copy paired MariaDB databases</label>
					<label>Promotion confirmation<input name="confirm" autocomplete="off" placeholder="Type promote when promoting"/></label>
				</div>
				<p class="np-form-help">Database copy requires matching source and target database counts. Paths and database names are derived by Nakpanel; the browser never submits them.</p>
				<button type="submit">Queue staging operation</button>
			</form>
		</section>
	}
	<section class="np-panel"><div class="np-panel-title"><h2>Operation history</h2></div>
		<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Flow</th><th>Mode</th><th>State</th><th>Copied</th><th>Created</th></tr></thead><tbody>
			for _, operation := range stagingForSite(data.SubscriptionServices.Staging,item.ID) {
				<tr><td data-label="Flow"><strong>{ operation.SourceDomain }</strong><small>to { operation.TargetDomain }</small></td><td data-label="Mode">{ operation.Direction }</td><td data-label="State">@statusPill(operation.Status)
					if operation.LastError != "" {
						<small class="np-error">{ operation.LastError }</small>
					}
				</td><td data-label="Copied">{ formatBytes(operation.CopiedBytes) }</td><td data-label="Created">{ formatTime(operation.CreatedAt) }</td></tr>
			}
		</tbody></table></div>
	</section>
}

templ domainValkey(item dashboard.Site, subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	@pageSectionHead("Valkey cache", "One disposable cache instance shared by every site in this subscription.")
	@subscriptionCachePanel(subscription,data,view,item.ID)
}

templ pageSectionHead(title string, copy string) {
	<div class="np-section-heading"><div><h2>{ title }</h2><p>{ copy }</p></div></div>
}

templ domainNavigation(siteID int64, current string, view WorkspaceView, canUseFileManager bool) {
	<nav class="np-domain-tabs np-domain-primary-nav" aria-label="Domain workspace">
		<div class="np-domain-primary-links">
			@domainTab(siteID, "overview", "Overview", current, view)
			<a class={ domainHostingActive(current) } href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(siteID)+"/web-server")) } aria-current={ ariaCurrent(domainHostingActive(current)) }>Hosting</a>
			@domainTab(siteID, "php", "PHP", current, view)
			@domainTab(siteID, "mail", "Mail", current, view)
			@domainTab(siteID, "dns", "DNS", current, view)
			@domainTab(siteID, "ssl", "SSL/TLS", current, view)
			<details class="np-domain-more">
				<summary class={ domainMoreActive(current) }>{ domainToolLabel(current) } @icon("chevron-right")</summary>
				<div class="np-domain-more-menu">
					<strong>Files &amp; Access</strong>
					if canUseFileManager {
						<a class={ domainTabActive(current,"files") } href={ templ.SafeURL(fileBasePath(view,siteID)) }>File Manager</a>
					}
					@domainDeepTab(siteID,"access","FTP & SFTP",current,view)
					<strong>Data &amp; Recovery</strong>
					@domainTab(siteID,"databases","Databases",current,view)
					@domainTab(siteID,"backups","Backups",current,view)
					<strong>Developer Tools</strong>
					@domainDeepTab(siteID,"logs","Logs",current,view)
					@domainDeepTab(siteID,"scheduled-tasks","Scheduled Tasks",current,view)
					@domainDeepTab(siteID,"statistics","Statistics",current,view)
					@domainDeepTab(siteID,"git","Git",current,view)
					<strong>Applications</strong>
					@domainDeepTab(siteID,"applications","Applications",current,view)
					@domainDeepTab(siteID,"containers","Containers",current,view)
					@domainDeepTab(siteID,"staging","Staging",current,view)
					@domainDeepTab(siteID,"redis","Valkey Cache",current,view)
				</div>
			</details>
		</div>
		<button type="button" class="np-domain-tools-trigger" data-np-dialog-open={ "domain-tools-"+formatJobID(siteID) }>@icon("layout-grid")<span>Domain tools</span><strong>{ domainCurrentLabel(current) }</strong>@icon("chevron-down")</button>
	</nav>
	<dialog class="np-dialog np-domain-tools-dialog" id={ "domain-tools-"+formatJobID(siteID) } data-np-dialog>
		<div class="np-dialog-head"><div><h2>Domain tools</h2><p>Hosting, security, data, and developer workspaces.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div>
		<div class="np-domain-tools-drawer">
			@domainTab(siteID,"overview","Overview",current,view)
			<a class={ domainHostingActive(current) } href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(siteID)+"/web-server")) }>Hosting</a>
			@domainTab(siteID,"php","PHP",current,view)
			@domainTab(siteID,"mail","Mail",current,view)
			@domainTab(siteID,"dns","DNS",current,view)
			@domainTab(siteID,"ssl","SSL/TLS",current,view)
			if canUseFileManager {
				<a class={ domainTabActive(current,"files") } href={ templ.SafeURL(fileBasePath(view,siteID)) }>File Manager</a>
			}
			@domainDeepTab(siteID,"access","FTP & SFTP",current,view)
			@domainTab(siteID,"databases","Databases",current,view)
			@domainTab(siteID,"backups","Backups",current,view)
			@domainDeepTab(siteID,"logs","Logs",current,view)
			@domainDeepTab(siteID,"scheduled-tasks","Scheduled Tasks",current,view)
			@domainDeepTab(siteID,"statistics","Statistics",current,view)
			@domainDeepTab(siteID,"git","Git",current,view)
			@domainDeepTab(siteID,"applications","Applications",current,view)
			@domainDeepTab(siteID,"containers","Containers",current,view)
			@domainDeepTab(siteID,"staging","Staging",current,view)
			@domainDeepTab(siteID,"redis","Valkey Cache",current,view)
		</div>
	</dialog>
}

templ domainTab(siteID int64, tab string, label string, current string, view WorkspaceView) {
	<a class={ domainTabActive(current,tab) } href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(siteID))+"?tab="+tab) } aria-current={ ariaCurrent(domainTabActive(current,tab)) }>{ label }</a>
}
templ domainDeepTab(siteID int64, tab string, label string, current string, view WorkspaceView) {
	<a class={ domainTabActive(current,tab) } href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(siteID)+"/"+tab)) } aria-current={ ariaCurrent(domainTabActive(current,tab)) }>{ label }</a>
}
templ domainTool(siteID int64, tab string, iconName string, title string, copy string, view WorkspaceView) {
	<a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(siteID))+"?tab="+tab) }>@icon(iconName)<strong>{ title }</strong><span>{ copy }</span></a>
}
templ domainDeepTool(siteID int64, route string, iconName string, title string, copy string, view WorkspaceView) {
	<a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(siteID)+"/"+route)) }>@icon(iconName)<strong>{ title }</strong><span>{ copy }</span></a>
}

templ routedFileManager(view WorkspaceView) {
	if data := view.FileManager; data != nil {
		@pageHead("Website files", "File Manager", data.Domain + " · public_html") {
			<a class="np-secondary-link" href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(data.SiteID))) }>Back to website</a>
		}
		<div class="np-domain-commandbar">
			<div><span class="np-status-pill ok">active</span><span>{ data.Domain }</span><span>public_html</span></div>
			<a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(data.SiteID))) }>@icon("arrow-left")<span>Website overview</span></a>
		</div>
		@domainNavigation(data.SiteID,"files",view,true)
		<section class="np-file-manager" data-np-file-manager data-np-file-unavailable?={ data.Error != "" }>
			<div class="np-file-toolbar">
				<div class="np-file-toolbar-actions">
					<button type="button" class="np-toolbar-primary" data-np-file-upload-trigger="files" aria-label="Upload files" disabled?={ data.Error != "" }>@icon("upload")<span>Upload files</span></button>
					<button type="button" class="np-toolbar-button" data-np-file-upload-trigger="folder" aria-label="Upload folder" title="Upload a folder" disabled?={ data.Error != "" }>@icon("folder-up")<span>Upload folder</span></button>
					<button type="button" class="np-toolbar-button" data-np-dialog-open="file-create-dialog" aria-label="Create file or folder" disabled?={ data.Error != "" }>@icon("plus")<span>New</span></button>
					<button type="button" class="np-toolbar-button" data-np-file-dialog-open="file-copy-dialog" aria-label="Copy selected items" disabled>@icon("copy")<span>Copy</span></button>
					<button type="button" class="np-toolbar-button" data-np-file-dialog-open="file-move-dialog" aria-label="Move selected items" disabled>@icon("move")<span>Move</span></button>
					<button type="button" class="np-toolbar-button" data-np-file-dialog-open="file-archive-dialog" aria-label="Archive selected items" disabled>@icon("archive")<span>Archive</span></button>
					<button type="button" class="np-toolbar-button np-file-delete-button" data-np-file-dialog-open="file-delete-dialog" disabled title="Delete selected items">@icon("trash")</button>
				</div>
				<form class="np-file-search" method="get" action={ templ.SafeURL(fileBasePath(view,data.SiteID)) }>
					if data.Path != "" {
						<input type="hidden" name="path" value={ data.Path }/>
					}
					@icon("search")<input type="search" name="q" value={ data.Query } placeholder="Search filenames" aria-label="Search filenames" disabled?={ data.Error != "" }/><button type="submit" class="np-sr-only" disabled?={ data.Error != "" }>Search</button>
				</form>
			</div>
			<form class="np-file-upload-form" action={ templ.SafeURL(fileActionPath(view,data.SiteID,"upload",data.Path)) } method="post" enctype="multipart/form-data" data-np-file-upload-form hidden>
				<input type="file" name="files" multiple data-np-file-input="files"/>
				<input type="file" name="folder" multiple webkitdirectory directory data-np-file-input="folder"/>
			</form>
			<div class="np-file-upload-progress" data-np-file-upload-progress hidden><span data-np-file-upload-bar></span><div class="np-file-upload-summary"><strong>Uploading files</strong><small data-np-file-upload-label></small></div><div class="np-file-upload-items" data-np-file-upload-items></div></div>
			<div class="np-file-breadcrumbs" aria-label="Current folder">
				for index, crumb := range fileCrumbs(data.Path) {
					if index > 0 {
						@icon("chevron-right")
					}
					<a href={ templ.SafeURL(fileManagerPath(view,data.SiteID,crumb.Path)) }>{ crumb.Label }</a>
				}
			</div>
			<div class="np-file-layout">
				<aside class="np-file-tree" data-np-file-tree>
					<div class="np-file-tree-head"><strong>Folders</strong><button type="button" class="np-icon-button" data-np-file-tree-close title="Close folders">@icon("x")</button></div>
					<a class="is-root" href={ templ.SafeURL(fileManagerPath(view,data.SiteID,"")) }>@icon("folder-open")<span>public_html</span></a>
					if data.Path != "" {
						<a href={ templ.SafeURL(fileManagerPath(view,data.SiteID,fileParent(data.Path))) }>@icon("corner-up-left")<span>Parent folder</span></a>
					}
					for _, item := range data.Directories {
						<a href={ templ.SafeURL(fileManagerPath(view,data.SiteID,item.Path)) }>@icon("folder")<span>{ item.Name }</span></a>
					}
				</aside>
				<div class="np-file-content">
					<div class="np-file-mobile-head"><button type="button" class="np-toolbar-button" data-np-file-tree-open>@icon("folders")<span>Folders</span></button><span>{ formatPlanLimit(data.Total) } items</span></div>
					if data.Error != "" {
						<div class="np-file-state np-file-state-error">@icon("triangle-alert")<div><strong>File Manager unavailable</strong><p>{ data.Error }</p></div></div>
					} else if len(data.Entries) == 0 {
						<div class="np-file-state">@icon("folder-open")<div><strong>{ fileEmptyTitle(data.Query) }</strong><p>{ fileEmptyCopy(data.Query) }</p></div></div>
					} else {
						<div class="np-file-table-wrap"><table class="np-file-table"><thead><tr><th class="np-file-check"><input type="checkbox" aria-label="Select all files" data-np-file-select-all/></th><th>@fileSortLink(view,data,"name","Name")</th><th>@fileSortLink(view,data,"modified","Modified")</th><th>@fileSortLink(view,data,"size","Size")</th><th>Permissions</th><th>Owner</th><th>Group</th><th><span class="np-sr-only">Actions</span></th></tr></thead><tbody>
							for _, item := range data.Entries {
								<tr data-np-file-row><td class="np-file-check"><input type="checkbox" name="paths" value={ item.Path } aria-label={ "Select "+item.Name } data-np-file-select/></td><td data-label="Name"><span class={ "np-file-kind np-file-kind-"+string(item.Kind) }>@icon(fileKindIcon(item))</span>
									if item.Kind == types.FileKindDirectory {
										<a href={ templ.SafeURL(fileManagerPath(view,data.SiteID,item.Path)) }><strong>{ item.Name }</strong></a>
									} else {
										<strong>{ item.Name }</strong>
									}
								</td><td data-label="Modified">{ formatTime(item.ModifiedAt) }</td><td data-label="Size">
									if item.Kind == types.FileKindDirectory {
										<span>—</span>
									} else {
										<span>{ formatBytes(item.Size) }</span>
									}
								</td><td data-label="Permissions"><code>{ fileMode(item.Mode) }</code></td><td data-label="Owner">{ item.Owner }</td><td data-label="Group">{ item.Group }</td><td class="np-file-row-actions"><details><summary aria-label={ "Actions for "+item.Name }>@icon("ellipsis")</summary><div class="np-file-menu">
									if item.Editable {
										<a href={ templ.SafeURL(fileEntryPath(view,data.SiteID,"edit",item.Path)) }>@icon("file-pen")<span>Edit</span></a>
									}
									if item.Downloadable {
										<a href={ templ.SafeURL(fileEntryPath(view,data.SiteID,"download",item.Path)) }>@icon("download")<span>Download</span></a>
									}
									if item.Renamable {
										<button type="button" data-np-file-row-action="rename" data-path={ item.Path } data-name={ item.Name }>@icon("pencil")<span>Rename</span></button>
									}
									if item.Chmod {
										<button type="button" data-np-file-row-action="permissions" data-path={ item.Path } data-mode={ fileMode(item.Mode) }>@icon("shield-check")<span>Permissions</span></button>
									}
									if item.Archive {
										<button type="button" data-np-file-row-action="extract" data-path={ item.Path }>@icon("package-open")<span>Extract</span></button>
									}
									if item.Deletable {
										<form method="post" action={ templ.SafeURL(fileBasePath(view,data.SiteID)+"/delete") }>@csrfInput(view)<input type="hidden" name="path" value={ data.Path }/><input type="hidden" name="paths" value={ item.Path }/><button type="submit" class="is-danger" data-np-confirm={ "Delete "+item.Name+" permanently?" }>@icon("trash")<span>Delete</span></button></form>
									}
								</div></details></td></tr>
							}
						</tbody></table></div>
						if filePageCount(data.Total,data.PerPage) > 1 {
							<nav class="np-file-pagination" aria-label="File pages"><span>Page { formatPlanLimit(data.Page) } of { formatPlanLimit(filePageCount(data.Total,data.PerPage)) }</span><div>
								if data.Page > 1 {
									<a class="np-secondary-link" href={ templ.SafeURL(filePagePath(view,data,data.Page-1)) }>Previous</a>
								}
								if data.Page < filePageCount(data.Total,data.PerPage) {
									<a class="np-secondary-link" href={ templ.SafeURL(filePagePath(view,data,data.Page+1)) }>Next</a>
								}
							</div></nav>
						}
					}
				</div>
			</div>
			<div class="np-file-foot"><span>Upload limit { uploadLimitLabel(data.UploadMaxBytes) }</span><span>Files are owned by { data.Username }</span></div>
			@fileManagerDialogs(view,data)
		</section>
	}
}

templ fileSortLink(view WorkspaceView, data *FileManagerView, field string, label string) {
	<a class={ fileSortClass(data,field) } href={ templ.SafeURL(fileSortPath(view,data,field)) }>{ label }@icon("chevron-right")</a>
}

templ fileManagerDialogs(view WorkspaceView, data *FileManagerView) {
	<dialog class="np-dialog np-file-dialog" id="file-create-dialog" data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">File Manager</span><h2>Create an item</h2></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL(fileBasePath(view,data.SiteID)+"/create") }>@csrfInput(view)<input type="hidden" name="path" value={ data.Path }/><label>Name<input name="name" required maxlength="255"/></label><label>Type<select name="kind"><option value="file">File</option><option value="directory">Folder</option></select></label><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Create</button></div></form></dialog>
	@fileBatchDialog(view,data,"file-copy-dialog","Copy selected items","copy","Destination folder","Copy")
	@fileBatchDialog(view,data,"file-move-dialog","Move selected items","move","Destination folder","Move")
	<dialog class="np-dialog np-file-dialog" id="file-archive-dialog" data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">File Manager</span><h2>Create ZIP archive</h2></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL(fileBasePath(view,data.SiteID)+"/archive") } data-np-file-batch-form>@csrfInput(view)<input type="hidden" name="path" value={ data.Path }/><div data-np-file-selected-inputs></div><label>Archive name<input name="name" value="archive.zip" required/></label><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Create archive</button></div></form></dialog>
	<dialog class="np-dialog np-file-dialog" id="file-delete-dialog" data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">Permanent action</span><h2>Delete selected items?</h2><p>This removes files and folders immediately.</p></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL(fileBasePath(view,data.SiteID)+"/delete") } data-np-file-batch-form>@csrfInput(view)<input type="hidden" name="path" value={ data.Path }/><div data-np-file-selected-inputs></div><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit" class="np-danger-button">Delete</button></div></form></dialog>
	<dialog class="np-dialog np-file-dialog" id="file-rename-dialog" data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">File Manager</span><h2>Rename item</h2></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL(fileBasePath(view,data.SiteID)+"/rename") }>@csrfInput(view)<input type="hidden" name="path" value={ data.Path }/><input type="hidden" name="file_path" data-np-row-path/><label>New name<input name="name" data-np-row-name required/></label><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Rename</button></div></form></dialog>
	<dialog class="np-dialog np-file-dialog" id="file-permissions-dialog" data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">Linux permissions</span><h2>Change permissions</h2><p>Use an octal mode between 0000 and 0777.</p></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL(fileBasePath(view,data.SiteID)+"/permissions") }>@csrfInput(view)<input type="hidden" name="path" value={ data.Path }/><input type="hidden" name="file_path" data-np-row-path/><label>Mode<input name="mode" inputmode="numeric" pattern="[0-7]{3,4}" data-np-row-mode required/></label><label class="np-check"><input type="checkbox" name="recursive" value="true"/>Apply recursively to folder contents</label><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Save permissions</button></div></form></dialog>
	<dialog class="np-dialog np-file-dialog" id="file-extract-dialog" data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">Archive</span><h2>Extract files</h2></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL(fileBasePath(view,data.SiteID)+"/extract") }>@csrfInput(view)<input type="hidden" name="path" value={ data.Path }/><input type="hidden" name="file_path" data-np-row-path/><label>Destination folder<input name="destination" value={ data.Path }/></label><label class="np-check"><input type="checkbox" name="overwrite" value="true"/>Replace existing files</label><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Extract</button></div></form></dialog>
}

templ fileBatchDialog(view WorkspaceView, data *FileManagerView, id string, title string, action string, label string, submit string) {
	<dialog class="np-dialog np-file-dialog" id={ id } data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">File Manager</span><h2>{ title }</h2></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL(fileBasePath(view,data.SiteID)+"/"+action) } data-np-file-batch-form>@csrfInput(view)<input type="hidden" name="path" value={ data.Path }/><div data-np-file-selected-inputs></div><label>{ label }<input name="destination" value={ data.Path }/></label><label class="np-check"><input type="checkbox" name="overwrite" value="true"/>Replace existing items</label><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">{ submit }</button></div></form></dialog>
}

templ routedFileEditor(view WorkspaceView) {
	if data := view.FileEditor; data != nil {
		@pageHead("File Manager", data.Name, data.Domain + " · public_html/" + data.Path) {
			<a class="np-secondary-link" href={ templ.SafeURL(fileManagerPath(view,data.SiteID,fileParent(data.Path))) }>Back to files</a>
		}
		<div class="np-domain-commandbar">
			<div><span class="np-status-pill ok">active</span><span>{ data.Domain }</span><span>Editing public_html/{ data.Path }</span></div>
			<a href={ templ.SafeURL(fileManagerPath(view,data.SiteID,fileParent(data.Path))) }>@icon("arrow-left")<span>File Manager</span></a>
		</div>
		@domainNavigation(data.SiteID,"files",view,true)
		<form class="np-code-editor" method="post" action={ templ.SafeURL(fileBasePath(view,data.SiteID)+"/save") } data-np-editor-form>
			@csrfInput(view)<input type="hidden" name="path" value={ data.Path }/><input type="hidden" name="sha256" value={ data.SHA256 }/>
			<div class="np-editor-toolbar"><div>@icon("file-code")<strong>{ data.Name }</strong><code>{ fileMode(data.Mode) }</code></div><div><a class="np-secondary-link" href={ templ.SafeURL(fileEntryPath(view,data.SiteID,"download",data.Path)) }>@icon("download")<span>Download</span></a><button type="submit">@icon("save")<span>Save</span></button></div></div>
			<textarea name="content" spellcheck="false" data-np-code-editor>{ data.Content }</textarea>
		</form>
	}
}

templ domainDNS(user auth.SessionUser, item dashboard.Site, phase dashboard.Phase6Data, subscription types.SubscriptionSummary, actions DashboardActions, view WorkspaceView) {
	@pageSectionHead("DNS", "Authoritative records, inherited template state, SOA policy, and zone topology.")
	<section class="np-panel np-domain-settings np-domain-dns" data-np-dns-workspace>
		if user.Role!=auth.RoleAdmin && !subscription.AllowDNS {
			<p class="np-gate">DNS management is disabled by this subscription.</p>
		} else if zone, ok := dnsZoneForSiteWorkspace(phase.DNSZones,phase.DNSRecords,item); ok {
			<header class="np-domain-dns-head">
				<div><span class="np-kicker">{ dnsZoneRelationship(zone,item.ID) }</span><h2>{ item.Domain }</h2><p>Records are served from <strong>{ zone.Domain }</strong>.</p></div>
				<div class="np-domain-dns-actions">
					<button type="button" data-np-dialog-open={ "dns-record-dialog-"+formatJobID(item.ID) }>@icon("plus")<span>Add Record</span></button>
					<form method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/dns-template/preview") }>@csrfInput(view)<button type="submit" class="np-secondary-button">@icon("activity")<span>Apply DNS Template</span></button></form>
					<details class="np-dns-action-menu">
						<summary class="np-icon-button" title="More DNS zone actions">@icon("ellipsis")<span class="np-sr-only">More actions</span></summary>
						<div>
							<a href="#dns-zone-advanced">@icon("settings")<span>Advanced zone settings</span></a>
							<button type="button" data-np-dialog-open={ "dns-zone-authorization-"+formatJobID(item.ID) }>@icon("shield-check")<span>Authorize protected changes</span></button>
							<button type="button" class="is-danger" data-np-dialog-open={ "dns-zone-reset-"+formatJobID(item.ID) }>@icon("corner-up-left")<span>Reset zone</span></button>
						</div>
					</details>
				</div>
			</header>
			<div class="np-zone-summary">
				<span><strong>{ zone.Mode }</strong><small>zone mode</small></span>
				<span>@statusPill(zone.Status)<small>agent state</small></span>
				<span><strong>r{ formatJobID(zone.TemplateRevision) }</strong><small>template { zone.TemplateStatus }</small></span>
				<span><strong>{ formatJobID(zone.AppliedRevision) } / { formatJobID(zone.DesiredRevision) }</strong><small>applied / desired</small></span>
				<span><strong>{ formatJobID(zone.Serial) }</strong><small>SOA serial</small></span>
			</div>
			if zone.LastError != "" {
				<p class="np-gate is-blocked">{ zone.LastError }</p>
			}
			if preview := view.DNSPreview; preview != nil {
				<section class="np-dns-preview np-domain-dns-preview">
					<div class="np-settings-focus-head np-settings-subhead"><div><h3>Template preview</h3><p>Review changes for { zone.Domain }. Customer overrides and service records remain untouched.</p></div>@statusPill(preview.Status)</div>
					<dl class="np-dns-impact-summary" aria-label="Template impact">
						<div class="is-add"><dt>Add</dt><dd>{ formatPlanLimit(dnsSyncCount(preview,"added")) }</dd></div>
						<div class="is-update"><dt>Update</dt><dd>{ formatPlanLimit(dnsSyncCount(preview,"updated")) }</dd></div>
						<div class="is-remove"><dt>Remove</dt><dd>{ formatPlanLimit(dnsSyncCount(preview,"removed")) }</dd></div>
						<div class="is-preserve"><dt>Preserve</dt><dd>{ formatPlanLimit(dnsSyncCount(preview,"preserved")) }</dd></div>
						<div class="is-conflict"><dt>Conflict</dt><dd>{ formatPlanLimit(dnsSyncCount(preview,"conflicts")) }</dd></div>
					</dl>
					<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Zone</th><th>Outcome</th><th>Changes</th></tr></thead><tbody>
						for _, result := range preview.Items {
							<tr><td data-label="Zone">{ result.Domain }</td><td data-label="Outcome">@statusPill(result.Outcome)</td><td data-label="Changes">{ displayFallback(result.Detail,"No changes") }</td></tr>
						}
					</tbody></table></div>
					if preview.Status=="preview" {
						<form class="np-dns-apply-panel" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/dns-template/"+formatJobID(preview.ID)+"/apply") }>
							@csrfInput(view)<input type="hidden" name="preview_token" value={ preview.PreviewToken }/>
							<span class="np-dns-apply-copy"><strong>Apply exactly this preview</strong><small>Newer DNS changes make it stale.</small></span>
							<label>Typed confirmation<input name="confirmation" placeholder="APPLY DNS TEMPLATE" required autocomplete="off"/></label>
							<button type="submit">Apply preview</button>
						</form>
					}
				</section>
			}
			<div class="np-domain-filterbar">
				<label>@icon("search")<input type="search" placeholder="Search records" aria-label="Search DNS records" data-np-dns-search/></label>
				<select aria-label="Record type" data-np-dns-type><option value="">All record types</option><option>A</option><option>AAAA</option><option>CNAME</option><option>MX</option><option>TXT</option><option>NS</option><option>SRV</option><option>CAA</option><option>DS</option></select>
				<span class="np-dns-result-count" data-np-dns-result-count role="status" aria-live="polite">{ dnsRecordCountLabel(len(dnsRecordsForSiteZone(phase.DNSRecords,zone,item.ID))) }</span>
			</div>
			<div class="np-table-wrap"><table class="np-table np-domain-dns-table"><thead><tr><th>Host</th><th>Type</th><th>Value</th><th>TTL</th><th>Origin</th><th>Actions</th></tr></thead><tbody data-np-dns-rows>
				for _, record := range dnsRecordsForSiteZone(phase.DNSRecords,zone,item.ID) {
					<tr data-np-dns-row data-type={ record.Type } data-search={ record.Host+" "+record.Value+" "+dnsRecordOrigin(record) }>
						<td data-label="Host"><code>{ dnsDisplayHost(record,zone,item.Domain) }</code></td><td data-label="Type">{ record.Type }</td><td data-label="Value"><code>{ dnsRecordValue(record) }</code><span class="np-dns-record-mobile-meta"><span>TTL { formatPlanLimit(record.TTL) }</span><span class={ "np-dns-origin is-"+record.Origin }>{ dnsRecordOrigin(record) }</span></span></td><td class="np-dns-secondary-cell" data-label="TTL">{ formatPlanLimit(record.TTL) }</td><td class="np-dns-secondary-cell" data-label="Origin"><span class={ "np-dns-origin is-"+record.Origin }>{ dnsRecordOrigin(record) }</span></td>
						<td data-label="Actions"><div class="np-row-actions">
							if dnsRecordEditable(record) {
								<button type="button" class="np-icon-button" title="Edit DNS record" data-np-dialog-open={ "dns-record-edit-"+formatJobID(record.ID) }>@icon("settings")</button>
								if record.Origin=="template" && record.LocallyModified {
									<form method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/dns-records/"+formatJobID(record.ID)+"/restore") }>@csrfInput(view)<button class="np-icon-button" type="submit" title="Restore inherited template value">@icon("corner-up-left")</button></form>
								}
								<form method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/dns-records/"+formatJobID(record.ID)+"/delete") }>@csrfInput(view)<button class="np-icon-button" type="submit" title="Delete DNS record" data-np-confirm="Delete this DNS record?">@icon("x")</button></form>
							} else {
								<span class="np-dns-managed" title="System-managed record">@icon("shield-check")<span class="np-sr-only">System-managed record</span></span>
							}
						</div></td>
					</tr>
				}
			</tbody></table></div>
			<p class="np-dns-filter-empty" data-np-dns-filter-empty role="status" aria-live="polite" hidden>No DNS records match this search.</p>
			for _, record := range dnsRecordsForSiteZone(phase.DNSRecords,zone,item.ID) {
				if dnsRecordEditable(record) {
					@dnsRecordDialog(view,item.ID,item.Domain,zone,"dns-record-edit-"+formatJobID(record.ID),"Edit DNS record",record)
				}
			}
			<details class="np-dns-advanced-workspace" id="dns-zone-advanced">
				<summary><span>@icon("settings")</span><span><strong>Advanced zone settings</strong><small>Zone placement, authoritative mode, SOA, transfers, and reset.</small></span><span class="np-dns-advanced-state">{ zone.Mode } · { zone.TemplateStatus }</span>@icon("chevron-right")</summary>
				<div class="np-domain-dns-settings">
				<section>
					<header><div><h3>Zone placement</h3><p>Subdomains use the parent zone unless an independent authoritative child zone is selected.</p></div></header>
						if (zone.SiteID!=item.ID || zone.ParentZoneID>0) && user.Role==auth.RoleAdmin {
							<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/dns-zone/subdomain-mode") }>
								@csrfInput(view)<input type="hidden" name="expected_revision" value={ formatJobID(zone.DesiredRevision) }/>
								<fieldset class="np-dns-segmented"><legend>Subdomain DNS</legend>
									<label><input type="radio" name="subdomain_mode" value="parent" checked?={ zone.SiteID!=item.ID }/><span><strong>Use parent zone</strong><small>Manage records inside { zone.Domain }.</small></span></label>
									<label><input type="radio" name="subdomain_mode" value="separate" checked?={ zone.SiteID==item.ID }/><span><strong>Use separate zone</strong><small>Create an independent authoritative child zone.</small></span></label>
								</fieldset>
								<p class="np-dns-impact-note">@icon("activity")<span>Changing placement moves this domain's owned records and queues validated BIND convergence.</span></p>
								<button type="submit" class="np-secondary-button">Save placement</button>
							</form>
					} else if zone.SiteID!=item.ID || zone.ParentZoneID>0 {
						<p class="np-empty">Zone placement is controlled by the server administrator.</p>
					} else {
						<p class="np-empty">This is a standalone authoritative domain.</p>
					}
				</section>
				if zone.SiteID==item.ID {
					<section>
						<header><div><h3>Authoritative mode</h3><p>Primary zones are rendered locally. Secondary zones transfer from allowlisted upstream IP addresses.</p></div></header>
						<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/dns-zone/mode") }>
							@csrfInput(view)<input type="hidden" name="expected_revision" value={ formatJobID(zone.DesiredRevision) }/>
							<label>Mode<select name="mode"><option value="primary" selected?={ zone.Mode=="primary" }>Primary</option><option value="secondary" selected?={ zone.Mode=="secondary" }>Secondary</option><option value="disabled" selected?={ zone.Mode=="disabled" }>Disabled</option></select></label>
							<label>Upstream primary IPs<textarea name="upstream_primaries" rows="2">{ zone.UpstreamPrimaries }</textarea></label><button type="submit" class="np-secondary-button">Save mode</button>
						</form>
					</section>
					<section>
						<header><div><h3>SOA and transfers</h3><p>Override this zone or continue inheriting the global template.</p></div></header>
						<form class="np-form np-dns-settings-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/dns-zone/soa") }>
							@csrfInput(view)<input type="hidden" name="expected_revision" value={ formatJobID(zone.DesiredRevision) }/>
							<label class="np-check np-dns-wide"><input type="checkbox" name="inherit_soa" value="true"/>Reset SOA and transfer restrictions to the global template</label>
							<label>Primary nameserver<input name="primary_nameserver" value={ zone.SOA.PrimaryNameserver } required/></label>
							<label>Responsible mailbox<input name="responsible_mailbox" value={ zone.SOA.ResponsibleMailbox } required/></label>
							<label>Serial format<select name="serial_format"><option value="unix" selected?={ zone.SOA.SerialFormat=="unix" }>Unix monotonic</option><option value="date-counter" selected?={ zone.SOA.SerialFormat=="date-counter" }>Date and counter</option></select></label>
							<label>Default TTL<input type="number" name="default_ttl" min="60" max="86400" value={ formatPlanLimit(zone.SOA.DefaultTTL) } required/></label>
							<label>Refresh<input type="number" name="refresh_seconds" min="300" max="86400" value={ formatPlanLimit(zone.SOA.RefreshSeconds) } required/></label>
							<label>Retry<input type="number" name="retry_seconds" min="60" max="86400" value={ formatPlanLimit(zone.SOA.RetrySeconds) } required/></label>
							<label>Expire<input type="number" name="expire_seconds" min="86400" max="2419200" value={ formatPlanLimit(zone.SOA.ExpireSeconds) } required/></label>
							<label>Negative cache TTL<input type="number" name="minimum_ttl" min="60" max="86400" value={ formatPlanLimit(zone.SOA.MinimumTTL) } required/></label>
							<label class="np-dns-wide">Transfer CIDRs<textarea name="transfer_cidrs" rows="2">{ zone.TransferCIDRs }</textarea></label>
							<div class="np-dns-wide"><button type="submit" class="np-secondary-button">Save SOA policy</button></div>
						</form>
					</section>
				}
				</div>
				<div class="np-domain-dns-reset"><div><strong>Reset this zone</strong><p>System-managed mail and security records remain. Custom records owned by this domain are removed after typed confirmation.</p></div><button type="button" class="np-danger-button" data-np-dialog-open={ "dns-zone-reset-"+formatJobID(item.ID) }>Reset zone</button></div>
			</details>
			@dnsRecordDialog(view,item.ID,item.Domain,zone,"dns-record-dialog-"+formatJobID(item.ID),"Add DNS record",types.DNSRecord{Host:"@",TTL:3600})
			<dialog class="np-dialog np-dns-authorization-dialog" id={ "dns-zone-authorization-"+formatJobID(item.ID) } data-np-dialog aria-labelledby={ "dns-zone-authorization-title-"+formatJobID(item.ID) }><form method="dialog" class="np-dialog-close"><button aria-label="Close">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">Protected DNS controls</span><h2 id={ "dns-zone-authorization-title-"+formatJobID(item.ID) }>Authorize zone changes</h2><p>Zone placement, mode, SOA, transfer, template apply, and reset actions require a recent password confirmation.</p></div><form class="np-settings-reauth np-dialog-form" method="post" action="/tools-settings/reauthenticate" data-np-reauth-form>@csrfInput(view)<label><span>Account password</span><input type="password" name="password" autocomplete="current-password" required/></label><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Authorize for 10 minutes</button></div><p class="np-notice" data-np-reauth-status role="status" aria-live="polite" hidden></p></form></dialog>
			<dialog class="np-dialog" id={ "dns-zone-reset-"+formatJobID(item.ID) } data-np-dialog aria-labelledby={ "dns-zone-reset-title-"+formatJobID(item.ID) }><form method="dialog" class="np-dialog-close"><button aria-label="Close">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">Protected DNS action</span><h2 id={ "dns-zone-reset-title-"+formatJobID(item.ID) }>Reset { item.Domain }</h2><p>Type the authoritative zone name to confirm.</p></div><form class="np-form np-dialog-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/dns-template/reset") }>@csrfInput(view)<label>Zone name<input name="confirmation" placeholder={ zone.Domain } required autocomplete="off"/></label><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit" class="np-danger-button">Reset zone</button></div></form></dialog>
		} else {
			<div class="np-domain-dns-empty"><span>@icon("network")</span><div><h2>No authoritative zone</h2><p>Initialize DNS to instantiate the current global template for this domain.</p></div></div>
			<form class="np-form np-action-form" method="post" action="/dns">@csrfInput(view)<input type="hidden" name="domain" value={ item.Domain }/><input type="hidden" name="site_id" value={ formatJobID(item.ID) }/><label>Server IPv4 address<input name="address" required placeholder="192.0.2.10"/></label><button type="submit">Initialize DNS zone</button></form>
		}
	</section>
}

templ dnsRecordDialog(view WorkspaceView, siteID int64, siteDomain string, zone dashboard.DNSZone, id string, title string, record types.DNSRecord) {
	<dialog class="np-dialog" id={ id } data-np-dialog aria-labelledby={ id+"-title" }>
		<form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form>
		<div class="np-dialog-head"><span class="np-kicker">DNS record</span><h2 id={ id+"-title" }>{ title }</h2><p>The record is stored in { zone.Domain }.</p></div>
		<form class="np-form np-dialog-form" method="post" action={ templ.SafeURL("/sites/"+formatJobID(siteID)+"/dns-records") } data-np-dns-record-form>
			@csrfInput(view)<input type="hidden" name="record_id" value={ formatJobID(record.ID) }/>
			<label>Host<input name="host" value={ dnsDisplayHost(record,zone,siteDomain) } required/></label>
			<label>Type<select name="record_type"><option selected?={ record.Type=="A" }>A</option><option selected?={ record.Type=="AAAA" }>AAAA</option><option selected?={ record.Type=="CNAME" }>CNAME</option><option selected?={ record.Type=="MX" }>MX</option><option selected?={ record.Type=="TXT" }>TXT</option><option selected?={ record.Type=="NS" }>NS</option><option selected?={ record.Type=="SRV" }>SRV</option><option selected?={ record.Type=="CAA" }>CAA</option><option selected?={ record.Type=="DS" }>DS</option></select></label>
			<label>Value<input name="value" value={ record.Value } required/></label>
			<label data-np-dns-field="priority">Priority<input type="number" name="priority" min="0" max="65535" value={ formatPlanLimit(record.Priority) }/></label>
			<label data-np-dns-field="weight">Weight<input type="number" name="weight" min="0" max="65535" value={ formatPlanLimit(record.Weight) }/></label>
			<label data-np-dns-field="port">Port<input type="number" name="port" min="0" max="65535" value={ formatPlanLimit(record.Port) }/></label>
			<label>TTL<input type="number" name="ttl" min="60" max="86400" value={ formatPlanLimit(record.TTL) } required/></label>
			<div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Save record</button></div>
		</form>
	</dialog>
}

templ domainSSL(user auth.SessionUser, item dashboard.Site, subscription types.SubscriptionSummary, actions DashboardActions, view WorkspaceView) {
	@pageSectionHead("SSL/TLS", "Certificate identity, renewal, and HTTPS policy for this domain.")
	<section class={ "np-panel np-domain-settings np-tls-workspace "+tlsWorkspaceClass(item) }><div class="np-tls-hero"><span class="np-tls-hero-icon">@icon("shield-check")</span><div><span class="np-kicker">Connection security</span><h2>{ tlsWorkspaceTitle(item) }</h2><p>{ tlsWorkspaceCopy(item) }</p></div>@statusPill(formatTLSState(item))</div><dl class="np-facts"><div><dt>Issuer</dt><dd>{ displayFallback(item.TLSIssuer,"Not issued") }</dd></div><div><dt>Expires</dt><dd>{ formatNullableTime(item.TLSExpiresAt) }</dd></div><div><dt>Automatic renewal</dt><dd>{ yesNo(item.TLSAutoRenew) }</dd></div><div><dt>HTTPS redirect</dt><dd>{ yesNo(item.HTTPSRedirect) }</dd></div></dl>
		if item.TLSLastError != "" {
			<p class="np-gate is-blocked">{ item.TLSLastError }</p>
		}
		if user.Role!=auth.RoleAdmin && !subscription.AllowTLS {
			<p class="np-gate">SSL/TLS management is disabled by this subscription.</p>
		} else if actions.CanIssueCertificate {
			<div class="np-tls-actions"><form method="post" action="/certificates">@csrfInput(view)<input type="hidden" name="domain" value={ item.Domain }/><input type="hidden" name="site_id" value={ formatJobID(item.ID) }/><input type="hidden" name="issuer" value="acme"/><button type="submit">@icon("shield-check")<span>Issue with ACME</span></button></form><button type="button" class="np-secondary-button" data-np-dialog-open={ "custom-certificate-dialog-"+formatJobID(item.ID) }>@icon("upload")<span>Upload certificate</span></button></div>
			<form class="np-form np-action-form np-tls-renewal" method="post" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/tls-auto-renew") }>@csrfInput(view)<label class="np-check"><input type="checkbox" name="tls_auto_renew" value="true" checked?={ item.TLSAutoRenew }/>Renew ACME certificates automatically</label><button type="submit" class="np-secondary-button">Save renewal</button></form>
			<dialog class="np-dialog" id={ "custom-certificate-dialog-"+formatJobID(item.ID) } data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">SSL/TLS</span><h2>Install custom certificate</h2><p>The certificate must cover { item.Domain } and chain to a trusted system authority.</p></div><form class="np-form np-dialog-form" method="post" enctype="multipart/form-data" action={ templ.SafeURL("/sites/"+formatJobID(item.ID)+"/certificates/custom") }>@csrfInput(view)<label>Leaf certificate<input type="file" name="certificate" accept=".pem,.crt,.cer,application/x-pem-file" required/></label><label>Private key<input type="file" name="private_key" accept=".pem,.key,application/x-pem-file" required/></label><label>Intermediate chain <span class="np-muted">optional</span><input type="file" name="chain" accept=".pem,.crt,.cer,application/x-pem-file"/></label><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Install certificate</button></div></form></dialog>
		}
	</section>
}

templ domainDatabases(item dashboard.Site, subscription types.SubscriptionSummary, databases []dashboard.Database, actions DashboardActions, view WorkspaceView) {
	<section class="np-panel np-domain-settings np-domain-databases" data-np-domain-databases>
		<header class="np-domain-db-head">
			<div class="np-domain-db-title">
				<span class="np-settings-category-icon">@icon("database")</span>
				<div><h2>Databases</h2><p>MariaDB resources assigned to { item.Domain }.</p></div>
			</div>
			if actions.CanCreateDatabase && !databaseLimitReached(subscription) {
				<button type="button" data-np-dialog-open={ "database-create-dialog-"+formatJobID(item.ID) }>@icon("plus")<span>Create database</span></button>
			}
		</header>
		<dl class="np-domain-db-summary" aria-label="Database allocation summary">
			<div><dt>Domain databases</dt><dd>{ formatPlanLimit(len(databases)) }</dd><small>assigned here</small></div>
			<div><dt>Subscription usage</dt><dd>{ formatQuotaCompactCount(subscription.DatabasesUsed, subscription.MaxDatabases, true) }</dd><small>{ subscription.SubscriptionName }</small></div>
			<div><dt>Database server</dt><dd>MariaDB</dd><small>subscription-scoped principals</small></div>
		</dl>
		if databaseLimitReached(subscription) {
			<p class="np-gate is-blocked">This subscription has reached its database limit. Change or synchronize the service plan before creating another database.</p>
		}
		if len(databases) == 0 {
			<div class="np-domain-db-empty">
				<span>@icon("database")</span>
				<div><strong>No databases assigned</strong><p>Create a MariaDB database for this website when the application needs persistent data.</p></div>
			</div>
		} else {
			<div class="np-domain-db-list">
				for _, database := range databases {
					<article class="np-domain-db-row">
						<span class="np-domain-db-icon">@icon("database")</span>
						<div class="np-domain-db-identity"><strong>{ database.Name }</strong><small>{ databaseEngineLabel(database.Engine) }</small></div>
						<div class="np-domain-db-principal"><span>Database user</span><code>{ database.User }</code></div>
						<div class="np-domain-db-state">@statusPill(database.Status)
							if database.LastError != "" {
								<small class="np-error">{ database.LastError }</small>
							} else {
								<small>Provisioning state is current</small>
							}
						</div>
					</article>
				}
			</div>
		}
		if actions.CanCreateDatabase && !databaseLimitReached(subscription) {
			<dialog class="np-dialog np-domain-db-dialog" id={ "database-create-dialog-"+formatJobID(item.ID) } data-np-dialog aria-labelledby={ "database-create-title-"+formatJobID(item.ID) }>
				<form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form>
				<div class="np-dialog-head">
					<span class="np-kicker">Database provisioning</span>
					<h2 id={ "database-create-title-"+formatJobID(item.ID) }>Create database</h2>
					<p>The database will belong to { item.Domain } under { subscription.SubscriptionName }.</p>
				</div>
				<form class="np-form np-dialog-form np-domain-db-create-form" method="post" action="/databases">
					@csrfInput(view)
					<input type="hidden" name="subscription_id" value={ formatJobID(item.SubscriptionID) }/>
					<input type="hidden" name="site_id" value={ formatJobID(item.ID) }/>
					<input type="hidden" name="engine" value="mariadb"/>
					<label>Database name<input name="db_name" autocomplete="off" placeholder="application_db" required/></label>
					<label>Database user<input name="db_user" autocomplete="off" placeholder="application_user" required/></label>
					<p class="np-form-help">Names are validated by the server and provisioned through the privileged agent. Credentials remain write-only.</p>
					<div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Queue database</button></div>
				</form>
			</dialog>
		}
	</section>
}

templ domainBackups(user auth.SessionUser, item dashboard.Site, subscription types.SubscriptionSummary, backups []dashboard.Backup, actions DashboardActions, view WorkspaceView) {
	@pageSectionHead("Backups", "Create and restore recovery points for this website.")
	<section class="np-panel np-domain-settings"><div class="np-panel-title"><div><h2>Recovery points</h2><span class="np-muted">{ formatPlanLimit(len(backups)) } stored for { item.Domain }</span></div>
		if actions.CanUsePhase6 && (user.Role==auth.RoleAdmin || subscription.AllowBackups) {
			<button type="button" data-np-dialog-open={ "backup-create-dialog-"+formatJobID(item.ID) }>@icon("plus")<span>Create backup</span></button>
		}
	</div>
		<dl class="np-domain-db-summary"><div><dt>Recovery points</dt><dd>{ formatPlanLimit(len(backups)) }</dd><small>this website</small></div><div><dt>Subscription usage</dt><dd>{ formatQuotaCompactCount(subscription.BackupsUsed,subscription.MaxBackups,true) }</dd><small>{ formatBytes(subscription.BackupBytesUsed) } stored</small></div><div><dt>Retention</dt><dd>Plan policy</dd><small>preserved until pruned</small></div></dl>
		if user.Role!=auth.RoleAdmin && !subscription.AllowBackups {
			<p class="np-gate">Backup and restore are disabled by this subscription.</p>
		}
		if len(backups)==0 {
			<p class="np-empty">No backups for this domain.</p>
		} else {
			<div class="np-object-list">
				for _,backup:=range backups {
					<div class="np-object-row"><span class="np-object-icon">@icon("archive")</span><span><strong>{ formatTime(backup.CreatedAt) }</strong><small>{ formatBytes(backup.SizeBytes) }</small></span>@statusPill(backup.Status)
					if canRestoreBackup(backup) && (user.Role==auth.RoleAdmin || subscription.AllowBackups) {
						<button type="button" class="np-secondary-button" data-np-dialog-open={ "backup-restore-dialog-"+formatJobID(backup.ID) }>Restore</button>
						<dialog class="np-dialog" id={ "backup-restore-dialog-"+formatJobID(backup.ID) } data-np-dialog><div class="np-dialog-head"><div><h2>Restore this recovery point?</h2><p>The current files and database state for { item.Domain } may be replaced. A pre-restore safety point is recommended.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-form np-dialog-form" method="post" action="/restores">@csrfInput(view)<input type="hidden" name="backup_id" value={ formatJobID(backup.ID) }/><input type="hidden" name="site_id" value={ formatJobID(item.ID) }/><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit" class="np-danger-button">Queue restore</button></div></form></dialog>
					}
					</div>
				}
			</div>
		}
		if actions.CanUsePhase6 && (user.Role==auth.RoleAdmin || subscription.AllowBackups) {
			<dialog class="np-dialog" id={ "backup-create-dialog-"+formatJobID(item.ID) } data-np-dialog><div class="np-dialog-head"><div><h2>Create recovery point</h2><p>Queue a full website backup for { item.Domain }.</p></div><button type="button" class="np-icon-button" data-np-dialog-close title="Close">@icon("x")</button></div><form class="np-form np-dialog-form" method="post" action="/backups">@csrfInput(view)<input type="hidden" name="subscription_id" value={ formatJobID(item.SubscriptionID) }/><input type="hidden" name="site_id" value={ formatJobID(item.ID) }/><input type="hidden" name="domain" value={ item.Domain }/><p class="np-form-help">The backup counts against the subscription’s backup count and storage limits.</p><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Create backup</button></div></form></dialog>
		}
	</section>
}

templ routedDatabases(databases []dashboard.Database, subscriptions []types.SubscriptionSummary, actions DashboardActions, view WorkspaceView) {
	@pageHead("Hosting services", "Databases", "Create and track subscription-scoped MariaDB databases.") {}
	<section class="np-panel">@databasesSection(databases, nil, subscriptions, actions, view.CSRFToken)</section>
}

templ routedBackups(data dashboard.Phase6Data, subscriptions []types.SubscriptionSummary, actions DashboardActions, view WorkspaceView) {
	@pageHead("Hosting services", "Backups", "Create recovery points and restore owned website data.") {}
	<section class="np-panel">
		@phase6Tables(backupPhase6(data), view.CSRFToken)
		if actions.CanUsePhase6 {
			<form class="np-form np-action-form" method="post" action="/backups">
				@csrfInput(view)
				@subscriptionSelect(nil, subscriptions)
				<label>Domain<input name="domain" required/></label>
				<button type="submit">Create backup</button>
			</form>
		}
	</section>
}

templ routedDNS(data dashboard.Phase6Data, sites []dashboard.Site, actions DashboardActions, view WorkspaceView) {
	@pageHead("Hosting services", "DNS", "Manage authoritative zones for websites you control.") {}
	<section class="np-panel">
		if len(data.DNSZones) == 0 {
			<p class="np-empty">No DNS zones configured.</p>
		} else {
			<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Domain</th><th>Address</th><th>Status</th><th>Serial</th></tr></thead><tbody>
				for _, z := range data.DNSZones {
					<tr><td data-label="Domain">{ z.Domain }</td><td data-label="Address">{ z.Address }</td><td data-label="Status">{ z.Status }</td><td data-label="Serial">{ z.Serial }</td></tr>
				}
			</tbody></table></div>
		}
		if actions.CanUsePhase6 {
			<form class="np-form np-action-form" method="post" action="/dns">
				@csrfInput(view)
				<label>Domain<select name="domain">
					for _, item := range sites {
						<option value={ item.Domain }>{ item.Domain }</option>
					}
				</select></label>
				<label>IPv4 address<input name="address" required/></label><button type="submit">Configure DNS</button>
			</form>
		}
	</section>
}

templ routedCertificates(sites []dashboard.Site, actions DashboardActions, view WorkspaceView) {
	@pageHead("Hosting services", "SSL/TLS Certificates", "Review certificate state and secure an owned website.") {}
	<section class="np-panel">
		<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Domain</th><th>Status</th><th>Issuer</th><th>Expires</th></tr></thead><tbody>
			for _, item := range sites {
				<tr><td data-label="Domain"><a href={ templ.SafeURL("/sites/" + formatJobID(item.ID)) }>{ item.Domain }</a></td><td data-label="Status">{ item.TLSStatus }</td><td data-label="Issuer">{ item.TLSIssuer }</td><td data-label="Expires">{ formatNullableTime(item.TLSExpiresAt) }</td></tr>
			}
		</tbody></table></div>
		if actions.CanIssueCertificate {
			<form class="np-form np-action-form" method="post" action="/certificates">
				@csrfInput(view)
				<label>Domain<select name="domain">
					for _, item := range sites {
						<option value={ item.Domain }>{ item.Domain }</option>
					}
				</select></label>
				<label>Issuer<select name="issuer"><option value="local-self-signed">Local self-signed</option><option value="acme">ACME</option></select></label>
				<button type="submit">Issue certificate</button>
			</form>
		}
	</section>
}

templ routedActivity(data dashboard.Data, user auth.SessionUser, view WorkspaceView) {
	@pageHead("Operations", "Activity", "Provisioning jobs and administrator support actions in one timeline.") {}
	if len(data.UsageAlerts) > 0 {
		<section class="np-panel"><div class="np-panel-title"><h2>Resource alerts</h2><span class="np-muted">disk, traffic and synchronization</span></div><div class="np-object-list">
			for _, alert := range data.UsageAlerts {
				<div class="np-object-row"><span class="np-object-icon">@icon("activity")</span><span><strong>{ alert.Title }</strong><small>{ alert.Body } · { formatTime(alert.CreatedAt) }</small></span>@statusPill(alert.Severity)</div>
			}
		</div></section>
	}
	<section class="np-panel">@jobsSection(data.Jobs, data.JobLoadError, retryActions(user), view.CSRFToken)</section>
	if user.Role == auth.RoleAdmin {
		<section class="np-panel"><div class="np-panel-title"><h2>Audit events</h2></div><div class="np-table-wrap"><table class="np-table"><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Target</th></tr></thead><tbody>
			for _, event := range data.AuditEvents {
				<tr><td data-label="Time">{ formatTime(event.CreatedAt) }</td><td data-label="Actor">{ event.ActorEmail }</td><td data-label="Action">{ event.Action }</td><td data-label="Target">{ event.TargetType } { formatJobID(event.TargetID) }</td></tr>
			}
		</tbody></table></div></section>
	}
}

templ routedCustomers(data dashboard.Data, view WorkspaceView) {
	@pageHead("Account management", "Customers", "Customer profiles, login access and owned subscriptions.") {
		<button type="button" data-np-dialog-open="customer-dialog">Add customer</button>
	}
	<section class="np-panel">
		<form method="post" action="/customers/bulk-status" data-np-bulk-form>
			@csrfInput(view)
			<div class="np-bulk-bar"><label class="np-check"><input type="checkbox" data-np-bulk-all/>Select all</label><span data-np-bulk-count>0 selected</span><div><button type="submit" name="status" value="active" class="np-secondary-button">Activate</button><button type="submit" name="status" value="suspended" class="np-danger-button" data-np-confirm="Suspend the selected customers and their hosted websites?">Suspend</button></div></div>
			@customerRows(data.Customers,data.Subscriptions,data.Resellers)
		</form>
	</section>
}

templ routedCustomerDetail(data dashboard.Data, user auth.SessionUser, view WorkspaceView) {
	if customer, ok := customerByID(data.Customers, view.DetailID); ok {
		@pageHead("Customer", displayCustomer(customer), customer.Email) {
			<a class="np-secondary-link" href="/customers">Back to customers</a>
		}
		<div class="np-detail-grid">
			<section class="np-panel"><div class="np-panel-title"><h2>Profile</h2><span class={ "np-status-pill " + customerStatusClass(customer.Status) }>{ customer.Status }</span></div>
				<dl class="np-facts"><div><dt>Company</dt><dd>{ customer.Company }</dd></div><div><dt>Provider</dt><dd>{ providerName(customer,data.Resellers) }</dd></div><div><dt>Login</dt><dd>{ customerLoginMode(customer) }</dd></div><div><dt>Notes</dt><dd>{ customer.Notes }</dd></div></dl>
				<div class="np-panel-actions">
					<form method="post" action="/customers/status">@csrfInput(view)<input type="hidden" name="customer_id" value={ formatJobID(customer.ID) }/>
						if customer.Status == "active" {
							<input type="hidden" name="status" value="suspended"/><button type="submit" class="np-danger-button" data-np-confirm="Suspend this customer? Their panel access will be blocked.">Suspend</button>
						} else {
							<input type="hidden" name="status" value="active"/><button type="submit">Activate</button>
						}
					</form>
					if user.Role == auth.RoleAdmin {
						<form method="post" action={ templ.SafeURL("/support/customers/" + formatJobID(customer.ID) + "/enter") }>
							@csrfInput(view)
							<button type="submit" class="np-secondary-button">Open support view</button>
						</form>
					}
				</div>
				if user.Role == auth.RoleAdmin {
					<form class="np-form np-action-form" method="post" action="/customers/provider">
						@csrfInput(view)
						<input type="hidden" name="customer_id" value={ formatJobID(customer.ID) }/>
						<label>Provider<select name="reseller_id">
							<option value="">Administrator</option>
							for _, reseller := range data.Resellers {
								<option value={ formatJobID(reseller.ID) } selected?={ reseller.ID == customer.ResellerID }>{ reseller.DisplayName }</option>
							}
						</select></label>
						<button type="submit">Move customer</button>
					</form>
				}
			</section>
			<section class="np-panel"><div class="np-panel-title"><h2>Subscriptions</h2><a href={ templ.SafeURL("/subscriptions/new?customer_id=" + formatJobID(customer.ID)) }>Add subscription</a></div>@subscriptionUsageRows(subscriptionsForCustomer(data.Subscriptions, customer.ID), true, view)</section>
		</div>
		<section class="np-panel"><div class="np-panel-title"><h2>Websites</h2></div>@siteRows(sitesForCustomer(data.Sites, customer.ID), view)</section>
		<section class="np-panel"><div class="np-panel-title"><h2>Databases</h2></div>@databasesSection(databasesForCustomer(data.Databases, customer.ID), nil, subscriptionsForCustomer(data.Subscriptions, customer.ID), DashboardActions{}, view.CSRFToken)</section>
		if customer.LoginUserID == 0 {
			<section class="np-panel"><div class="np-panel-title"><h2>Panel login</h2></div><form class="np-form np-action-form" method="post" action="/customers/login">@csrfInput(view)<input type="hidden" name="customer_id" value={ formatJobID(customer.ID) }/><label>Email<input type="email" name="email" value={ customer.Email } required/></label><label>Temporary password<input type="password" name="password" autocomplete="new-password" required/></label><button type="submit">Enable login</button></form></section>
		}
	} else {
		<p class="np-empty">Customer not found.</p>
	}
}

templ routedSubscriptions(user auth.SessionUser, data dashboard.Data, view WorkspaceView) {
	@pageHead("Account management", "Subscriptions", "Manage subscribers, service plans and every hosted domain from one workspace.") {}
	<section class="np-panel np-subscriptions-workspace">
		<form method="post" action="/subscriptions/bulk-status" data-np-bulk-form data-np-subscription-bulk>
			@csrfInput(view)
			<div class="np-subscription-toolbar">
				if user.Role != auth.RoleClient {
					<div class="np-subscription-toolbar-primary">
						<a class="np-primary-link" href="/subscriptions/new">@icon("card")<span>Add subscription</span></a>
						<a class="np-secondary-link" href="/service-plans">Service Plans</a>
					</div>
				}
				<label class="np-subscription-search">@icon("search")<input type="search" placeholder="Search subscriptions" data-np-subscription-filter/></label>
			</div>
			if user.Role != auth.RoleClient {
				<div class="np-bulk-meta np-subscription-bulk-meta">
					<label class="np-check"><input type="checkbox" data-np-bulk-all/>Select all</label>
					<span data-np-bulk-count>0 selected</span>
					<span class="np-muted np-subscription-provider-warning" data-np-provider-warning></span>
					<details class="np-subscription-bulk-menu" data-np-bulk-menu data-enabled="false">
						<summary class="np-secondary-button" aria-disabled="true">@icon("settings")<span>Bulk actions</span>@icon("chevron-right")</summary>
						<div class="np-subscription-bulk-panel">
							<label><span>Service plan</span><select name="plan_id"><option value="">Choose plan</option>
								for _,plan:=range data.Plans {
									if plan.IsActive {
										<option value={ formatPlanID(plan.ID) }>{ plan.Name }</option>
									}
								}
							</select></label>
							<button type="submit" formaction="/subscriptions/bulk-plan" class="np-secondary-button" disabled>Change Plan</button>
							<label><span>Subscriber</span><select name="customer_id"><option value="">Choose subscriber</option>
								for _,customer:=range data.Customers {
									<option value={ formatJobID(customer.ID) }>{ displayCustomer(customer) }</option>
								}
							</select></label>
							<button type="submit" formaction="/subscriptions/bulk-subscriber" class="np-secondary-button" disabled>Change Subscriber</button>
							<div class="np-subscription-status-actions">
								<button type="submit" name="status" value="active" class="np-secondary-button" disabled>Activate</button>
								<button type="submit" name="status" value="suspended" class="np-danger-button" data-np-confirm="Suspend the selected subscriptions and websites?" disabled>Suspend</button>
							</div>
						</div>
					</details>
				</div>
			}
			<div class="np-table-wrap"><table class="np-table np-subscription-table"><thead><tr>
				if user.Role != auth.RoleClient {
					<th class="np-subscription-select-column"><span class="np-sr-only">Select</span></th>
				}
				<th class="np-subscription-identity-column">Subscription &amp; Subscriber</th>
				<th class="np-subscription-plan-column">Plan</th>
				<th class="np-subscription-usage-column">Usage</th>
				<th class="np-subscription-status-column">Status</th>
				<th class="np-subscription-action-column"><span class="np-sr-only">Action</span></th>
			</tr></thead><tbody>
				for _,subscription:=range data.Subscriptions {
					<tr data-np-subscription-row data-provider-id={ formatJobID(subscription.ResellerID) } data-customer-user-id={ formatJobID(subscription.CustomerUserID) } data-customer-id={ formatJobID(subscription.CustomerID) } data-plan-name={ subscription.PlanName } data-subscriber-email={ subscription.CustomerEmail }>
						if user.Role != auth.RoleClient {
							<td data-label="Select" class="np-select-cell np-subscription-select-cell"><input class="np-subscription-check" type="checkbox" name="subscription_id" value={ formatJobID(subscription.ID) } aria-label={ "Select "+subscription.SubscriptionName } data-np-bulk-check data-np-subscription-check/></td>
						}
						<td data-label="Subscription" class="np-subscription-identity-cell">
							<a class="np-subscription-name" href={ templ.SafeURL(workspacePath(view,"/subscriptions/"+formatJobID(subscription.ID))) }><strong>{ subscription.SubscriptionName }</strong><small>#{ formatJobID(subscription.ID) }</small></a>
							<span class="np-subscription-subscriber"><strong>{ subscription.CustomerName }</strong><small>{ subscription.CustomerEmail }</small></span>
						</td>
						<td data-label="Plan" class="np-subscription-plan-cell"><span class="np-plan-pill">{ subscription.PlanName }</span></td>
						<td data-label="Usage" class="np-subscription-usage-cell"><span><strong>{ formatQuotaCompactCount(subscription.SitesUsed,subscription.MaxSites,true) }</strong> domains</span><span><strong>{ formatQuotaCompactCount(subscription.DatabasesUsed,subscription.MaxDatabases,true) }</strong> databases</span></td>
						<td data-label="Status" class="np-subscription-status-cell">@statusPill(subscription.Status)</td>
						<td data-label="Action" class="np-subscription-action-cell"><a class="np-manage-button" href={ templ.SafeURL(workspacePath(view,"/subscriptions/"+formatJobID(subscription.ID))) }>Manage</a></td>
					</tr>
				}
			</tbody></table></div>
		</form>
	</section>
}

templ routedSubscriptionDetail(user auth.SessionUser, data dashboard.Data, actions DashboardActions, view WorkspaceView) {
	if subscription, ok := subscriptionByID(data.Subscriptions, view.DetailID); ok {
			@pageHead("Subscription", subscription.SubscriptionName, subscription.CustomerName + " · " + subscription.PlanName) {
			<a class="np-secondary-link" href={ templ.SafeURL(workspacePath(view,"/subscriptions")) }>Back to subscriptions</a>
			}
			<div class="np-subscription-overview"><div class="np-stat-grid np-routed-stats">@statCard("Domains", subscription.SitesUsed, "Limit " + formatPlanLimit(subscription.MaxSites))@statCard("Databases", subscription.DatabasesUsed, "Limit " + formatPlanLimit(subscription.MaxDatabases))@statCard("Backups", subscription.BackupsUsed, "Limit " + formatPlanLimit(subscription.MaxBackups))@statCard("Backup storage", int(subscription.BackupBytesUsed/1024/1024), "MB used")</div><aside class="np-subscription-account"><div><span>Subscriber</span><strong>{ subscription.CustomerName }</strong><small>{ subscription.CustomerEmail }</small></div><div><span>Service plan</span><strong>{ subscription.PlanName }</strong></div><div><span>Status</span>@statusPill(subscription.Status)</div></aside></div>
			<nav class="np-domain-tabs np-subscription-tabs" aria-label="Subscription workspace">
				<a class={ subscriptionTabClass(view.Tab,"overview") } href={ subscriptionTabPath(view,subscription.ID,"overview") }>Websites &amp; Domains</a>
				<a class={ subscriptionTabClass(view.Tab,"resources") } href={ subscriptionTabPath(view,subscription.ID,"resources") }>Resources<span class="np-sr-only"> Subscription settings</span></a>
				<a class={ subscriptionTabClass(view.Tab,"access") } href={ subscriptionTabPath(view,subscription.ID,"access") }>Account Access</a>
				<a class={ subscriptionTabClass(view.Tab,"cache") } href={ subscriptionTabPath(view,subscription.ID,"cache") }>Cache</a>
				<a class={ subscriptionTabClass(view.Tab,"mail") } href={ subscriptionTabPath(view,subscription.ID,"mail") }>Mail</a>
				<a class={ subscriptionTabClass(view.Tab,"tasks") } href={ subscriptionTabPath(view,subscription.ID,"tasks") }>Scheduled Tasks</a>
				<a class={ subscriptionTabClass(view.Tab,"applications") } href={ subscriptionTabPath(view,subscription.ID,"applications") }>Applications</a>
				<a class={ subscriptionTabClass(view.Tab,"backups") } href={ subscriptionTabPath(view,subscription.ID,"backups") }>Backups</a>
				<a class={ subscriptionTabClass(view.Tab,"activity") } href={ subscriptionTabPath(view,subscription.ID,"activity") }>Activity</a>
			</nav>
			if view.Tab == "overview" {
			<section class="np-panel np-subscription-domains"><div class="np-panel-title"><div><h2>Websites &amp; Domains</h2><span class="np-muted">Everything hosted under this subscription</span></div>
			if actions.CanCreateSite {
				<button type="button" data-np-dialog-open="site-dialog" data-np-subscription-id={ formatJobID(subscription.ID) }>@icon("globe")<span>Add Domain</span></button>
			}
		</div>
			if len(sitesForSubscription(data.Sites,subscription.ID))==0 {
				<p class="np-empty">No domains are hosted by this subscription.</p>
			} else {
				<div class="np-domain-blocks">
					for _,site:=range sitesForSubscription(data.Sites,subscription.ID) {
					@subscriptionDomainBlock(site,data,view)
					}
				</div>
				}
			</section>
			}
			if user.Role != auth.RoleClient && view.Tab == "resources" {
		<section class="np-panel np-subscription-settings"><div class="np-panel-title"><h2>Subscription settings</h2><span class={ "np-status-pill " + customerStatusClass(subscription.Status) }>{ subscription.Status }</span></div>
			<dl class="np-facts"><div><dt>Entitlements</dt><dd>{ subscription.SyncMode }</dd></div><div><dt>Synchronization</dt><dd>@statusPill(subscription.SyncStatus)</dd></div><div><dt>Plan revision</dt><dd>{ formatPlanLimit(subscription.PlanRevision) }</dd></div><div><dt>Provider</dt><dd>{ formatProviderID(subscription.ResellerID) }</dd></div></dl>
			if subscription.SyncError != "" {
				<p class="np-error">{ subscription.SyncError }</p>
			}
			<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/subscriptions/" + formatJobID(subscription.ID) + "/status") }>
				@csrfInput(view)
				<input type="hidden" name="customer_id" value={ formatJobID(subscription.CustomerID) }/><input type="hidden" name="subscription_name" value={ subscription.SubscriptionName }/><input type="hidden" name="sync_mode" value={ subscription.SyncMode }/>
				<label>Service plan<select name="plan_id">
					for _, plan := range data.Plans {
						if plan.IsActive || plan.ID == subscription.PlanID {
							<option value={ formatPlanID(plan.ID) } selected?={ plan.ID == subscription.PlanID }>{ plan.Name }</option>
						}
					}
				</select></label>
				<label>Status<select name="status"><option value="active" selected?={ subscription.Status == "active" }>Active</option><option value="suspended" selected?={ subscription.Status == "suspended" }>Suspended</option><option value="cancelled" selected?={ subscription.Status == "cancelled" }>Cancelled</option></select></label><button type="submit" data-np-confirm="Apply this plan or status change?">Save changes</button>
			</form>
			<div class="np-panel-actions">
				if subscription.SyncMode != "custom" {
					<form method="post" action={ templ.SafeURL("/subscriptions/" + formatJobID(subscription.ID) + "/sync") }>
						@csrfInput(view)
						<button type="submit" class="np-secondary-button">Synchronize now</button>
					</form>
				}
				if subscription.SyncMode == "synced" {
					<form method="post" action={ templ.SafeURL("/subscriptions/" + formatJobID(subscription.ID) + "/mode") }>
						@csrfInput(view)
						<input type="hidden" name="sync_mode" value="locked"/>
						<button type="submit" class="np-secondary-button">Lock customization</button>
					</form>
				} else if subscription.SyncMode == "locked" {
					<form method="post" action={ templ.SafeURL("/subscriptions/" + formatJobID(subscription.ID) + "/mode") }>
						@csrfInput(view)
						<input type="hidden" name="sync_mode" value="synced"/>
						<button type="submit">Return to plan sync</button>
					</form>
				}
			</div>
			if subscription.SyncMode != "custom" && len(addonsForProvider(data.AddonPlans, subscription.ResellerID)) > 0 {
				<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/subscriptions/" + formatJobID(subscription.ID) + "/addons") }>
					@csrfInput(view)
					<fieldset><legend>Add-on plans</legend>
						for _, addon := range addonsForProvider(data.AddonPlans, subscription.ResellerID) {
							<label class="np-check"><input type="checkbox" name="addon_id" value={ formatJobID(addon.ID) }/>{ addon.Name }</label>
						}
					</fieldset>
					<button type="submit">Apply add-ons</button>
				</form>
			} else if subscription.SyncMode == "custom" {
				<p class="np-muted">Custom subscriptions use their saved entitlement snapshot and cannot attach add-ons.</p>
			}
				@customEntitlementEditor(subscription,data,view)
				@subscriptionPolicyEditor(subscription,data,view)
			if isSiteRetryNotice(data.Notice) {
				<div class="np-panel-actions"><button type="button" data-np-dialog-open="site-dialog">Retry website setup</button></div>
			}
			</section>
			}
			if view.Tab == "access" {
				@subscriptionAccessPanel(subscription,data,view)
			} else if view.Tab == "cache" {
				@subscriptionCachePanel(subscription,data,view,0)
			} else if view.Tab == "tasks" {
				@subscriptionTasksPanel(subscription,data,view)
			} else if view.Tab == "mail" {
				@subscriptionMailPanel(subscription,data,view)
			} else if view.Tab == "applications" {
				@subscriptionApplicationsPanel(subscription,data,view)
			} else if view.Tab == "backups" {
				<section class="np-panel"><div class="np-panel-title"><h2>Subscription backups</h2></div>@subscriptionBackupRows(data.Phase6.Backups,subscription.ID)</section>
			} else if view.Tab == "activity" {
				<section class="np-panel"><div class="np-panel-title"><h2>Convergence &amp; activity</h2></div>
					if account, found := accountForSubscription(data.SubscriptionServices.Accounts,subscription.ID); found {
						<dl class="np-facts"><div><dt>Desired state</dt><dd>{ account.DesiredState }</dd></div><div><dt>Applied state</dt><dd>{ account.AppliedState }</dd></div><div><dt>Convergence</dt><dd>@statusPill(account.ConvergenceStatus)</dd></div><div><dt>Migration</dt><dd>@statusPill(account.MigrationStatus)</dd></div></dl>
						if account.LastError != "" {
							<p class="np-error">{ account.LastError }</p>
						}
					}
				</section>
			}
	} else {
		<p class="np-empty">Subscription not found.</p>
	}
}

templ subscriptionPolicyEditor(subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	if account, found := accountForSubscription(data.SubscriptionServices.Accounts,subscription.ID); found {
		<details class="np-disclosure" open><summary>Hosting policy overrides</summary>
			<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/policy") } data-np-policy-builder>
				@csrfInput(view)
				<input type="hidden" name="policy_patch" value="{}" data-np-policy-patch/>
				<div class="np-plan-field-grid">
					<label>CPU quota %<input type="number" min="-1" name="policy_cpu_percent" value={ formatJobID(int64(account.EffectivePolicy.Resources.CPUPercent)) }/></label>
					<label>Memory MB<input type="number" min="-1" name="policy_memory_mb" value={ formatJobID(int64(account.EffectivePolicy.Resources.MemoryMB)) }/></label>
					<label>I/O read MB/s<input type="number" min="-1" name="policy_io_read_mbps" value={ formatJobID(int64(account.EffectivePolicy.Resources.IOReadMBPS)) }/></label>
					<label>I/O write MB/s<input type="number" min="-1" name="policy_io_write_mbps" value={ formatJobID(int64(account.EffectivePolicy.Resources.IOWriteMBPS)) }/></label>
					<label>Process limit<input type="number" min="-1" name="policy_max_tasks" value={ formatJobID(int64(account.EffectivePolicy.Resources.MaxTasks)) }/></label>
					<label>Scheduled tasks<input type="number" min="-1" name="policy_max_scheduled_tasks" value={ formatJobID(int64(account.EffectivePolicy.Resources.MaxScheduledTasks)) }/></label>
					<label>Applications<input type="number" min="-1" name="policy_max_applications" value={ formatJobID(int64(account.EffectivePolicy.Resources.MaxApplications)) }/></label>
					<label>Container storage MB<input type="number" min="-1" name="policy_container_storage_mb" value={ formatJobID(int64(account.EffectivePolicy.Resources.ContainerStorageMB)) }/></label>
				</div>
				<fieldset><legend>Provisioned capabilities</legend><div class="np-permission-list">
					@planToggle("policy_sftp","SFTP access",account.EffectivePolicy.Permissions.SFTP)
					@planToggle("policy_scheduled_tasks","Scheduled tasks",account.EffectivePolicy.Permissions.ScheduledTasks)
					@planToggle("policy_mail","Mail hosting",account.EffectivePolicy.Permissions.Mail)
					@planToggle("policy_applications","Applications",account.EffectivePolicy.Permissions.Applications)
					@planToggle("policy_custom_images","Custom OCI images",account.EffectivePolicy.Permissions.CustomOCIImages)
				</div></fieldset>
				<label>Allowed OCI registries<input name="policy_registries" value={ joinStrings(account.EffectivePolicy.Applications.AllowedRegistries) } placeholder="registry.example.com"/></label>
				<button type="submit">Apply hosting policy</button>
			</form>
		</details>
	}
}

templ subscriptionAccessPanel(subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	<section class="np-panel"><div class="np-panel-title"><div><h2>Account Access</h2><span class="np-muted">Shared Linux account and scoped SFTP identities</span></div></div>
		if account, found := accountForSubscription(data.SubscriptionServices.Accounts,subscription.ID); found {
			<dl class="np-facts"><div><dt>System user</dt><dd>{ account.Username }</dd></div><div><dt>Home</dt><dd>{ account.HomePath }</dd></div><div><dt>Shell mode</dt><dd>{ account.ShellMode }</dd></div><div><dt>State</dt><dd>@statusPill(account.ConvergenceStatus)</dd></div></dl>
		}
		<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Identity</th><th>Directory</th><th>Status</th><th></th></tr></thead><tbody>
			for _, item := range sftpForSubscription(data.SubscriptionServices.SFTP,subscription.ID) {
				<tr><td data-label="Identity">{ item.Name }</td><td data-label="Directory">{ item.RelativeRoot }</td><td data-label="Status">{ formatEnabled(item.Enabled) }</td><td data-label="Action">@subscriptionServiceDelete(subscription.ID,"sftp",item.ID,view)</td></tr>
			}
		</tbody></table></div>
		<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/sftp") }>@csrfInput(view)<div class="np-form-grid"><label>Name<input name="name" required/></label><label>Directory<input name="relative_root" value="." required/></label><label class="np-wide-field">SSH public key<textarea name="public_key" rows="3" required></textarea></label><label class="np-check"><input type="checkbox" name="enabled" value="true" checked/>Enabled</label></div><button type="submit">Add SFTP identity</button></form>
	</section>
	<section class="np-panel"><div class="np-panel-title"><div><h2>Primary FTPS account</h2><span class="np-muted">Explicit TLS and subscription-root confinement</span></div></div>
		<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Login</th><th>Root</th><th>Status</th><th></th></tr></thead><tbody>
			for _, item := range ftpForSubscription(data.SubscriptionServices.FTP,subscription.ID) {
				if item.SiteID == 0 {
					<tr><td data-label="Login">{ item.Name }</td><td data-label="Root">Subscription home</td><td data-label="Status">@statusPill(item.ConvergenceStatus)</td><td data-label="Action">@subscriptionServiceDelete(subscription.ID,"ftp",item.ID,view)</td></tr>
				}
			}
		</tbody></table></div>
		<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/ftp") }>@csrfInput(view)<div class="np-form-grid"><label>Login name<input name="name" pattern="[a-z][a-z0-9._-]{2,31}" required/></label><label>Password<input type="password" name="password" autocomplete="new-password" placeholder="Generate when blank"/></label><label class="np-check"><input type="checkbox" name="enabled" value="true" checked/>Enabled</label></div><p class="np-form-help">Only one primary account is allowed. Passwords are shown once and never stored in plaintext.</p><button type="submit">Create or reset FTPS account</button></form>
	</section>
}

templ subscriptionCachePanel(subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView, siteID int64) {
	<section class="np-panel"><div class="np-panel-title"><div><h2>Valkey cache</h2><span class="np-muted">Socket-only · no persistence · allkeys-lru</span></div></div>
		if subscriptionValkeyUnavailable(data.SubscriptionServices.Accounts, subscription.ID) {
			<p class="np-gate">Valkey is disabled by this subscription policy. A provider must grant cache permission and memory before it can be enabled.</p>
		} else {
			if instance, found := valkeyForSubscription(data.SubscriptionServices.Valkey,subscription.ID); found {
				<dl class="np-facts"><div><dt>Desired state</dt><dd>{ instance.DesiredState }</dd></div><div><dt>Applied state</dt><dd>{ instance.AppliedState }</dd></div><div><dt>Memory</dt><dd>{ formatPlanLimitMB(instance.MemoryMB) }</dd></div><div><dt>Maximum clients</dt><dd>{ formatPlanLimit(instance.MaxClients) }</dd></div><div><dt>Socket</dt><dd><code>{ instance.SocketPath }</code></dd></div><div><dt>Convergence</dt><dd>@statusPill(instance.ConvergenceStatus)</dd></div></dl>
				if instance.LastError != "" {
					<p class="np-error">{ instance.LastError }</p>
				}
				@valkeyConfigurationForms(subscription,view,siteID,instance,true)
			} else {
				<p class="np-empty">No cache instance has been configured for this subscription.</p>
				@valkeyConfigurationForms(subscription,view,siteID,defaultValkeyInstance(),false)
			}
		}
	</section>
}

templ valkeyConfigurationForms(subscription types.SubscriptionSummary, view WorkspaceView, siteID int64, instance types.ValkeyInstance, configured bool) {
	<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/valkey") }>@csrfInput(view)
		if siteID > 0 {
			<input type="hidden" name="site_id" value={ formatJobID(siteID) }/>
			<input type="hidden" name="return_to" value="site-redis"/>
		}
		<div class="np-form-grid"><label>Desired state<select name="desired_state"><option value="enabled" selected?={ instance.DesiredState=="enabled" }>Enabled</option><option value="disabled" selected?={ instance.DesiredState=="disabled" }>Disabled</option></select></label><label>Memory, MB<input type="number" min="16" name="memory_mb" value={ formatPlanLimitFormValue(instance.MemoryMB) } required/></label><label>Maximum clients<input type="number" min="1" max="10000" name="max_clients" value={ formatPlanLimitFormValue(instance.MaxClients) } required/></label><label>Idle timeout, seconds<input type="number" min="0" max="86400" name="idle_timeout_seconds" value={ formatPlanLimitFormValue(instance.IdleTimeoutSeconds) } required/></label><label>CPU quota, %<input type="number" min="1" max="1000" name="cpu_percent" value={ formatPlanLimitFormValue(instance.CPUPercent) } required/></label><label>Process limit<input type="number" min="8" max="4096" name="process_limit" value={ formatPlanLimitFormValue(instance.ProcessLimit) } required/></label><label class="np-check"><input type="checkbox" name="rotate_credential" value="true"/>Rotate application credential</label></div><p class="np-form-help">Use user <code>app</code> and the displayed one-time credential. The Unix socket is accessible only to the subscription system account.</p><button type="submit">Apply cache configuration</button>
	</form>
	if configured && instance.DesiredState=="enabled" {
		<form class="np-form np-inline-confirm-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/valkey") }>@csrfInput(view)
			if siteID > 0 {
				<input type="hidden" name="site_id" value={ formatJobID(siteID) }/>
				<input type="hidden" name="return_to" value="site-redis"/>
			}
			<input type="hidden" name="desired_state" value={ instance.DesiredState }/><input type="hidden" name="memory_mb" value={ formatPlanLimitFormValue(instance.MemoryMB) }/><input type="hidden" name="max_clients" value={ formatPlanLimitFormValue(instance.MaxClients) }/><input type="hidden" name="idle_timeout_seconds" value={ formatPlanLimitFormValue(instance.IdleTimeoutSeconds) }/><input type="hidden" name="cpu_percent" value={ formatPlanLimitFormValue(instance.CPUPercent) }/><input type="hidden" name="process_limit" value={ formatPlanLimitFormValue(instance.ProcessLimit) }/><input type="hidden" name="flush" value="true"/><label>Type <strong>flush</strong> to clear this disposable cache<input name="confirm" autocomplete="off" required/></label><button type="submit" class="np-danger-button">Flush cache</button>
		</form>
	}
}

templ subscriptionTasksPanel(subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	<section class="np-panel"><div class="np-panel-title"><div><h2>Scheduled Tasks</h2><span class="np-muted">Commands run as the subscription account</span></div></div>
		<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Task</th><th>Schedule</th><th>Command</th><th>Status</th><th></th></tr></thead><tbody>
			for _, item := range tasksForSubscription(data.SubscriptionServices.Tasks,subscription.ID) {
				<tr><td data-label="Task">{ item.Name }</td><td data-label="Schedule">{ item.Schedule }</td><td data-label="Command"><code>{ item.Command }</code></td><td data-label="Status">@statusPill(item.Status)</td><td data-label="Action">@subscriptionServiceDelete(subscription.ID,"task",item.ID,view)</td></tr>
			}
		</tbody></table></div>
		if len(sitesForSubscription(data.Sites,subscription.ID)) > 0 {
			<form class="np-form np-action-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/scheduled-tasks") }>@csrfInput(view)<div class="np-form-grid"><label>Domain<select name="site_id" required>
				for _, site := range sitesForSubscription(data.Sites,subscription.ID) {
					<option value={ formatJobID(site.ID) }>{ site.Domain }</option>
				}
			</select></label><label>Name<input name="name" required/></label><label>Schedule<input name="schedule" placeholder="0 2 * * *" required/></label><label>Working directory<input name="working_directory" value="." required/></label><label>Timeout seconds<input type="number" min="1" max="86400" name="timeout_seconds" value="300" required/></label><label class="np-wide-field">Command<input name="command" required/></label><label class="np-check"><input type="checkbox" name="enabled" value="true" checked/>Enabled</label></div><button type="submit">Add scheduled task</button></form>
		} else {
			<p class="np-empty">Add a hosted domain before creating a scheduled task.</p>
		}
	</section>
}

templ subscriptionMailPanel(subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	<section class="np-panel"><div class="np-panel-title"><div><h2>Mail domains</h2><span class="np-muted">Mail is managed from each hosted domain</span></div></div>
		if len(sitesForSubscription(data.Sites,subscription.ID)) == 0 {
			<p class="np-empty">No domains are hosted by this subscription.</p>
		} else {
			<div class="np-object-list">
				for _, site := range sitesForSubscription(data.Sites,subscription.ID) {
					if domain, found := mailDomainForSite(data.SubscriptionServices.MailDomains,site); found {
						<a class="np-object-row" href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(site.ID))+"?tab=mail") }><span class="np-object-icon">@icon("mail")</span><span><strong>{ site.Domain }</strong><small>{ formatPlanLimit(len(mailboxesForWorkspace(data.SubscriptionServices.Mailboxes,[]dashboard.MailDomain{domain}))) } mailboxes · DKIM { formatEnabled(domain.DKIM) } · DMARC { domain.DMARCPolicy }</small></span>@statusPill(domain.Status)<span class="np-secondary-button">Manage Mail</span></a>
					} else {
						<a class="np-object-row" href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(site.ID))+"?tab=mail") }><span class="np-object-icon">@icon("mail")</span><span><strong>{ site.Domain }</strong><small>Mail service is not configured</small></span>@statusPill("not configured")<span class="np-secondary-button">Configure Mail</span></a>
					}
				}
			</div>
		}
	</section>
}

templ subscriptionApplicationsPanel(subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	<section class="np-panel"><div class="np-panel-title"><div><h2>Applications</h2><span class="np-muted">Rootless application instances</span></div></div>
		<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Application</th><th>Runtime</th><th>Image</th><th>State</th><th></th></tr></thead><tbody>
			for _, item := range applicationsForSubscription(data.SubscriptionServices.Applications,subscription.ID) {
				<tr><td data-label="Application">{ item.Name }</td><td data-label="Runtime">{ item.Runtime }</td><td data-label="Image"><code>{ item.ImageRef }</code></td><td data-label="State">@statusPill(item.Status)</td><td data-label="Action">@subscriptionServiceDelete(subscription.ID,"application",item.ID,view)</td></tr>
			}
		</tbody></table></div>
		<div class="np-object-list">
			for _, site := range sitesForSubscription(data.Sites,subscription.ID) {
				<a class="np-object-row" href={ templ.SafeURL("/sites/"+formatJobID(site.ID)+"/applications") }><span><strong>{ site.Domain }</strong><small>Deploy and manage applications in this domain context.</small></span><span class="np-secondary-button">Manage applications</span></a>
			}
		</div>
	</section>
}

templ subscriptionServiceDelete(subscriptionID int64, kind string, id int64, view WorkspaceView) {
	<form class="np-inline-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscriptionID)+"/services/"+kind+"/"+formatJobID(id)+"/delete") }>@csrfInput(view)<button type="submit" class="np-icon-button np-danger-button" title="Delete" data-np-confirm="Delete this service configuration?">@icon("trash")</button></form>
}

templ siteSubscriptionServiceDelete(subscriptionID int64, kind string, id int64, siteID int64, returnTo string, view WorkspaceView) {
	<form class="np-inline-form" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscriptionID)+"/services/"+kind+"/"+formatJobID(id)+"/delete") }>@csrfInput(view)<input type="hidden" name="site_id" value={ formatJobID(siteID) }/><input type="hidden" name="return_to" value={ returnTo }/><button type="submit" class="np-icon-button np-danger-button" title="Delete" data-np-confirm="Delete this service configuration?">@icon("trash")</button></form>
}

templ subscriptionBackupRows(items []dashboard.Backup, subscriptionID int64) {
	<div class="np-table-wrap"><table class="np-table"><thead><tr><th>Target</th><th>Status</th><th>Size</th><th>Created</th></tr></thead><tbody>
		for _, item := range items {
			if item.SubscriptionID == subscriptionID {
				<tr><td data-label="Target">{ item.TargetName }</td><td data-label="Status">@statusPill(item.Status)</td><td data-label="Size">{ formatBytes(item.SizeBytes) }</td><td data-label="Created">{ formatTime(item.CreatedAt) }</td></tr>
			}
		}
	</tbody></table></div>
}

templ customEntitlementEditor(subscription types.SubscriptionSummary, data dashboard.Data, view WorkspaceView) {
	<details class="np-disclosure"><summary>Custom entitlement snapshot</summary>
		<form class="np-form np-action-form np-custom-entitlements" method="post" action={ templ.SafeURL("/subscriptions/"+formatJobID(subscription.ID)+"/mode") }>
			@csrfInput(view)
			<input type="hidden" name="sync_mode" value="custom"/>
			<div class="np-plan-field-grid">
				@planLimitField("Disk space","disk_mb",subscription.DiskMB,"MB")
				@planLimitField("Monthly traffic","bandwidth_mb",subscription.BandwidthMB,"MB")
				@planLimitField("Websites","max_sites",subscription.MaxSites,"count")
				@planLimitField("Subdomains","max_subdomains",subscription.MaxSubdomains,"count")
				@planLimitField("Domain aliases","max_domain_aliases",subscription.MaxDomainAliases,"count")
				@planLimitField("Databases","max_databases",subscription.MaxDatabases,"count")
				@planLimitField("Mailboxes","max_mailboxes",subscription.MaxMailboxes,"count")
				@planLimitField("FTP accounts","max_ftp_accounts",subscription.MaxFTPAccounts,"count")
				@planLimitField("Backups","max_backups",subscription.MaxBackups,"count")
				@planLimitField("Backup storage","backup_storage_mb",subscription.BackupStorageMB,"MB")
				@planLimitField("Backup retention","backup_retention_days",subscription.BackupRetentionDays,"days")
				@planLimitField("Subscription validity","validity_days",subscription.ValidityDays,"days")
				@planLimitField("Per-site disk quota","site_disk_quota_mb",subscription.SiteDiskQuotaMB,"MB")
				@planLimitField("PHP-FPM max children","php_max_children",subscription.PHPFPMMaxChildren,"count")
				@planLimitField("PHP memory","php_memory_mb",subscription.PHPMemoryMB,"MB")
			</div>
			<div class="np-plan-field-grid np-threshold-grid">
				<label>Overuse policy<select name="overuse_policy"><option value="block" selected?={ subscription.OverusePolicy == types.PlanOveruseBlock }>Block</option><option value="normal" selected?={ subscription.OverusePolicy == types.PlanOveruseNormal }>Allow</option><option value="notify" selected?={ subscription.OverusePolicy == types.PlanOveruseNotify }>Allow and notify</option><option value="not_suspend" selected?={ subscription.OverusePolicy == types.PlanOveruseNotSuspend }>Disk and traffic only</option><option value="not_suspend_notify" selected?={ subscription.OverusePolicy == types.PlanOveruseNotSuspendNotify }>Disk and traffic with notifications</option></select></label>
				<label>Disk warning %<input type="number" min="1" max="100" name="disk_warning_percent" value={ formatJobID(int64(subscription.DiskWarningPercent)) }/></label>
				<label>Traffic warning %<input type="number" min="1" max="100" name="traffic_warning_percent" value={ formatJobID(int64(subscription.TrafficWarningPercent)) }/></label>
			</div>
			<fieldset><legend>Permissions</legend><div class="np-permission-list">@planToggle("hosting_enabled","Web hosting enabled",subscription.HostingEnabled) @planToggle("allow_dns","DNS zone management",subscription.AllowDNS) @planToggle("allow_tls","SSL/TLS certificate management",subscription.AllowTLS) @planToggle("allow_backups","Backup and restore management",subscription.AllowBackups) @planToggle("allow_php_settings","PHP settings management",subscription.AllowPHPSettings) @planToggle("allow_ssh","SSH access",subscription.AllowSSH)</div></fieldset>
			<fieldset><legend>PHP runtimes</legend><div class="np-checkbox-grid">
				for _, version := range customSubscriptionPHPVersions(subscription,data.Capabilities) {
					<label class="np-check"><input type="checkbox" name="php_versions" value={ version } checked?={ containsCSV(subscription.PHPAllowlist,version) }/>{ version }</label>
				}
			</div><label>Default PHP version<select name="default_php_version">
				for _, version := range customSubscriptionPHPVersions(subscription,data.Capabilities) {
					<option value={ version } selected?={ version == subscription.DefaultPHPVersion }>{ version }</option>
				}
			</select></label></fieldset>
			<input type="hidden" name="hosting_web_server" value={ subscription.ServicePresets.Hosting.WebServer }/>
			<input type="hidden" name="preferred_domain" value={ subscription.ServicePresets.Hosting.PreferredDomain }/>
			<input type="hidden" name="php_max_execution_seconds" value={ formatJobID(int64(subscription.ServicePresets.PHP.MaxExecutionSeconds)) }/>
			<input type="hidden" name="php_max_input_seconds" value={ formatJobID(int64(subscription.ServicePresets.PHP.MaxInputSeconds)) }/>
			<input type="hidden" name="php_post_max_mb" value={ formatJobID(int64(subscription.ServicePresets.PHP.PostMaxMB)) }/>
			<input type="hidden" name="php_upload_max_mb" value={ formatJobID(int64(subscription.ServicePresets.PHP.UploadMaxMB)) }/>
			<input type="hidden" name="php_fpm_max_requests" value={ formatJobID(int64(subscription.ServicePresets.PHP.FPMMaxRequests)) }/>
			<input type="hidden" name="php_display_errors" value={ formatBool(subscription.ServicePresets.PHP.DisplayErrors) }/>
			<input type="hidden" name="php_log_errors" value={ formatBool(subscription.ServicePresets.PHP.LogErrors) }/>
			<input type="hidden" name="php_allow_url_fopen" value={ formatBool(subscription.ServicePresets.PHP.AllowURLFOpen) }/>
			<input type="hidden" name="mail_webmail_enabled" value={ formatBool(subscription.ServicePresets.Mail.WebmailEnabled) }/>
			<input type="hidden" name="mail_spam_filter" value={ formatBool(subscription.ServicePresets.Mail.SpamFilter) }/>
			<input type="hidden" name="mail_dkim" value={ formatBool(subscription.ServicePresets.Mail.DKIM) }/>
			<input type="hidden" name="mail_dmarc_policy" value={ subscription.ServicePresets.Mail.DMARCPolicy }/>
			<input type="hidden" name="dns_mode" value={ subscription.ServicePresets.DNS.Mode }/>
			<input type="hidden" name="dns_default_ttl" value={ formatJobID(int64(subscription.ServicePresets.DNS.DefaultTTL)) }/>
			<input type="hidden" name="performance_max_connections" value={ formatJobID(int64(subscription.ServicePresets.Performance.MaxConnections)) }/>
			<input type="hidden" name="performance_static_cache" value={ formatBool(subscription.ServicePresets.Performance.StaticFileCache) }/>
			<input type="hidden" name="logs_rotation_enabled" value={ formatBool(subscription.ServicePresets.Logs.RotationEnabled) }/>
			<input type="hidden" name="logs_retention_days" value={ formatJobID(int64(subscription.ServicePresets.Logs.RetentionDays)) }/>
			<input type="hidden" name="logs_statistics_enabled" value={ formatBool(subscription.ServicePresets.Logs.StatisticsEnabled) }/>
			<input type="hidden" name="applications_catalog_enabled" value={ formatBool(subscription.ServicePresets.Applications.CatalogEnabled) }/>
			for _, application := range subscription.ServicePresets.Applications.Allowed {
				<input type="hidden" name="applications_allowed" value={ application }/>
			}
			<button type="submit" data-np-confirm="Detach this subscription from automatic plan synchronization?">Save custom snapshot</button>
		</form>
	</details>
}

templ subscriptionDomainBlock(site dashboard.Site, data dashboard.Data, view WorkspaceView) {
	<article class="np-domain-block">
		<div class="np-domain-block-main">
			<span class="np-object-icon">@icon("globe")</span>
			<div>
				<a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(site.ID))) }><strong>{ site.Domain }</strong></a>
				<span>{ site.Username } · PHP { site.PHPVersion }</span>
			</div>
			@statusPill(site.Status)
		</div>
		<div class="np-domain-service-state">
			<span>@icon("shield")<b>{ formatTLSState(site) }</b> TLS</span>
			<span>@icon("database")<b>{ formatPlanLimit(len(databasesForSite(data.Databases,site.ID))) }</b> databases</span>
			<span>@icon("archive")<b>{ formatPlanLimit(len(backupsForSite(data.Phase6.Backups,site.ID))) }</b> backups</span>
		</div>
		<nav>
			<a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(site.ID))+"?tab=hosting") }>Hosting</a>
			<a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(site.ID))+"?tab=php") }>PHP</a>
			<a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(site.ID))+"?tab=dns") }>DNS</a>
			<a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(site.ID))+"?tab=ssl") }>SSL/TLS</a>
			<a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(site.ID))+"?tab=databases") }>Databases</a>
			<a href={ templ.SafeURL(workspacePath(view,"/sites/"+formatJobID(site.ID))+"?tab=backups") }>Backups</a>
		</nav>
	</article>
}

templ routedSubscriptionOnboarding(data dashboard.Data, view WorkspaceView) {
	@pageHead("Account management", "Add Subscription", "Create the customer, entitlement and optional first website in one guided workflow.") {
		<a class="np-secondary-link" href="/subscriptions">Cancel</a>
	}
	<form class="np-onboarding" method="post" action="/subscriptions/onboard" data-np-onboarding>
		@csrfInput(view)
		<section class="np-panel"><div class="np-step-head"><span>1</span><div><h2>Customer</h2><p>Choose an existing customer or create a new profile.</p></div></div>
			<div class="np-segmented"><label><input type="radio" name="customer_mode" value="existing" checked/>Existing customer</label><label><input type="radio" name="customer_mode" value="new"/>New customer</label></div>
			<div data-np-customer-mode="existing"><label>Customer<select name="customer_id"><option value="">Select customer</option>
				for _, customer := range data.Customers {
					<option value={ formatJobID(customer.ID) } selected?={ customer.ID == view.DetailID }>{ displayCustomer(customer) } · { customer.Email }</option>
				}
			</select></label></div>
			<div class="np-form-grid" data-np-customer-mode="new" hidden><label>Email<input type="email" name="customer_email"/></label><label>Name<input name="customer_name"/></label><label>Company<input name="company"/></label><label class="np-check"><input type="checkbox" name="enable_login" value="true"/>Enable panel login</label><label>Password<input type="password" name="password" autocomplete="new-password"/></label></div>
		</section>
		<section class="np-panel"><div class="np-step-head"><span>2</span><div><h2>Service plan</h2><p>The plan remains the source of every entitlement.</p></div></div><div class="np-form-grid"><label>Plan<select name="plan_id" data-np-onboarding-plan required>
			for _, plan := range data.Plans {
				if plan.IsActive {
					<option value={ formatPlanID(plan.ID) } data-php-versions={ joinStrings(planPHPVersions(plan,data.Capabilities)) }>{ plan.Name }</option>
				}
			}
			</select></label><label>Subscription name<input name="subscription_name" required/></label><label>System username<input name="system_username" pattern="[a-z][a-z0-9]{2,31}" placeholder="Generated if empty"/></label></div></section>
			<section class="np-panel"><div class="np-step-head"><span>3</span><div><h2>First website</h2><p>Optional. Nakpanel will queue provisioning after the subscription is saved.</p></div></div><label class="np-check"><input type="checkbox" name="create_site" value="true" data-np-create-first-site/>Create the first website now</label><div class="np-form-grid" data-np-first-site hidden><label>Domain<input name="domain"/></label><label>PHP<select name="php_version" data-np-onboarding-php></select></label><p class="np-gate is-blocked" data-np-onboarding-php-gate hidden>No installed PHP-FPM version is allowed by this plan.</p></div></section>
		<div class="np-onboarding-actions"><a class="np-secondary-link" href="/subscriptions">Cancel</a><button type="submit">Create subscription</button></div>
	</form>
}

templ routedPlans(data dashboard.Data, user auth.SessionUser, view WorkspaceView) {
	@pageHead("Account management", "Service Plans", "Define reusable hosting resources, permissions and service presets.") {
		if planListType(view) == "hosting" {
			<a class="np-primary-link" href="/service-plans/new">Create plan</a>
		}
		if planListType(view) == "addon" {
			<a class="np-primary-link" href="/service-plans/addons/new">Add an Add-on</a>
		}
		if user.Role == auth.RoleAdmin && planListType(view) == "reseller" {
			<a class="np-primary-link" href="/service-plans/resellers/new">Add Reseller Plan</a>
		}
	}
		<nav class="np-plan-type-tabs" aria-label="Plan type">
			<a class={ planTypeClass(planListType(view), "hosting") } href="/service-plans?type=hosting">Hosting Plans</a>
			<a class={ planTypeClass(planListType(view), "addon") } href="/service-plans?type=addon">Add-on Plans</a>
			if user.Role == auth.RoleAdmin {
				<a class={ planTypeClass(planListType(view), "reseller") } href="/service-plans?type=reseller">Reseller Plans</a>
			}
		</nav>
	<section class="np-plan-toolbar">
		<form method="get" action="/service-plans" class="np-plan-filters"><input type="hidden" name="type" value={ planListType(view) }/><label class="np-filter-search">@icon("search")<input type="search" name="q" value={ view.SearchQuery } placeholder="Search plans"/></label><label><span class="np-sr-only">Provider</span><select name="provider"><option value="">All providers</option><option value="admin" selected?={ view.ProviderFilter == "admin" }>Administrator</option>
			for _, reseller := range data.Resellers {
				<option value={ formatPlanID(reseller.ID) } selected?={ view.ProviderFilter == formatPlanID(reseller.ID) }>{ reseller.DisplayName }</option>
			}
		</select></label><label><span class="np-sr-only">Status</span><select name="status"><option value="">All statuses</option><option value="active" selected?={ view.StatusFilter == "active" }>Active</option><option value="inactive" selected?={ view.StatusFilter == "inactive" }>Inactive</option></select></label><button class="np-secondary-button" type="submit">Filter</button></form>
	</section>
		if planListType(view) == "hosting" {
			@hostingPlanTable(data, view)
		}
		if planListType(view) == "addon" {
			@addonPlanTable(data, view)
		}
		if user.Role == auth.RoleAdmin && planListType(view) == "reseller" {
			@resellerPlanTable(data, view)
		}
}

templ hostingPlanTable(data dashboard.Data, view WorkspaceView) {
	<section class="np-panel np-plan-list-panel"><form method="post" action="/plans/bulk-status" data-np-bulk-form>@csrfInput(view)
		<div class="np-bulk-bar"><label class="np-check"><input type="checkbox" data-np-bulk-all/>Select all</label><span data-np-bulk-count>0 selected</span><div><button type="submit" name="is_active" value="true" class="np-secondary-button">Activate</button><button type="submit" name="is_active" value="false" class="np-secondary-button">Deactivate</button></div></div>
		<div class="np-table-wrap"><table class="np-table np-plan-table"><thead><tr><th><span class="np-sr-only">Select</span></th><th>Plan name</th><th>Provider</th><th>Subscriptions</th><th>Resources</th><th>Price</th><th>Sync</th><th>Status</th></tr></thead><tbody>
			for _, plan := range data.Plans {
				if planMatchesFilter(plan, view) {
				<tr><td data-label="Select" class="np-select-cell"><input type="checkbox" name="plan_id" value={ formatPlanID(plan.ID) } data-np-bulk-check aria-label={ "Select " + plan.Name }/></td><td data-label="Plan"><a class="np-plan-name" href={ templ.SafeURL("/service-plans/" + formatPlanID(plan.ID)) }><strong>{ plan.Name }</strong><small>Revision { formatPlanID(int64(plan.Revision)) }</small></a></td><td data-label="Provider">{ planProvider(plan, data.Resellers) }</td><td data-label="Subscriptions">{ formatPlanID(int64(planSubscriptionCount(plan.ID, data.Subscriptions))) }</td><td data-label="Resources"><span class="np-resource-summary"><strong>{ formatPlanLimitMB(plan.DiskMB) }</strong><small>{ formatPlanLimit(plan.MaxSites) } sites · { formatPlanLimit(plan.MaxDatabases) } databases · { formatPlanLimitMB(plan.BandwidthMB) } traffic</small></span></td><td data-label="Price">{ formatPlanPrice(plan.PriceCents) }</td><td data-label="Sync">@statusPill(planSyncLabel(plan.ID, data.Subscriptions))</td><td data-label="Status">@statusPill(planActiveStatus(plan.IsActive))</td></tr>
				}
			}
		</tbody></table></div>
	</form></section>
}

templ addonPlanTable(data dashboard.Data, view WorkspaceView) {
	<section class="np-panel np-plan-list-panel"><form method="post" action="/addons/bulk-status" data-np-bulk-form>@csrfInput(view)
		<div class="np-bulk-bar"><label class="np-check"><input type="checkbox" data-np-bulk-all/>Select all</label><span data-np-bulk-count>0 selected</span><div><button type="submit" name="is_active" value="true" class="np-secondary-button">Activate</button><button type="submit" name="is_active" value="false" class="np-secondary-button">Deactivate</button></div></div>
		<div class="np-table-wrap"><table class="np-table np-plan-table"><thead><tr><th><span class="np-sr-only">Select</span></th><th>Add-on</th><th>Provider</th><th>Resources added</th><th>Revision</th><th>Status</th></tr></thead><tbody>
		for _, addon := range data.AddonPlans {
			if addonMatchesFilter(addon, view) {
				<tr><td data-label="Select" class="np-select-cell"><input type="checkbox" name="addon_id" value={ formatPlanID(addon.ID) } data-np-bulk-check aria-label={ "Select " + addon.Name }/></td><td data-label="Add-on"><a class="np-plan-name" href={ templ.SafeURL("/service-plans/addons/" + formatPlanID(addon.ID)) }><strong>{ addon.Name }</strong><small>{ addon.Description }</small></a></td><td data-label="Provider">{ addonProvider(addon, data.Resellers) }</td><td data-label="Resources"><span class="np-resource-summary"><strong>+{ formatPlanLimitMB(addon.Entitlements.DiskMB) }</strong><small>+{ formatPlanLimit(addon.Entitlements.MaxSites) } sites · +{ formatPlanLimit(addon.Entitlements.MaxDatabases) } databases</small></span></td><td data-label="Revision">{ formatPlanID(int64(addon.Revision)) }</td><td data-label="Status">@statusPill(planActiveStatus(addon.IsActive))</td></tr>
			}
		}
	</tbody></table></div></form></section>
}

templ resellerPlanTable(data dashboard.Data, view WorkspaceView) {
	<section class="np-panel np-plan-list-panel"><form method="post" action="/reseller-plans/bulk-status" data-np-bulk-form>@csrfInput(view)
		<div class="np-bulk-bar"><label class="np-check"><input type="checkbox" data-np-bulk-all/>Select all</label><span data-np-bulk-count>0 selected</span><div><button type="submit" name="is_active" value="true" class="np-secondary-button">Activate</button><button type="submit" name="is_active" value="false" class="np-secondary-button">Deactivate</button></div></div>
		<div class="np-table-wrap"><table class="np-table np-plan-table"><thead><tr><th><span class="np-sr-only">Select</span></th><th>Plan</th><th>Customers</th><th>Subscriptions</th><th>Disk</th><th>Sites</th><th>Status</th></tr></thead><tbody>
	for _, plan := range data.ResellerPlans {
			<tr><td data-label="Select" class="np-select-cell"><input type="checkbox" name="reseller_plan_id" value={ formatPlanID(plan.ID) } data-np-bulk-check aria-label={ "Select " + plan.Name }/></td><td data-label="Plan"><a class="np-plan-name" href={ templ.SafeURL("/service-plans/resellers/" + formatPlanID(plan.ID)) }><strong>{ plan.Name }</strong><small>{ plan.Description }</small></a></td><td data-label="Customers">{ formatPlanLimit(plan.MaxCustomers) }</td><td data-label="Subscriptions">{ formatPlanLimit(plan.MaxSubscriptions) }</td><td data-label="Disk">{ formatPlanLimitMB(plan.DiskMB) }</td><td data-label="Sites">{ formatPlanLimit(plan.MaxSites) }</td><td data-label="Status">@statusPill(planActiveStatus(plan.IsActive))</td></tr>
		}
	</tbody></table></div></form></section>
}

templ routedResellers(data dashboard.Data, view WorkspaceView) {
	@pageHead("Account management", "Resellers", "Allocate server resources to providers who manage their own plans, customers and subscriptions.") {
		<a class="np-primary-link" href="#reseller-create">Add reseller</a>
	}
	<section class="np-panel">
		<div class="np-panel-title"><h2>Provider accounts</h2><span class="np-muted">{ formatBadgeCount(len(data.Resellers)) } total</span></div>
		<form method="post" action="/resellers/bulk-status" data-np-bulk-form>
			@csrfInput(view)
			<div class="np-bulk-bar"><label class="np-check"><input type="checkbox" data-np-bulk-all/>Select all</label><span data-np-bulk-count>0 selected</span><div><button type="submit" name="status" value="active" class="np-secondary-button">Activate</button><button type="submit" name="status" value="suspended" class="np-danger-button" data-np-confirm="Suspend the selected resellers and all downstream websites?">Suspend</button></div></div>
		<div class="np-table-wrap"><table class="np-table"><thead><tr><th><span class="np-sr-only">Select</span></th><th>Reseller</th><th>Plan</th><th>Customers</th><th>Subscriptions</th><th>Status</th></tr></thead><tbody>
			for _, reseller := range data.Resellers {
				<tr><td class="np-select-cell" data-label="Select"><input type="checkbox" name="reseller_id" value={ formatJobID(reseller.ID) } aria-label={ "Select " + reseller.DisplayName } data-np-bulk-check/></td><td data-label="Reseller"><a href={ templ.SafeURL("/resellers/" + formatJobID(reseller.ID)) }><strong>{ reseller.DisplayName }</strong><small>{ reseller.Email }</small></a></td><td data-label="Plan">{ reseller.PlanName }</td><td data-label="Customers">{ formatJobID(int64(len(customersForReseller(data.Customers,reseller.ID)))) }</td><td data-label="Subscriptions">{ formatJobID(int64(len(subscriptionsForReseller(data.Subscriptions,reseller.ID)))) }</td><td data-label="Status">@statusPill(reseller.Status)</td></tr>
			}
		</tbody></table></div></form>
	</section>
	<section class="np-panel" id="reseller-create"><div class="np-panel-title"><h2>Add reseller</h2><span class="np-muted">bounded provider account</span></div>
		<form class="np-form np-action-form" method="post" action="/resellers">@csrfInput(view)
			<label>Name<input name="customer_name" required/></label><label>Company<input name="company"/></label><label>Email<input type="email" name="customer_email" required/></label><label>Temporary password<input type="password" name="password" autocomplete="new-password" required/></label>
			<label>Reseller plan<select name="reseller_plan_id" required><option value="">Select plan</option>
				for _, plan := range data.ResellerPlans {
					if plan.IsActive {
						<option value={ formatJobID(plan.ID) }>{ plan.Name }</option>
					}
				}
			</select></label><label>Internal notes<input name="notes"/></label><button type="submit">Create reseller</button>
		</form>
	</section>
}

templ routedResellerDetail(data dashboard.Data, view WorkspaceView) {
	if reseller, ok := resellerByID(data.Resellers, view.DetailID); ok {
		@pageHead("Resellers", reseller.DisplayName, "Provider account, allocated resources and downstream ownership.") { <a class="np-secondary-button" href="/resellers">Back to resellers</a> }
		<div class="np-routed-grid"><section class="np-panel"><div class="np-panel-title"><h2>Account</h2>@statusPill(reseller.Status)</div><dl class="np-facts"><div><dt>Email</dt><dd>{ reseller.Email }</dd></div><div><dt>Company</dt><dd>{ reseller.Company }</dd></div><div><dt>Reseller plan</dt><dd>{ reseller.PlanName }</dd></div><div><dt>Customers</dt><dd>{ formatJobID(int64(len(customersForReseller(data.Customers,reseller.ID)))) }</dd></div></dl><form method="post" action="/resellers/status">@csrfInput(view)<input type="hidden" name="reseller_id" value={ formatJobID(reseller.ID) }/><input type="hidden" name="status" value={ oppositeCustomerStatus(types.Customer{Status:reseller.Status}) }/><button type="submit" class="np-secondary-button" data-np-confirm="This changes service availability for every downstream customer.">{ customerStatusAction(types.Customer{Status:reseller.Status}) } reseller</button></form></section>
		<section class="np-panel"><div class="np-panel-title"><h2>Owned service plans</h2></div>@planRows(plansForReseller(data.Plans,reseller.ID))</section></div>
		<section class="np-panel"><div class="np-panel-title"><h2>Customers</h2></div>@customerRows(customersForReseller(data.Customers,reseller.ID),data.Subscriptions,data.Resellers)</section>
	}
}

templ routedResellerPlans(data dashboard.Data, view WorkspaceView) {
	@pageHead("Service plans", "Reseller Plans", "Define the hard resource and permission boundary available to each reseller.") { <a class="np-primary-link" href="/service-plans/resellers/new">Add Reseller Plan</a> }
	<section class="np-panel"><div class="np-panel-title"><h2>Allocations</h2></div><div class="np-table-wrap"><table class="np-table"><thead><tr><th>Plan</th><th>Customers</th><th>Subscriptions</th><th>Disk</th><th>Sites</th><th>Status</th></tr></thead><tbody>
		for _, plan := range data.ResellerPlans {
			if resellerPlanMatchesFilter(plan, view) {
				<tr><td data-label="Plan"><a class="np-plan-name" href={ templ.SafeURL("/service-plans/resellers/" + formatPlanID(plan.ID)) }><strong>{ plan.Name }</strong><small>{ plan.Description }</small></a></td><td data-label="Customers">{ formatPlanLimit(plan.MaxCustomers) }</td><td data-label="Subscriptions">{ formatPlanLimit(plan.MaxSubscriptions) }</td><td data-label="Disk">{ formatPlanLimitMB(plan.DiskMB) }</td><td data-label="Sites">{ formatPlanLimit(plan.MaxSites) }</td><td data-label="Status">@statusPill(planActiveStatus(plan.IsActive))</td></tr>
			}
		}
	</tbody></table></div></section>
}

templ routedResellerPlanEditor(plan types.ResellerPlan, capabilities types.RuntimeCapabilities, view WorkspaceView) {
	@pageHead("Service plans", resellerPlanEditorTitle(plan), "Set the maximum resources and permissions a reseller may commit to downstream subscriptions.") { <a class="np-secondary-button" href="/service-plans?type=reseller">Back to plans</a> }
	<form class="np-plan-editor" method="post" action="/reseller-plans" data-np-plan-editor data-np-dirty-guard>
		@csrfInput(view)
		if plan.ID > 0 {
			<input type="hidden" name="reseller_plan_id" value={ formatPlanID(plan.ID) }/>
		}
		<section class="np-plan-general"><div class="np-plan-general-grid"><label>Plan name<input name="name" value={ plan.Name } required maxlength="120"/></label><label class="np-plan-description">Description<textarea name="description" rows="2">{ plan.Description }</textarea></label><label class="np-switch"><input type="hidden" name="is_active" value="false"/><input type="checkbox" name="is_active" value="true" checked?={ plan.IsActive }/><span>Available for new resellers</span></label></div></section>
		<nav class="np-plan-editor-tabs" aria-label="Reseller plan properties">@planEditorTabLink(view,"resources","Resources") @planEditorTabLink(view,"permissions","Permissions")</nav>
		<section class="np-plan-property-panel" data-np-plan-panel="resources" hidden?={ planEditorTab(view) != "resources" }><div class="np-property-head"><h2>Resources</h2><p>These are provider-wide allocation ceilings across every downstream customer. Zero disables a resource; Unlimited removes the numeric ceiling.</p></div><div class="np-plan-field-grid">@planLimitField("Customers","max_customers",plan.MaxCustomers,"count") @planLimitField("Subscriptions","max_subscriptions",plan.MaxSubscriptions,"count") @planLimitField("Disk space","disk_mb",plan.DiskMB,"MB") @planLimitField("Monthly traffic","bandwidth_mb",plan.BandwidthMB,"MB") @planLimitField("Websites","max_sites",plan.MaxSites,"count") @planLimitField("Subdomains","max_subdomains",plan.MaxSubdomains,"count") @planLimitField("Domain aliases","max_domain_aliases",plan.MaxDomainAliases,"count") @planLimitField("Databases","max_databases",plan.MaxDatabases,"count") @planLimitField("Database users","max_database_users",plan.HostingPolicy.Resources.MaxDatabaseUsers,"count") @planLimitField("Mailboxes","max_mailboxes",plan.MaxMailboxes,"count") @planLimitField("Mail aliases","max_mail_aliases",plan.HostingPolicy.Resources.MaxMailAliases,"count") @planLimitField("FTP accounts","max_ftp_accounts",plan.MaxFTPAccounts,"count") @planLimitField("Scheduled tasks","max_scheduled_tasks",plan.HostingPolicy.Resources.MaxScheduledTasks,"count") @planLimitField("Applications","max_applications",plan.HostingPolicy.Resources.MaxApplications,"count") @planLimitField("Container storage","container_storage_mb",plan.HostingPolicy.Resources.ContainerStorageMB,"MB") @planLimitField("PHP worker processes","max_php_workers",plan.HostingPolicy.Resources.MaxPHPWorkers,"count") @planLimitField("PHP releases","max_php_releases",plan.HostingPolicy.Resources.MaxPHPReleases,"count") @planLimitField("Valkey memory","valkey_memory_mb",plan.HostingPolicy.Resources.ValkeyMemoryMB,"MB") @planLimitField("CPU quota","cpu_percent",plan.HostingPolicy.Resources.CPUPercent,"percent") @planLimitField("Memory","memory_limit_mb",plan.HostingPolicy.Resources.MemoryMB,"MB") @planLimitField("I/O read","io_read_mbps",plan.HostingPolicy.Resources.IOReadMBPS,"MBps") @planLimitField("I/O write","io_write_mbps",plan.HostingPolicy.Resources.IOWriteMBPS,"MBps") @planLimitField("Processes","max_tasks",plan.HostingPolicy.Resources.MaxTasks,"count") @planLimitField("Backups","max_backups",plan.MaxBackups,"count") @planLimitField("Backup storage","backup_storage_mb",plan.BackupStorageMB,"MB")</div></section>
		<section class="np-plan-property-panel" data-np-plan-panel="permissions" hidden?={ planEditorTab(view) != "permissions" }><div class="np-property-head"><h2>Permissions</h2><p>Resellers may grant only capabilities included in this allocation.</p></div><div class="np-permission-list">@planToggle("allow_custom_plans","Create custom subscription snapshots",plan.AllowCustomPlans) @planToggle("allow_dns","DNS zone management",plan.AllowDNS) @planToggle("allow_tls","SSL/TLS certificate management",plan.AllowTLS) @planToggle("allow_backups","Backup and restore management",plan.AllowBackups) @planToggle("allow_php_settings","PHP settings management",plan.AllowPHPSettings) @planToggle("allow_composer","Composer",plan.HostingPolicy.Permissions.Composer) @planToggle("allow_composer_code_execution","Composer code execution",plan.HostingPolicy.Permissions.ComposerCodeExecution) @planToggle("allow_managed_php_deployments","Managed PHP deployments",plan.HostingPolicy.Permissions.ManagedPHPDeployments) @planToggle("allow_php_workers","PHP workers",plan.HostingPolicy.Permissions.PHPWorkers) @planToggle("allow_ssh","SSH access",plan.AllowSSH) @planToggle("allow_sftp","SFTP identities",plan.HostingPolicy.Permissions.SFTP) @planToggle("allow_ftps","TLS-only FTPS",plan.HostingPolicy.Permissions.FTPS) @planToggle("allow_logs","Domain logs",plan.HostingPolicy.Permissions.Logs) @planToggle("allow_git","Git deployment",plan.HostingPolicy.Permissions.Git) @planToggle("allow_staging","Staging workflows",plan.HostingPolicy.Permissions.Staging) @planToggle("allow_valkey","Valkey cache",plan.HostingPolicy.Permissions.Valkey) @planToggle("allow_scheduled_tasks","Scheduled tasks",plan.HostingPolicy.Permissions.ScheduledTasks) @planToggle("allow_applications","Application catalog",plan.HostingPolicy.Permissions.Applications) @planToggle("allow_custom_oci_images","Custom OCI images",plan.HostingPolicy.Permissions.CustomOCIImages) @planToggle("allow_application_egress","Application network egress",plan.HostingPolicy.Permissions.ApplicationEgress)</div><p class="np-form-help">Zero disables workers or release retention. Unlimited may be delegated only when the provider ceiling is also unlimited.</p><fieldset class="np-field-group"><legend>Allowed PHP versions</legend><div class="np-checkbox-grid">
			for _, version := range capabilities.PHPVersions {
				<label class="np-check"><input type="checkbox" name="php_versions" value={ version } checked?={ stringInSlice(plan.HostingPolicy.PHP.AllowedVersions,version) }/>{ version }</label>
			}
		</div></fieldset><fieldset class="np-field-group"><legend>Operational container runtime</legend><div class="np-checkbox-grid"><label class="np-check"><input type="checkbox" name="allowed_runtimes" value="oci" checked?={ stringInSlice(plan.HostingPolicy.Applications.AllowedRuntimes,"oci") }/>OCI containers</label></div><p class="np-form-help">OCI remains a separate Containers product. Classic PHP is operational; resellers may grant Managed PHP only within the Composer, worker, release, and provider ceilings above. WordPress Toolkit, Node.js, and Python are not implemented.</p></fieldset><label>Allowed registries<input name="allowed_registries" value={ joinStrings(plan.HostingPolicy.Applications.AllowedRegistries) } placeholder="docker.io,ghcr.io"/></label></section>
		<div class="np-plan-action-bar"><div><strong>{ resellerPlanEditorSaveTitle(plan) }</strong><span>Existing reseller allocations are validated before this change is committed.</span></div><div><a class="np-secondary-button" href="/service-plans?type=reseller">Cancel</a><button type="submit">{ resellerPlanEditorSubmitLabel(plan) }</button></div></div>
	</form>
}

templ routedMyResources(data dashboard.Data, view WorkspaceView) {
	@pageHead("Account", "My Resources", "Your provider allocation and the committed customer resources inside it.") {}
	if len(data.ResellerPlans) == 0 {
		<section class="np-panel"><p class="np-empty">No active reseller allocation.</p></section>
	} else {
		for _, plan := range data.ResellerPlans {
			<section class="np-panel"><div class="np-panel-title"><h2>{ plan.Name }</h2>@statusPill(planActiveStatus(plan.IsActive))</div><dl class="np-facts"><div><dt>Customers</dt><dd>{ formatPlanLimit(plan.MaxCustomers) }</dd></div><div><dt>Subscriptions</dt><dd>{ formatPlanLimit(plan.MaxSubscriptions) }</dd></div><div><dt>Disk</dt><dd>{ formatPlanLimitMB(plan.DiskMB) }</dd></div><div><dt>Sites</dt><dd>{ formatPlanLimit(plan.MaxSites) }</dd></div><div><dt>Databases</dt><dd>{ formatPlanLimit(plan.MaxDatabases) }</dd></div><div><dt>Custom plans</dt><dd>{ yesNo(plan.AllowCustomPlans) }</dd></div></dl></section>
		}
	}
}

templ customerRows(customers []types.Customer, subscriptions []types.SubscriptionSummary, resellers []types.Reseller) {
	<div class="np-table-wrap"><table class="np-table"><thead><tr><th><span class="np-sr-only">Select</span></th><th>Customer</th><th>Provider</th><th>Subscriptions</th><th>Status</th></tr></thead><tbody>
		for _, customer := range customers {
			<tr><td class="np-select-cell" data-label="Select"><input type="checkbox" name="customer_id" value={ formatJobID(customer.ID) } aria-label={ "Select " + customer.DisplayName } data-np-bulk-check/></td><td data-label="Customer"><a href={ templ.SafeURL("/customers/" + formatJobID(customer.ID)) }><strong>{ customer.DisplayName }</strong><small>{ customer.Email }</small></a></td><td data-label="Provider">{ providerName(customer,resellers) }</td><td data-label="Subscriptions">{ formatJobID(int64(len(subscriptionsForCustomer(subscriptions,customer.ID)))) }</td><td data-label="Status">@statusPill(customer.Status)</td></tr>
		}
	</tbody></table></div>
}

templ planRows(plans []controlquota.Plan) {
	if len(plans) == 0 {
		<p class="np-empty">No service plans.</p>
	} else {
		<div class="np-object-list">
			for _, plan := range plans {
				<a class="np-object-row" href={ templ.SafeURL("/service-plans/" + formatPlanID(plan.ID)) }><span><strong>{ plan.Name }</strong><small>{ plan.Description }</small></span>@statusPill(planActiveStatus(plan.IsActive))</a>
			}
		</div>
	}
}

templ routedPlanDetail(data dashboard.Data, view WorkspaceView) {
	if plan, ok := planByID(data.Plans, view.DetailID); ok {
		@routedPlanEditor(plan, data, view, false)
	} else {
		<p class="np-empty">Plan not found.</p>
	}
}

templ routedAddonDetail(data dashboard.Data, view WorkspaceView) {
	if addon, ok := addonByID(data.AddonPlans, view.DetailID); ok {
		@routedPlanEditor(addonAsPlan(addon), data, view, true)
	} else {
		<p class="np-empty">Add-on plan not found.</p>
	}
}

templ routedPlanEditor(plan controlquota.Plan, data dashboard.Data, view WorkspaceView, addon bool) {
	@pageHead("Service plans", planEditorTitle(plan, addon), planEditorDescription(plan, addon)) {
		<div class="np-plan-head-actions"><a class="np-secondary-button" href={ templ.SafeURL(planListBackURL(addon)) }>Back to plans</a>
		if !addon && plan.ID > 0 {
			<a class="np-secondary-button" href={ templ.SafeURL("/service-plans/new?clone_from=" + formatPlanID(plan.ID)) }>@icon("layers") Clone</a>
		}
		</div>
	}
	if plan.ID > 0 {
		<section class="np-plan-summary"><div><span>Status</span>@statusPill(planActiveStatus(plan.IsActive))</div><div><span>Revision</span><strong>{ formatPlanID(int64(plan.Revision)) }</strong></div><div><span>Subscriptions</span><strong>{ formatPlanID(int64(planSubscriptionCount(plan.ID, data.Subscriptions))) }</strong></div><div><span>Synchronization</span><strong>{ planSyncLabel(plan.ID, data.Subscriptions) }</strong></div><div><span>Provider</span><strong>{ planProvider(plan, data.Resellers) }</strong></div></section>
	}
	<form class="np-plan-editor" method="post" action={ templ.SafeURL(planEditorAction(addon)) } data-np-plan-editor data-np-plan-id={ formatPlanID(plan.ID) } data-np-dirty-guard>
		@csrfInput(view)
		if plan.ID > 0 {
			if addon {
				<input type="hidden" name="addon_id" value={ formatPlanID(plan.ID) }/>
			} else {
				<input type="hidden" name="plan_id" value={ formatPlanID(plan.ID) }/>
			}
		}
		<section class="np-plan-general"><div class="np-plan-general-grid"><label>{ planEditorNameLabel(addon) }<input name="name" value={ plan.Name } required maxlength="120"/></label>
			if !addon {
				<label>Price, cents<input type="number" min="0" name="price_cents" value={ formatPlanPriceCents(plan.PriceCents) }/></label>
			}
			<label class="np-plan-description">Description<textarea name="description" rows="2">{ plan.Description }</textarea></label><label class="np-switch"><input type="hidden" name="is_active" value="false"/><input type="checkbox" name="is_active" value="true" checked?={ plan.IsActive }/><span>Available for new subscriptions</span></label></div></section>
		<nav class="np-plan-editor-tabs" aria-label="Plan properties">
			@planEditorTabLink(view,"resources","Resources") @planEditorTabLink(view,"permissions","Permissions") @planEditorTabLink(view,"hosting","Hosting") @planEditorTabLink(view,"php","PHP Settings") @planEditorTabLink(view,"mail","Mail") @planEditorTabLink(view,"dns","DNS") @planEditorTabLink(view,"performance","Performance") @planEditorTabLink(view,"logs","Logs & Statistics") @planEditorTabLink(view,"applications","Applications")
		</nav>
		<section class="np-plan-property-panel" data-np-plan-panel="resources" hidden?={ planEditorTab(view) != "resources" }><div class="np-property-head"><h2>Resources</h2><p>Set hard allocations, warning thresholds and overuse behavior.</p></div>
			if !addon {
				<fieldset class="np-field-group"><legend>Overuse policy</legend><div class="np-overuse-options">@overuseOption(plan,"block","Overuse is not allowed") @overuseOption(plan,"normal","Overuse is allowed") @overuseOption(plan,"notify","Allow and notify") @overuseOption(plan,"not_suspend","Disk and traffic only") @overuseOption(plan,"not_suspend_notify","Disk and traffic with notifications")</div></fieldset>
			}
				<div class="np-plan-field-grid">@planLimitField("Disk space","disk_mb",plan.DiskMB,"MB") @planLimitField("Monthly traffic","bandwidth_mb",plan.BandwidthMB,"MB") @planLimitField("Websites","max_sites",plan.MaxSites,"count") @planLimitField("Subdomains","max_subdomains",plan.MaxSubdomains,"count") @planLimitField("Domain aliases","max_domain_aliases",plan.MaxDomainAliases,"count") @planLimitField("Databases","max_databases",plan.MaxDatabases,"count") @planLimitField("Mailboxes","max_mailboxes",plan.MaxMailboxes,"count") @planLimitField("FTP accounts","max_ftp_accounts",plan.MaxFTPAccounts,"count") @planLimitField("Backups","max_backups",plan.MaxBackups,"count") @planLimitField("Backup storage","backup_storage_mb",plan.BackupStorageMB,"MB") @planLimitField("Backup retention","backup_retention_days",plan.BackupRetentionDays,"days")
				if !addon {
					@planLimitField("Subscription validity","validity_days",plan.ValidityDays,"days")
				}
				</div>
				if !addon {
					<div class="np-property-head"><h3>Enforced account resources</h3></div><div class="np-plan-field-grid">@planLimitField("CPU quota","cpu_percent",plan.HostingPolicy.Resources.CPUPercent,"percent") @planLimitField("Memory","memory_limit_mb",plan.HostingPolicy.Resources.MemoryMB,"MB") @planLimitField("I/O read","io_read_mbps",plan.HostingPolicy.Resources.IOReadMBPS,"MBps") @planLimitField("I/O write","io_write_mbps",plan.HostingPolicy.Resources.IOWriteMBPS,"MBps") @planLimitField("Processes","max_tasks",plan.HostingPolicy.Resources.MaxTasks,"count") @planLimitField("Database users","max_database_users",plan.HostingPolicy.Resources.MaxDatabaseUsers,"count") @planLimitField("Mail aliases","max_mail_aliases",plan.HostingPolicy.Resources.MaxMailAliases,"count") @planLimitField("Scheduled tasks","max_scheduled_tasks",plan.HostingPolicy.Resources.MaxScheduledTasks,"count") @planLimitField("Applications","max_applications",plan.HostingPolicy.Resources.MaxApplications,"count") @planLimitField("Container storage","container_storage_mb",plan.HostingPolicy.Resources.ContainerStorageMB,"MB") @planLimitField("Valkey memory","valkey_memory_mb",plan.HostingPolicy.Resources.ValkeyMemoryMB,"MB")</div>
				}
			if !addon {
				<div class="np-plan-field-grid np-threshold-grid"><label>Disk warning threshold<div class="np-input-suffix"><input type="number" name="disk_warning_percent" min="1" max="100" value={ formatPlanID(int64(plan.DiskWarningPercent)) } required/><span>%</span></div></label><label>Traffic warning threshold<div class="np-input-suffix"><input type="number" name="traffic_warning_percent" min="1" max="100" value={ formatPlanID(int64(plan.TrafficWarningPercent)) } required/><span>%</span></div></label></div>
			}
		</section>
			<section class="np-plan-property-panel" data-np-plan-panel="permissions" hidden?={ planEditorTab(view) != "permissions" }><div class="np-property-head"><h2>Permissions</h2><p>Choose which hosting tools the subscription may use.</p></div><div class="np-permission-list">@planToggle("allow_dns","DNS zone management",plan.AllowDNS) @planToggle("allow_tls","SSL/TLS certificate management",plan.AllowTLS) @planToggle("allow_backups","Backup and restore management",plan.AllowBackups) @planToggle("allow_php_settings","PHP version and settings management",plan.AllowPHPSettings) @planToggle("allow_ssh","SSH access",plan.AllowSSH) @planToggle("allow_sftp","SFTP identities",plan.HostingPolicy.Permissions.SFTP) @planToggle("allow_ftps","TLS-only FTPS",plan.HostingPolicy.Permissions.FTPS) @planToggle("allow_logs","Domain log browser",plan.HostingPolicy.Permissions.Logs) @planToggle("allow_git","Git deployment",plan.HostingPolicy.Permissions.Git) @planToggle("allow_staging","Staging copy and promote",plan.HostingPolicy.Permissions.Staging) @planToggle("allow_valkey","Valkey cache",plan.HostingPolicy.Permissions.Valkey) @planToggle("allow_scheduled_tasks","Scheduled tasks",plan.HostingPolicy.Permissions.ScheduledTasks) @planToggle("allow_mail","Mail hosting",plan.HostingPolicy.Permissions.Mail) @planToggle("allow_cgi","CGI execution",plan.HostingPolicy.Permissions.CGI) @planToggle("allow_applications","Applications",plan.HostingPolicy.Permissions.Applications) @planToggle("allow_custom_oci_images","Custom OCI images",plan.HostingPolicy.Permissions.CustomOCIImages) @planToggle("allow_application_egress","Application network egress",plan.HostingPolicy.Permissions.ApplicationEgress)</div><div class="np-plan-field-grid"><label>Shell mode<select name="shell_mode"><option value="disabled" selected?={ plan.HostingPolicy.Access.ShellMode == "disabled" }>Disabled</option><option value="sftp" selected?={ plan.HostingPolicy.Access.ShellMode == "sftp" }>SFTP only</option><option value="nspawn" selected?={ plan.HostingPolicy.Access.ShellMode == "nspawn" }>Isolated shell</option></select></label><label>nspawn image<input name="nspawn_image" value={ plan.HostingPolicy.Access.NspawnImage }/></label><label>SSH idle timeout<input type="number" min="0" name="ssh_idle_timeout_minutes" value={ formatPlanID(int64(plan.HostingPolicy.Access.SSHIdleTimeoutMins)) }/></label></div></section>
		<section class="np-plan-property-panel" data-np-plan-panel="hosting" hidden?={ planEditorTab(view) != "hosting" }><div class="np-property-head"><h2>Hosting parameters</h2><p>Configure the default web-hosting runtime.</p></div>
			if !addon && len(data.Capabilities.PHPVersions) == 0 {
				<p class="np-gate is-blocked">No PHP-FPM runtime was reported by the agent. Install PHP-FPM before enabling web hosting in this plan.</p>
			}
			<div class="np-plan-field-grid">
				if !addon {
					@planToggle("hosting_enabled","Web hosting enabled",plan.HostingEnabled)<label>Web server<select name="hosting_web_server"><option value="nginx" selected>Nginx</option></select></label><label>Preferred domain<select name="preferred_domain"><option value="none" selected?={ plan.Presets.Hosting.PreferredDomain == "none" }>No preference</option><option value="www" selected?={ plan.Presets.Hosting.PreferredDomain == "www" }>www</option><option value="non-www" selected?={ plan.Presets.Hosting.PreferredDomain == "non-www" }>non-www</option></select></label><label>Default PHP version<select name="default_php_version">@phpVersionOptions(plan,data.Capabilities)</select></label>
				}
				@planLimitField("Per-site disk quota","site_disk_quota_mb",plan.SiteDiskQuotaMB,"MB")
			</div></section>
			<section class="np-plan-property-panel" data-np-plan-panel="php" hidden?={ planEditorTab(view) != "php" }><div class="np-property-head"><h2>PHP Settings</h2><p>Set allowed runtimes, dedicated PHP-FPM defaults, and production deployment capabilities. Zero disables a limit; Unlimited removes its numeric ceiling.</p></div><fieldset class="np-field-group"><legend>Allowed PHP versions</legend><div class="np-checkbox-grid">@phpVersionChecks(plan,data.Capabilities)</div></fieldset><div class="np-plan-field-grid">@planLimitField("PHP-FPM max children","php_max_children",plan.PHPFPMMaxChildren,"count") @planLimitField("PHP memory","php_memory_mb",plan.PHPMemoryMB,"MB") @planLimitField("PHP worker processes","max_php_workers",plan.HostingPolicy.Resources.MaxPHPWorkers,"count") @planLimitField("PHP releases","max_php_releases",plan.HostingPolicy.Resources.MaxPHPReleases,"count")<label>FPM mode<select name="php_fpm_mode"><option value="ondemand" selected?={ plan.HostingPolicy.PHP.FPMMode=="ondemand" }>On demand</option><option value="dynamic" selected?={ plan.HostingPolicy.PHP.FPMMode=="dynamic" }>Dynamic</option></select></label><label>Max execution time<input type="number" min="0" name="php_max_execution_seconds" value={ formatPlanID(int64(plan.Presets.PHP.MaxExecutionSeconds)) }/></label><label>Max input time<input type="number" min="0" name="php_max_input_seconds" value={ formatPlanID(int64(plan.Presets.PHP.MaxInputSeconds)) }/></label><label>POST max size, MB<input type="number" min="0" name="php_post_max_mb" value={ formatPlanID(int64(plan.Presets.PHP.PostMaxMB)) }/></label><label>Upload max size, MB<input type="number" min="0" name="php_upload_max_mb" value={ formatPlanID(int64(plan.Presets.PHP.UploadMaxMB)) }/></label><label>FPM max requests<input type="number" min="0" name="php_fpm_max_requests" value={ formatPlanID(int64(plan.Presets.PHP.FPMMaxRequests)) }/></label><label>FPM idle timeout<input type="number" min="0" name="php_fpm_idle_timeout_seconds" value={ formatPlanID(int64(plan.HostingPolicy.PHP.FPMIdleTimeoutSecs)) }/></label><label>Request termination timeout<input type="number" min="0" name="php_request_terminate_seconds" value={ formatPlanID(int64(plan.HostingPolicy.PHP.RequestTerminateSecs)) }/></label><label>OPcache memory, MB<input type="number" min="0" name="php_opcache_memory_mb" value={ formatPlanID(int64(plan.HostingPolicy.PHP.OPcacheMemoryMB)) }/></label></div><div class="np-permission-list">@planToggle("allow_composer","Composer",plan.HostingPolicy.Permissions.Composer) @planToggle("allow_composer_code_execution","Composer code execution",plan.HostingPolicy.Permissions.ComposerCodeExecution) @planToggle("allow_managed_php_deployments","Managed PHP deployments",plan.HostingPolicy.Permissions.ManagedPHPDeployments) @planToggle("allow_php_workers","PHP workers",plan.HostingPolicy.Permissions.PHPWorkers) @planToggle("php_log_errors","Log PHP errors",plan.Presets.PHP.LogErrors) @planToggle("php_display_errors","Display PHP errors",plan.Presets.PHP.DisplayErrors) @planToggle("php_allow_url_fopen","Allow URL fopen",plan.Presets.PHP.AllowURLFOpen) @planToggle("php_opcache_enabled","OPcache",plan.HostingPolicy.PHP.OPcacheEnabled) @planToggle("php_exec_enabled","PHP process execution",plan.HostingPolicy.PHP.ExecEnabled)</div></section>
		@planPresetPanels(plan,view)
		<div class="np-plan-action-bar"><div><strong>{ planEditorSaveTitle(plan,addon) }</strong><span>{ planEditorSaveHint(plan,addon) }</span></div><div><a class="np-secondary-button" href={ templ.SafeURL(planListBackURL(addon)) }>Cancel</a><button type="submit" data-np-plan-submit>{ planEditorSubmitLabel(plan,addon) }</button></div></div>
	</form>
	if !addon && plan.ID > 0 {
		@planPreviewDialog(plan,view)
	}
}

templ planEditorTabLink(view WorkspaceView, tab string, label string) { <a href={ templ.SafeURL(planTabURL(view,tab)) } class={ planTabClass(view,tab) } data-np-plan-tab={ tab }>{ label }</a> }

templ planLimitField(label string, name string, value int, unit string) { <div class="np-limit-field"><span>{ label }</span><span class="np-limit-controls"><input type="number" min="0" name={ name } value={ planEditorLimitDisplayValue(value,unit) } aria-label={ label } required/>
	if unit == "MB" {
		<select name={ name + "_unit" } aria-label={ label + " unit" }><option value="MB" selected?={ planEditorLimitUnit(value) == "MB" }>MB</option><option value="GB" selected?={ planEditorLimitUnit(value) == "GB" }>GB</option><option value="TB" selected?={ planEditorLimitUnit(value) == "TB" }>TB</option></select>
	} else {
		<input type="hidden" name={ name + "_unit" } value={ unit }/>
	}
	<label class="np-unlimited"><input type="checkbox" name={ name + "_unlimited" } value="true" checked?={ value < 0 } data-np-unlimited/>Unlimited</label></span></div> }

templ planToggle(name string, label string, checked bool) { <label class="np-permission-row"><input type="hidden" name={ name } value="false"/><input type="checkbox" name={ name } value="true" checked?={ checked }/><span>{ label }</span></label> }

templ overuseOption(plan controlquota.Plan, value string, label string) { <label><input type="radio" name="overuse_policy" value={ value } checked?={ string(plan.OverusePolicy) == value }/><span>{ label }</span></label> }

templ phpVersionOptions(plan controlquota.Plan, capabilities types.RuntimeCapabilities) {
	for _, version := range planPHPVersions(plan,capabilities) {
		<option value={ version } selected?={ version == plan.DefaultPHPVersion }>{ version }</option>
	}
}
templ phpVersionChecks(plan controlquota.Plan, capabilities types.RuntimeCapabilities) {
	for _, version := range planPHPVersions(plan,capabilities) {
		<label class="np-check"><input type="checkbox" name="php_versions" value={ version } checked?={ containsCSV(plan.PHPAllowlist,version) }/>{ version }</label>
	}
}

templ planPresetPanels(plan controlquota.Plan, view WorkspaceView) {
	<section class="np-plan-property-panel" data-np-plan-panel="mail" hidden?={ planEditorTab(view) != "mail" }><div class="np-property-head"><h2>Mail</h2>@presetStatus()</div><div class="np-permission-list">@planToggle("mail_webmail_enabled","Webmail enabled",plan.Presets.Mail.WebmailEnabled) @planToggle("mail_spam_filter","Spam filtering",plan.Presets.Mail.SpamFilter) @planToggle("mail_dkim","DKIM signing",plan.Presets.Mail.DKIM) @planToggle("mail_autoresponders","Autoresponders",plan.HostingPolicy.Mail.Autoresponders) @planToggle("mail_catch_all","Catch-all mailbox",plan.HostingPolicy.Mail.CatchAll)</div><div class="np-plan-field-grid">@planLimitField("Mailbox quota","mailbox_quota_mb",plan.HostingPolicy.Mail.MailboxQuotaMB,"MB")<label>DMARC policy<select name="mail_dmarc_policy"><option value="none" selected?={ plan.Presets.Mail.DMARCPolicy == "none" }>None</option><option value="quarantine" selected?={ plan.Presets.Mail.DMARCPolicy == "quarantine" }>Quarantine</option><option value="reject" selected?={ plan.Presets.Mail.DMARCPolicy == "reject" }>Reject</option></select></label></div></section>
	<section class="np-plan-property-panel" data-np-plan-panel="dns" hidden?={ planEditorTab(view) != "dns" }><div class="np-property-head"><h2>DNS</h2>@presetStatus()</div><div class="np-plan-field-grid"><label>Zone mode<select name="dns_mode"><option value="authoritative" selected?={ plan.Presets.DNS.Mode == "primary" || plan.HostingPolicy.DNS.Mode == "authoritative" }>Authoritative</option><option value="external" selected?={ plan.Presets.DNS.Mode == "secondary" || plan.HostingPolicy.DNS.Mode == "external" }>External</option></select></label><label>Default TTL<input type="number" name="dns_default_ttl" min="60" value={ formatPlanID(int64(plan.Presets.DNS.DefaultTTL)) }/></label></div><div class="np-permission-list">@planToggle("dnssec","DNSSEC",plan.HostingPolicy.DNS.DNSSEC)</div></section>
	<section class="np-plan-property-panel" data-np-plan-panel="performance" hidden?={ planEditorTab(view) != "performance" }><div class="np-property-head"><h2>Performance</h2>@presetStatus()</div><div class="np-plan-field-grid"><label>Maximum connections<input type="number" min="0" name="performance_max_connections" value={ formatPlanID(int64(plan.Presets.Performance.MaxConnections)) }/></label><label>Request rate per second<input type="number" min="0" name="request_rate_per_second" value={ formatPlanID(int64(plan.HostingPolicy.Web.RequestRatePerSecond)) }/></label><label>Request burst<input type="number" min="0" name="request_burst" value={ formatPlanID(int64(plan.HostingPolicy.Web.RequestBurst)) }/></label><label>Index files<input name="web_index_files" value={ plan.HostingPolicy.Web.IndexFiles }/></label><label>Request body, MB<input type="number" min="0" name="web_request_body_mb" value={ formatPlanID(int64(plan.HostingPolicy.Web.RequestBodyLimitMB)) }/></label><label>Cache TTL, seconds<input type="number" min="0" name="web_cache_ttl_seconds" value={ formatPlanID(int64(plan.HostingPolicy.Web.CacheTTLSeconds)) }/></label><label>Connect timeout<input type="number" min="0" name="web_connect_timeout_seconds" value={ formatPlanID(int64(plan.HostingPolicy.Web.ConnectTimeoutSecs)) }/></label><label>Read timeout<input type="number" min="0" name="web_read_timeout_seconds" value={ formatPlanID(int64(plan.HostingPolicy.Web.ReadTimeoutSecs)) }/></label><label>Security headers<select name="web_security_headers"><option value="off" selected?={ plan.HostingPolicy.Web.SecurityHeaderPreset=="off" }>Off</option><option value="balanced" selected?={ plan.HostingPolicy.Web.SecurityHeaderPreset=="balanced" }>Balanced</option><option value="strict" selected?={ plan.HostingPolicy.Web.SecurityHeaderPreset=="strict" }>Strict</option></select></label><label>Valkey max clients<input type="number" min="1" name="valkey_max_clients" value={ formatPlanID(int64(plan.HostingPolicy.Valkey.MaxClients)) }/></label><label>Valkey idle timeout<input type="number" min="0" name="valkey_idle_timeout_seconds" value={ formatPlanID(int64(plan.HostingPolicy.Valkey.IdleTimeoutSeconds)) }/></label><label>Valkey CPU %<input type="number" min="1" name="valkey_cpu_percent" value={ formatPlanID(int64(plan.HostingPolicy.Valkey.CPUPercent)) }/></label><label>Valkey process limit<input type="number" min="8" name="valkey_process_limit" value={ formatPlanID(int64(plan.HostingPolicy.Valkey.ProcessLimit)) }/></label></div><div class="np-permission-list">@planToggle("web_compression","Compression",plan.HostingPolicy.Web.Compression) @planToggle("performance_static_cache","Static file caching",plan.Presets.Performance.StaticFileCache) @planToggle("fastcgi_microcache","FastCGI microcache",plan.HostingPolicy.Web.FastCGIMicrocache)</div></section>
	<section class="np-plan-property-panel" data-np-plan-panel="logs" hidden?={ planEditorTab(view) != "logs" }><div class="np-property-head"><h2>Logs & Statistics</h2>@presetStatus()</div><div class="np-plan-field-grid"><label>Log retention, days<input type="number" min="1" name="logs_retention_days" value={ formatPlanID(int64(plan.Presets.Logs.RetentionDays)) }/></label>@planToggle("logs_rotation_enabled","Rotate logs",plan.Presets.Logs.RotationEnabled) @planToggle("logs_statistics_enabled","Traffic statistics",plan.Presets.Logs.StatisticsEnabled)</div></section>
	<section class="np-plan-property-panel" data-np-plan-panel="applications" hidden?={ planEditorTab(view) != "applications" }><div class="np-property-head"><h2>Applications &amp; Containers</h2>@presetStatus()</div><div class="np-permission-list">@planToggle("applications_catalog_enabled","Provider container catalog",plan.Presets.Applications.CatalogEnabled)</div><fieldset class="np-field-group"><legend>Operational runtimes</legend><div class="np-checkbox-grid"><label class="np-check"><input type="checkbox" name="allowed_runtimes" value="oci" checked?={ stringInSlice(plan.HostingPolicy.Applications.AllowedRuntimes,"oci") }/>OCI containers</label></div><p class="np-form-help">Classic PHP hosting is operational. Managed PHP entitlement is configured in PHP Settings and uses the PHP Application workspace when healthy. WordPress Toolkit, Node.js, and Python are not implemented; OCI remains in Containers.</p></fieldset><div class="np-plan-field-grid"><label>Allowed registries<input name="allowed_registries" value={ joinStrings(plan.HostingPolicy.Applications.AllowedRegistries) } placeholder="docker.io,ghcr.io"/></label><label>Allowed provider recipe slugs<input name="allowed_catalog_slugs" value={ joinStrings(plan.Presets.Applications.Allowed) } placeholder="whoami,static-app"/></label></div></section>
}

templ presetStatus() { <span class="np-preset-badge">Stored preset</span> }

templ planPreviewDialog(plan controlquota.Plan, view WorkspaceView) { <dialog class="np-dialog np-plan-preview-dialog" id="plan-preview-dialog" data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">Update & Sync</span><h2>Review synchronization impact</h2><p>Synced subscriptions receive the new revision. Locked and custom subscriptions retain their current snapshots.</p></div><dl class="np-preview-facts"><div><dt>Synced subscriptions</dt><dd data-np-preview-synced>-</dd></div><div><dt>Locked subscriptions</dt><dd data-np-preview-locked>-</dd></div><div><dt>Custom subscriptions</dt><dd data-np-preview-custom>-</dd></div><div><dt>Server committed disk</dt><dd data-np-preview-disk>-</dd></div><div data-np-preview-reseller-row hidden><dt>Reseller allocation</dt><dd data-np-preview-reseller>-</dd></div></dl><p class="np-gate" data-np-preview-warning></p><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="button" data-np-plan-confirm-submit>Update & Sync</button></div></dialog> }

templ routedSiteDialog(subscriptions []types.SubscriptionSummary, capabilities types.RuntimeCapabilities, view WorkspaceView) {
	<dialog class="np-dialog" id="site-dialog" data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">Hosting services</span><h2>Add website</h2><p>Limits are derived from the selected subscription.</p></div><form class="np-form np-dialog-form" method="post" action="/sites" data-np-create-site-form>@csrfInput(view)@routedSubscriptionSelect(subscriptions,capabilities)<label>Domain<input name="domain" required/></label><input type="hidden" name="username" value="npsystem"/><label>PHP<select name="php_version" data-np-site-php>
		for _, version := range subscriptionPHPVersions(subscriptions,capabilities) {
			<option value={ version }>{ version }</option>
		}
	</select></label><p class="np-gate" data-np-customer-gate></p><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit" data-np-create-submit>Create website</button></div></form></dialog>
}

templ routedSubscriptionSelect(subscriptions []types.SubscriptionSummary, capabilities types.RuntimeCapabilities) {
	<label>Subscription <select name="subscription_id" required>
		for _, subscription := range subscriptions {
			<option value={ formatQuotaUserID(subscription.ID) } data-subscription-id={ formatQuotaUserID(subscription.ID) } data-customer-id={ formatQuotaUserID(subscription.CustomerID) } data-email={ subscription.CustomerEmail } data-plan-name={ subscription.PlanName } data-has-quota="true" data-max-sites={ formatPlanLimitFormValue(subscription.MaxSites) } data-sites-used={ formatPlanLimitFormValue(subscription.SitesUsed) } data-storage-mb={ formatPlanLimitFormValue(subscription.DiskMB) } data-php-versions={ joinStrings(phpVersionsFromCapabilities(capabilities,subscription.PHPAllowlist)) }>{ subscriptionSelectLabel(subscription) }</option>
		}
	</select></label>
}

templ customerDialog(view WorkspaceView) {
	<dialog class="np-dialog" id="customer-dialog" data-np-dialog><form method="dialog" class="np-dialog-close"><button aria-label="Close dialog">@icon("x")</button></form><div class="np-dialog-head"><span class="np-kicker">Account management</span><h2>Add customer</h2><p>Create a contact-only customer or enable panel access now.</p></div><form class="np-form np-dialog-form" method="post" action="/customers">@csrfInput(view)<label>Email<input type="email" name="customer_email" required/></label><label>Name<input name="customer_name"/></label><label>Company<input name="company"/></label><label>Notes<input name="notes"/></label><label class="np-check"><input type="checkbox" name="enable_login" value="true"/>Enable panel login</label><label>Password<input type="password" name="password" autocomplete="new-password"/></label><div class="np-dialog-actions"><button type="button" class="np-secondary-button" data-np-dialog-close>Cancel</button><button type="submit">Create customer</button></div></form></dialog>
}
