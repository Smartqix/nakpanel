package web

templ phpRuntimeLimit(label string, name string, value int, ceiling int) {
	<label>{ label }
		if ceiling > 0 {
			<input type="number" name={ name } min="1" max={ formatPlanLimitFormValue(ceiling) } required value={ formatPlanLimitFormValue(value) }/>
			<small>Provider maximum: { formatPlanLimit(ceiling) }. Unlimited is not permitted.</small>
		} else {
			<input type="number" name={ name } min="-1" required value={ formatPlanLimitFormValue(value) }/>
		}
	</label>
}
